// AOSP's default Bluetooth HAL (HCI user channel on the kernel's hci0) for the real PC; no
// VINTF fragment: the instance is declared by Cuttlefish's com.google.cf.bt APEX, whose
// bt_hci service aosp-device/pc/init.pc.rc replaces with this one.
// This lives under vendor/ (tools/aosp-device-link.sh mirrors aosp-device-vendor/ to
// vendor/android-pc/) because libbluetooth_offload_hal is only visible to vendor/,
// hardware/interfaces/bluetooth and Cuttlefish's own HAL.

package {
    default_visibility: ["//visibility:private"],
}

cc_binary {
    name: "android.hardware.bluetooth-service.pc",
    relative_install_path: "hw",
    init_rc: ["android.hardware.bluetooth-service.pc.rc"],
    vendor: true,
    defaults: ["android.hardware.bluetooth-service-build-defaults"],
    srcs: ["service.cpp"],
    // BluetoothHci.h: libbluetoothhcihalimpl does not export its header.
    include_dirs: ["hardware/interfaces/bluetooth/aidl/default"],
    static_libs: ["libbluetoothhcihalimpl"],
    visibility: ["//visibility:public"],
}
