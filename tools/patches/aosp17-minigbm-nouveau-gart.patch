+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+/*
+ * nouveau: like the dumb driver, but buffers live in GART (system memory, cached on x86)
+ * instead of VRAM. A dumb buffer is a VRAM object that the CPU reaches through the
+ * write-combined BAR1 mapping, and reading it back is very slow; with a software renderer
+ * (SwiftShader) every app buffer and every composition reads buffers back, which left the
+ * desktop at a few frames per second on an RTX 4070. Buffers that the display scans out
+ * are moved to VRAM by the kernel when the plane pins them (nv50_wndw_prepare_fb), so
+ * scanout still works. NVK imports either kind through dma-buf.
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <xf86drm.h>
+
+/* nouveau_drm.h uses uint32_t without including stdint.h. */
+#include <nouveau_drm.h>
+
+#include "drv_helpers.h"
+#include "drv_priv.h"
+#include "util.h"
+
+static const uint32_t scanout_render_formats[] = { DRM_FORMAT_ARGB8888, DRM_FORMAT_XRGB8888,
+						   DRM_FORMAT_ABGR8888, DRM_FORMAT_XBGR8888,
+						   DRM_FORMAT_BGR888,	DRM_FORMAT_RGB565 };
+
+static const uint32_t texture_only_formats[] = { DRM_FORMAT_R8, DRM_FORMAT_NV12, DRM_FORMAT_NV21,
+						 DRM_FORMAT_YVU420, DRM_FORMAT_YVU420_ANDROID };
+
+static int nouveau_init(struct driver *drv)
+{
+	drv_add_combinations(drv, scanout_render_formats, ARRAY_SIZE(scanout_render_formats),
+			     &LINEAR_METADATA, BO_USE_RENDER_MASK | BO_USE_SCANOUT);
+
+	drv_add_combinations(drv, texture_only_formats, ARRAY_SIZE(texture_only_formats),
+			     &LINEAR_METADATA, BO_USE_TEXTURE_MASK);
+
+	drv_modify_combination(drv, DRM_FORMAT_R8, &LINEAR_METADATA,
+			       BO_USE_HW_VIDEO_ENCODER | BO_USE_HW_VIDEO_DECODER |
+				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE |
+				   BO_USE_GPU_DATA_BUFFER | BO_USE_SENSOR_DIRECT_DATA);
+	drv_modify_combination(drv, DRM_FORMAT_NV12, &LINEAR_METADATA,
+			       BO_USE_HW_VIDEO_ENCODER | BO_USE_HW_VIDEO_DECODER |
+				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE);
+	drv_modify_combination(drv, DRM_FORMAT_NV21, &LINEAR_METADATA, BO_USE_HW_VIDEO_ENCODER);
+
+	return drv_modify_linear_combinations(drv);
+}
+
+static int nouveau_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+			     uint64_t use_flags)
+{
+	struct drm_nouveau_gem_new req = { 0 };
+	uint32_t aligned_width = width, aligned_height = height, pitch;
+	int ret;
+
+	/* The same sizes as drv_dumb_bo_create(), with nouveau's 256-byte dumb pitch. */
+	switch (format) {
+	case DRM_FORMAT_R16:
+		aligned_width = ALIGN(width, 16);
+		break;
+	case DRM_FORMAT_YVU420_ANDROID:
+		height = bo->meta.height;
+		aligned_width = ALIGN(width, 32);
+		aligned_height = 3 * DIV_ROUND_UP(height, 2);
+		break;
+	case DRM_FORMAT_YVU420:
+	case DRM_FORMAT_NV12:
+	case DRM_FORMAT_NV21:
+	case DRM_FORMAT_P010:
+		aligned_height = 3 * DIV_ROUND_UP(height, 2);
+		break;
+	default:
+		break;
+	}
+	aligned_width = ALIGN(aligned_width, MESA_LLVMPIPE_TILE_SIZE);
+	aligned_height = ALIGN(aligned_height, MESA_LLVMPIPE_TILE_SIZE);
+	pitch = ALIGN(aligned_width * drv_bytes_per_pixel_from_format(format, 0), 256);
+
+	req.info.domain = NOUVEAU_GEM_DOMAIN_GART;
+	req.info.size = (uint64_t)pitch * aligned_height;
+	ret = drmCommandWriteRead(bo->drv->fd, DRM_NOUVEAU_GEM_NEW, &req, sizeof(req));
+	if (ret) {
+		drv_loge("DRM_NOUVEAU_GEM_NEW failed (%d), using a dumb buffer\n", ret);
+		return drv_dumb_bo_create(bo, width, height, format, use_flags);
+	}
+
+	drv_bo_from_format(bo, pitch, 1, height, format);
+	bo->handle.u32 = req.info.handle;
+	bo->meta.total_size = req.info.size;
+	return 0;
+}
+
+static int nouveau_bo_create_with_modifiers(struct bo *bo, uint32_t width, uint32_t height,
+					    uint32_t format, const uint64_t *modifiers,
+					    uint32_t count)
+{
+	for (uint32_t i = 0; i < count; i++) {
+		if (modifiers[i] == DRM_FORMAT_MOD_LINEAR)
+			return nouveau_bo_create(bo, width, height, format, 0);
+	}
+
+	return -EINVAL;
+}
+
+/* MODE_MAP_DUMB and MODE_DESTROY_DUMB work on any nouveau GEM object. */
+const struct backend backend_nouveau = {
+	.name = "nouveau",
+	.init = nouveau_init,
+	.bo_create = nouveau_bo_create,
+	.bo_create_with_modifiers = nouveau_bo_create_with_modifiers,
+	.bo_destroy = drv_dumb_bo_destroy,
+	.bo_import = drv_prime_bo_import,
+	.bo_export = drv_prime_bo_export,
+	.bo_map = drv_dumb_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
+};
