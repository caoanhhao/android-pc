index 0000000..48a4af8
--- /dev/null
+++ b/third_party/astc-encoder/src/Source/astcenc_compute_variance.cpp
@@ -0,0 +1,472 @@
+// SPDX-License-Identifier: Apache-2.0
+// ----------------------------------------------------------------------------
