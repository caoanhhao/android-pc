diff --git a/src/libANGLE/renderer/vulkan/vk_helpers.cpp b/src/libANGLE/renderer/vulkan/vk_helpers.cpp
index 2d012de..deda0e4 100644
--- a/src/libANGLE/renderer/vulkan/vk_helpers.cpp
+++ b/src/libANGLE/renderer/vulkan/vk_helpers.cpp
@@ -8068,6 +8068,22 @@ angle::Result ImageHelper::CopyImageSubData(const gl::Context *context,
     }
     else if (!srcImage->getIntendedFormat().isBlock && !dstImage->getIntendedFormat().isBlock)
     {
+        // android-pc: copyImageBits() handles only RGB emulated as RGBA with 1, 2 or 4 byte
+        // channels; a packed format (RGB565, RGBA4444, ...) has pixelBytes < channelCount and
+        // would divide by zero there.
+        const angle::Format &srcActual = srcImage->getActualFormat();
+        const angle::Format &dstActual = dstImage->getActualFormat();
+        if (srcActual.pixelBytes < srcActual.channelCount ||
+            dstActual.pixelBytes < dstActual.channelCount)
+        {
+            WARN() << "glCopyImageSubData between emulated formats not supported: "
+                   << srcImage->getIntendedFormat().glInternalFormat << " ("
+                   << static_cast<int>(srcImage->getActualFormatID()) << ") -> "
+                   << dstImage->getIntendedFormat().glInternalFormat << " ("
+                   << static_cast<int>(dstImage->getActualFormatID()) << ")";
+            ANGLE_VK_CHECK(contextVk, false, VK_ERROR_FEATURE_NOT_PRESENT);
+        }
+
         // The source and destination image formats may be using a fallback in the case of RGB
         // images.  A compute shader is used in such a case to perform the copy.
         UtilsVk &utilsVk = contextVk->getUtils();
