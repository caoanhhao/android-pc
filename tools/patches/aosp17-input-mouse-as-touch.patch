+// android-pc: mouse clicks as touches for apps that only handle touch (many games ignore
+// events whose source is SOURCE_MOUSE). The built-in list below plus the comma-separated
+// tokens of persist.sys.pc.mouse_as_touch: "pkg" or "prefix*" adds apps, "*" adds every app
+// but System UI and the launcher, "-pkg", "-prefix*" or "-*" removes them (removals win).
+constexpr const char* kMouseAsTouchProperty = "persist.sys.pc.mouse_as_touch";
+constexpr const char* kMouseAsTouchDefaults =
+        "com.garena.game.df,com.garena.game.kgvn,com.garena.game.codm,com.dts.freefireth,"
+        "com.dts.freefiremax,com.tencent.ig,com.vng.pubgmobile,com.netease.yyvn";
+
+bool matchesMouseAsTouchToken(const std::string& token, const std::string& packageName) {
+    if (token.ends_with('*')) {
+        return packageName.starts_with(std::string_view(token).substr(0, token.size() - 1));
+    }
+    return token == packageName;
+}
+
+bool isMouseAsTouchApp(const WindowInfo& info) {
+    static std::mutex lock;
+#if defined(__BIONIC__)
+    static android::base::CachedProperty property(kMouseAsTouchProperty);
+#endif
+    static std::vector<std::string> include;
+    static std::vector<std::string> exclude;
+    const std::string& name = info.packageName;
+    if (name.empty() || info.ownerUid.val() % AID_USER_OFFSET < AID_APP_START || name == "com.android.systemui" ||
+        name == "com.android.launcher3") {
+        return false;
+    }
+    std::scoped_lock _l(lock);
+    bool changed = false;
+#if defined(__BIONIC__)
+    const char* value = property.Get(&changed);
+#else
+    const char* value = nullptr; // host builds (tests) have no system properties
+#endif
+    if (changed || include.empty()) {
+        include.clear();
+        exclude.clear();
+        std::string tokens = std::string(kMouseAsTouchDefaults) + "," + (value ? value : "");
+        for (std::string token : android::base::Split(tokens, ",")) {
+            token = android::base::Trim(token);
+            if (token.empty()) continue;
+            if (token[0] == '-') {
+                exclude.push_back(token.substr(1));
+            } else {
+                include.push_back(token);
+            }
+        }
+    }
+    auto matches = [&](const std::string& token) { return matchesMouseAsTouchToken(token, name); };
+    return std::any_of(include.begin(), include.end(), matches) &&
+            std::none_of(exclude.begin(), exclude.end(), matches);
+}
+
+// A single-pointer mouse event that isMouseAsTouchApp() windows get as a touch.
+bool isConvertibleMouseEvent(const MotionEntry& entry) {
+    return isFromSource(entry.source, AINPUT_SOURCE_MOUSE) &&
+            entry.getPointerCount() == 1 &&
+            entry.pointerProperties[0].toolType == ToolType::MOUSE;
+}
