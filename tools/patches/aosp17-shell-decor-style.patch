+package com.android.wm.shell.windowdecor
+
+import android.app.ActivityManager.RunningTaskInfo
+import android.view.SurfaceControl
+
+/**
+ * Extension point for a SystemUI variant that styles desktop window decorations itself
+ * (android-pc's PcSystemUI). With no [instance] set, Shell behaves as before.
+ *
+ * Called on Shell's main thread.
+ */
+interface WindowDecorStyle {
+    /** Whether the freeform [taskInfo] gets no caption (no app header). */
+    fun hidesCaption(taskInfo: RunningTaskInfo): Boolean = false
+
+    /**
+     * Whether the fullscreen [taskInfo] gets no app handle. The variant's own bar and gestures
+     * replace it; a handle with no status bar to sit in is invisible but its spy window still
+     * takes every touch on the task and steals each press as a handle drag.
+     */
+    fun hidesAppHandle(taskInfo: RunningTaskInfo): Boolean = false
+
+    /**
+     * Called at the end of every surface update of a decoration, after Shell set the task
+     * surface's outline (corner radius, border, shadows), with the same transactions: whatever
+     * is set on [taskSurface] here wins over Shell's values. [inSyncWithTransition] is true when
+     * the relayout comes from a transition, where [startT] is applied when it starts animating
+     * and [finishT] when it finishes; otherwise both are the same transaction, applied at once.
+     */
+    fun onRelayout(
+        taskInfo: RunningTaskInfo,
+        taskSurface: SurfaceControl,
+        hasGlobalFocus: Boolean,
+        inSyncWithTransition: Boolean,
+        startT: SurfaceControl.Transaction,
+        finishT: SurfaceControl.Transaction,
+    ) {}
+
+    /** The decoration of [taskId] is gone (task vanished or no longer decorated). */
+    fun onClosed(taskId: Int) {}
+
+    companion object {
+        /** The variant's style, set once when its Shell initializes. */
+        @JvmStatic @Volatile var instance: WindowDecorStyle? = null
+    }
+}
