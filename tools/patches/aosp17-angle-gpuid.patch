+#if defined(ANGLE_PLATFORM_ANDROID)
+// android-pc (Phase K3, gpuid): another GL_VENDOR / GL_RENDERER for the apps listed in
+// /vendor/etc/gpuid.conf, one "<process name>|<GL_VENDOR>|<GL_RENDERER>" per line. Some games
+// choose their graphics API from a whitelist of GPU names (Genshin Impact turns Vulkan on only
+// for Adreno, Mali and Xclipse). Only the strings change; rendering stays on the real GPU. The
+// file is empty except on the NVIDIA (Venus) boot entry, where init.venus.rc mounts the list.
+static bool GetGpuidOverride(std::string *vendor, std::string *renderer)
+{
+    std::ifstream cmdline("/proc/self/cmdline");
+    std::string self;
+    if (!std::getline(cmdline, self, '\0') || self.empty())
+    {
+        return false;
+    }
+    std::ifstream conf("/vendor/etc/gpuid.conf");
+    std::string line;
+    while (std::getline(conf, line))
+    {
+        const size_t v = line.find('|');
+        const size_t r = v == std::string::npos ? v : line.find('|', v + 1);
+        if (line.empty() || line[0] == '#' || r == std::string::npos ||
+            line.compare(0, v, self) != 0 || v != self.size())
+        {
+            continue;
+        }
+        *vendor   = line.substr(v + 1, r - v - 1);
+        *renderer = line.substr(r + 1);
+        renderer->erase(renderer->find_last_not_of("\r\n") + 1);
+        return true;
+    }
+    return false;
+}
+#endif
