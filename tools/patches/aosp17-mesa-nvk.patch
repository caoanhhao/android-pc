index 00000000..95abc64b
--- /dev/null
+++ b/src/nouveau/nil/android/nil.h
@@ -0,0 +1,434 @@
+/*
+ * Copyright © 2026 android-pc
+ * SPDX-License-Identifier: MIT
+ *
+ * Hand-written stand-in for the nil.h that meson generates with cbindgen
+ * (nil/cbindgen.toml), for the Soong build, which has no cbindgen.  It must
+ * match the #[repr(C)] types and #[no_mangle] functions in nil/ (the .rs files); the
+ * layout is checked at build time by nil/android/nil_layout_check.c against
+ * the sizes asserted in nil/android/layout_check.rs.
+ *
+ * Like cbindgen's output, #[repr(u8)] enums are declared as an enum (for
+ * the constants) plus a uint8_t typedef of the same name, which is what the
+ * structs and functions use.
+ */
+
+#ifndef NIL_H
+#define NIL_H
+
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "nouveau/headers/nv_device_info.h"
+#include "util/format/u_format.h"
+#include "drm-uapi/drm_fourcc.h"
+
+#define NIL_MAX_DRM_FORMAT_MODS 7
+
+#define NIL_MAX_LEVELS 16
+
+#define NIL_IMAGE_USAGE_2D_VIEW_BIT (1 << 0)
+
+#define NIL_IMAGE_USAGE_LINEAR_BIT (1 << 1)
+
+#define NIL_IMAGE_USAGE_SPARSE_RESIDENCY_BIT (1 << 2)
+
+#define NIL_IMAGE_USAGE_VIDEO_BIT (1 << 3)
+
+#define NIL_IMAGE_USAGE_UNCOMPRESSED_BIT (1 << 4)
+
+enum nil_gob_type {
+   NIL_GOB_TYPE_LINEAR,
+   NIL_GOB_TYPE_FERMI_Z_S,
+   NIL_GOB_TYPE_FERMI_COLOR,
+   NIL_GOB_TYPE_TEGRA_COLOR,
+   NIL_GOB_TYPE_TURING_COLOR2_D,
+   NIL_GOB_TYPE_BLACKWELL8_BIT,
+   NIL_GOB_TYPE_BLACKWELL16_BIT,
+   NIL_GOB_TYPE_BLACKWELL_Z24,
+};
+typedef uint8_t nil_gob_type;
+
+enum nil_image_dim {
+   NIL_IMAGE_DIM_1D = 1,
+   NIL_IMAGE_DIM_2D = 2,
+   NIL_IMAGE_DIM_3D = 3,
+};
+typedef uint8_t nil_image_dim;
+
+enum nil_sample_layout {
+   NIL_SAMPLE_LAYOUT_1X1,
+   NIL_SAMPLE_LAYOUT_2X1,
+   NIL_SAMPLE_LAYOUT_2X1_D3D,
+   NIL_SAMPLE_LAYOUT_2X2,
+   NIL_SAMPLE_LAYOUT_4X2,
+   NIL_SAMPLE_LAYOUT_4X2_D3D,
+   NIL_SAMPLE_LAYOUT_4X4,
+   NIL_SAMPLE_LAYOUT_INVALID,
+};
+typedef uint8_t nil_sample_layout;
+
+enum nil_view_access {
+   NIL_VIEW_ACCESS_TEXTURE,
+   NIL_VIEW_ACCESS_STORAGE,
+};
+typedef uint8_t nil_view_access;
+
+enum nil_view_type {
+   NIL_VIEW_TYPE_1D,
+   NIL_VIEW_TYPE_2D,
+   NIL_VIEW_TYPE_3D,
+   NIL_VIEW_TYPE_3D_SLICED,
+   NIL_VIEW_TYPE_CUBE,
+   NIL_VIEW_TYPE_1D_ARRAY,
+   NIL_VIEW_TYPE_2D_ARRAY,
+   NIL_VIEW_TYPE_CUBE_ARRAY,
+};
+typedef uint8_t nil_view_type;
+
+typedef uint8_t nil_image_usage_flags;
+
+struct nil_Extent4D_Bytes {
+   uint32_t width;
+   uint32_t height;
+   uint32_t depth;
+   uint32_t array_len;
+};
+
+struct nil_Offset4D_Bytes {
+   uint32_t x;
+   uint32_t y;
+   uint32_t z;
+   uint32_t a;
+};
+
+struct nil_tiling {
+   nil_gob_type gob_type;
+   uint8_t x_log2;
+   uint8_t y_log2;
+   uint8_t z_log2;
+};
+
+struct nil_descriptor {
+   uint32_t bits[8];
+};
