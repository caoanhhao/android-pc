+}
+
+cc_library_static {
+    name: "mesa_compiler_rs_c_helpers",
+    vendor: true,
+    c_std: "c11",
+    defaults: [
+        "aosp_mesa3d_c_project_args",
+        "no_override_init_args",
+    ],
+    header_libs: [
+        "inc_include",
+        "inc_util",
+        "inc_src",
+    ],
+    srcs: ["rust_helpers.c"],
+}
+
+rust_bindgen {
+    name: "libmesa_compiler_bindings",
+    defaults: ["mesa_bindgen_defaults"],
+    crate_name: "mesa_compiler_bindings",
+    wrapper_src: "bindings.h",
+    source_stem: "bindings",
+    header_libs: ["mesa_compiler_rs_headers"],
+    bindgen_flags: [
+        "--allowlist-var", "NIR_.*",
+        "--allowlist-var", "nir_.*_infos",
+        "--allowlist-var", "rust_.*",
+        "--allowlist-function", "glsl_.*",
+        "--allowlist-function", "_mesa_shader_stage_to_string",
+        "--allowlist-function", "nir_.*",
+        "--allowlist-function", "compiler_rs.*",
+        "--allowlist-function", "u_memstream.*",
+        "--allowlist-type", "u_memstream",
+        "--no-prepend-enum-name",
+        "--with-derive-default",
+        "--allowlist-type", "exec_list",
+        "--allowlist-type", "exec_node",
+        "--allowlist-type", "float_controls",
+        "--allowlist-type", "gc_ctx",
+        "--allowlist-type", "gl_access_qualifier",
+        "--allowlist-type", "gl_frag_result",
+        "--allowlist-type", "gl_interp_mode",
+        "--allowlist-type", "mesa_shader_stage",
+        "--allowlist-type", "gl_subgroup_size",
+        "--allowlist-type", "gl_system_value",
+        "--allowlist-type", "gl_tess_spacing",
+        "--allowlist-type", "gl_varying_slot",
+        "--allowlist-type", "gl_vert_attrib",
+        "--allowlist-type", "glsl_type",
+        "--allowlist-type", "glsl_matrix_layout",
+        "--allowlist-type", "nir_.*",
+        "--allowlist-type", "mesa_scope",
+        "--allowlist-type", "mesa_prim",
+        "--allowlist-type", "shader_info",
+        "--allowlist-type", "tess_primitive_mode",
+        "--allowlist-type", "u_printf_info",
+    ],
+}
+
+// lib.rs include!s the bindgen output from OUT_DIR (cfg mesa_soong).
+rust_library {
+    name: "libmesa_compiler",
+    defaults: ["mesa_rust_defaults"],
+    crate_name: "compiler",
+    stem: "libcompiler",
+    srcs: [
+        "lib.rs",
+        ":libmesa_compiler_bindings",
+    ],
+}
+
+rust_library_host_rlib {
+    name: "libmesa_compiler_proc",
+    crate_name: "compiler_proc",
+    stem: "libcompiler_proc",
+    // syn/quote/proc-macro2 are built for the first host arch only.
+    compile_multilib: "first",
+    edition: "2021",
+    lints: "none",
+    clippy_lints: "none",
+    srcs: ["proc/lib.rs"],
+    rustlibs: [
+        "libproc_macro2",
+        "libquote",
+        "libsyn",
+    ],
+}
diff --git a/src/compiler/rust/lib.rs b/src/compiler/rust/lib.rs
index 68b0087f..9ddfaa1d 100644
--- a/src/compiler/rust/lib.rs
+++ b/src/compiler/rust/lib.rs
@@ -2,7 +2,23 @@
 // SPDX-License-Identifier: MIT
 
 pub mod as_slice;
+#[cfg(not(mesa_soong))]
 pub mod bindings;
+// Soong puts the rust_bindgen output in OUT_DIR, not next to lib.rs.  It is
+// generated without the #![allow] raw lines (inner attributes cannot be
+// include!d), so they are repeated here.
+#[cfg(mesa_soong)]
+#[allow(clippy::all)]
+#[allow(improper_ctypes)]
+#[allow(unused_unsafe)]
+#[allow(non_camel_case_types)]
+#[allow(non_snake_case)]
+#[allow(non_upper_case_globals)]
+#[allow(unsafe_op_in_unsafe_fn)]
+#[allow(unnecessary_transmutes)]
+pub mod bindings {
+    include!(concat!(env!("OUT_DIR"), "/bindings.rs"));
+}
 pub mod bitset;
 pub mod cfg;
 pub mod dataflow;
