+    tools: ["vtn_bindgen2"],
+    srcs: ["vulkan/cl/android/nvkcl.spv"],
+    cmd: "$(location vtn_bindgen2) $(in) $(location nvkcl.cpp) $(genDir)/nvkcl.h",
+    out: ["nvkcl.cpp"],
+}
+
+genrule {
+    name: "nvkcl_h",
+    tools: ["vtn_bindgen2"],
+    srcs: ["vulkan/cl/android/nvkcl.spv"],
+    cmd: "$(location vtn_bindgen2) $(in) $(genDir)/nvkcl.cpp $(location nvkcl.h)",
