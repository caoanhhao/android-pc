+}
+
+rust_ffi_static {
+    name: "libnak_rs",
+    defaults: ["mesa_rust_defaults"],
+    crate_name: "nak_rs",
+    srcs: ["compiler/nak/lib.rs"],
+    rustlibs: [
+        "libbitview",
+        "libmesa_compiler",
+        "libnak_bindings",
+        "libnak_latencies",
+        "libnvidia_headers",
+        "librustc_hash",
+    ],
+    proc_macros: [
+        "libnak_ir_proc",
+        "libpaste",
+    ],
+}
+
+genrule {
+    name: "nak_nir_algebraic.c",
+    tools: ["nak_nir_algebraic_py_binary"],
+    cmd: "$(location nak_nir_algebraic_py_binary) -p . --out $(out)",
+    out: ["nak_nir_algebraic.c"],
+}
+
+cc_library_static {
