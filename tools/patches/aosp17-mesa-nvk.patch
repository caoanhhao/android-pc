+// Copyright © 2026 android-pc
+// SPDX-License-Identifier: MIT
+
+// Layout of the C ABI types, checked against the hand-written nil.h of the
+// Soong build (android/nil.h, android/nil_layout_check.c asserts the same
+// numbers).  Only compiled with --cfg mesa_soong.
+
+use std::mem::{offset_of, size_of};
+
+use crate::descriptor::Descriptor;
+use crate::extent::{units, Extent4D, Offset4D};
+use crate::format::Format;
+use crate::image::{Image, ImageInitInfo, ImageLevel, SampleOffset, View};
+use crate::su_info::SuInfo;
+use crate::tiling::Tiling;
+use crate::zcull::ZCull;
+
+const _: () = assert!(size_of::<Extent4D<units::Pixels>>() == 16);
+const _: () = assert!(offset_of!(Extent4D<units::Pixels>, array_len) == 12);
+const _: () = assert!(size_of::<Offset4D<units::Bytes>>() == 16);
+const _: () = assert!(offset_of!(Offset4D<units::Bytes>, a) == 12);
+const _: () = assert!(size_of::<Tiling>() == 4);
+const _: () = assert!(offset_of!(Tiling, z_log2) == 3);
+const _: () = assert!(size_of::<Descriptor>() == 32);
+const _: () = assert!(size_of::<Format>() == 4);
+const _: () = assert!(size_of::<ImageLevel>() == 16);
+const _: () = assert!(offset_of!(ImageLevel, tiling) == 8);
+const _: () = assert!(offset_of!(ImageLevel, row_stride_B) == 12);
+const _: () = assert!(size_of::<Image>() == 328);
+const _: () = assert!(offset_of!(Image, format) == 4);
+const _: () = assert!(offset_of!(Image, extent_px) == 8);
+const _: () = assert!(offset_of!(Image, sample_layout) == 24);
+const _: () = assert!(offset_of!(Image, num_levels) == 28);
+const _: () = assert!(offset_of!(Image, mip_tail_first_lod) == 32);
+const _: () = assert!(offset_of!(Image, levels) == 40);
+const _: () = assert!(offset_of!(Image, array_stride_B) == 296);
+const _: () = assert!(offset_of!(Image, align_B) == 304);
+const _: () = assert!(offset_of!(Image, size_B) == 312);
+const _: () = assert!(offset_of!(Image, tile_mode) == 320);
+const _: () = assert!(offset_of!(Image, pte_kind) == 322);
+const _: () = assert!(offset_of!(Image, compressed_pte_kind) == 323);
+const _: () = assert!(size_of::<View>() == 44);
+const _: () = assert!(offset_of!(View, access) == 1);
+const _: () = assert!(offset_of!(View, format) == 4);
+const _: () = assert!(offset_of!(View, base_level) == 8);
+const _: () = assert!(offset_of!(View, num_levels) == 12);
+const _: () = assert!(offset_of!(View, base_array_layer) == 16);
+const _: () = assert!(offset_of!(View, array_len) == 20);
+const _: () = assert!(offset_of!(View, swizzle) == 24);
+const _: () = assert!(offset_of!(View, min_lod_clamp) == 40);
+const _: () = assert!(size_of::<SampleOffset>() == 2);
+const _: () = assert!(offset_of!(SampleOffset, y) == 1);
+const _: () = assert!(size_of::<ImageInitInfo>() == 56);
+const _: () = assert!(offset_of!(ImageInitInfo, format) == 4);
+const _: () = assert!(offset_of!(ImageInitInfo, extent_px) == 8);
+const _: () = assert!(offset_of!(ImageInitInfo, levels) == 24);
+const _: () = assert!(offset_of!(ImageInitInfo, samples) == 28);
+const _: () = assert!(offset_of!(ImageInitInfo, usage) == 32);
+const _: () = assert!(offset_of!(ImageInitInfo, modifier) == 40);
+const _: () = assert!(offset_of!(ImageInitInfo, explicit_row_stride_B) == 48);
+const _: () = assert!(offset_of!(ImageInitInfo, max_alignment_B) == 52);
+const _: () = assert!(size_of::<SuInfo>() == 32);
+const _: () = assert!(offset_of!(SuInfo, extra) == 28);
+const _: () = assert!(size_of::<ZCull>() == 108);
+const _: () = assert!(offset_of!(ZCull, region_format) == 24);
+const _: () = assert!(offset_of!(ZCull, normalized_aliquots) == 28);
+const _: () = assert!(offset_of!(ZCull, aliquot_count) == 32);
+const _: () = assert!(offset_of!(ZCull, subregions) == 36);
+const _: () = assert!(offset_of!(ZCull, subregion_count) == 100);
+const _: () = assert!(offset_of!(ZCull, subregion_algorithm) == 104);
diff --git a/src/nouveau/nil/android/nil.h b/src/nouveau/nil/android/nil.h
