+    // dispatch tables, so a plain static link drops them and leaves NULL
+    // entries (vkGetPhysicalDeviceProperties crashed calling a NULL
+    // GetPhysicalDeviceProperties2).
+    whole_static_libs: [
+        "nvk",
+        "vulkan_instance",
+        "vulkan_lite_runtime",
+        "vulkan_runtime",
+        "vulkan_wsi",
+    ],
+    static_libs: [
+        "_mesa_u_gralloc",
+        "blake3",
+        "compiler",
+        "mesa_compiler_rs_c_helpers",
+        "mesa_util",
+        "mesa_util_c11",
+        "mesa_util_clflush",
+        "mesa_util_clflushopt",
+        "mesa_util_simd",
+        "nak",
+        "nil_format_table",
+        "nil_layout_check",
+        "nir",
+        "nouveau_mme",
+        "nouveau_nvidia_headers_c",
+        "nouveau_ws",
+        "vtn",
+        "vulkan_util",
+        "xmlconfig",
+        "libnak_rs",
+        "libnil",
+    ],
+    shared_libs: [
+        "libcutils",
+        "libdrm",
+        "libhardware",
+        "liblog",
+        "libnativewindow",
+        "libsync",
+        "libzstd",
+    ],
+    relative_install_path: "hw",
+}
+''')
+
+with open(os.path.join(HERE, 'Android.bp'), 'w', encoding='utf-8') as f:
+    f.write(''.join(out))
diff --git a/src/nouveau/headers/android_gen.py b/src/nouveau/headers/android_gen.py
new file mode 100644
index 00000000..e21a5fa5
--- /dev/null
+++ b/src/nouveau/headers/android_gen.py
@@ -0,0 +1,121 @@
+# Copyright © 2026 android-pc
+# SPDX-License-Identifier: MIT
+
+# Soong wrapper around class_parser.py, struct_parser.py, lib_rs_gen.py and
+# nv_push_class_dump_h.py: one invocation generates everything that
+# headers/meson.build generates with one custom_target per class.  The class
+# list and the "previous class" rule are read from headers/meson.build so the
+# two builds stay in sync.
+
+import argparse
+import os
+import re
+import sys
+import tempfile
+
+import class_parser
+import lib_rs_gen
+import nv_push_class_dump_h
+import struct_parser
+
+
+def nv_classes(meson_build):
+    with open(meson_build, encoding='utf-8') as f:
+        text = f.read()
+    m = re.search(r'nv_classes\s*=\s*\[(.*?)\]', text, re.S)
+    return re.findall(r"'(cl[0-9a-f]+)'", m.group(1))
+
+
+def hwref_gens(meson_build):
+    with open(meson_build, encoding='utf-8') as f:
+        text = f.read()
+    m = re.search(r'hwref_gens\s*=\s*\[(.*?)\]', text, re.S)
+    return [g.split('/')[1] for g in re.findall(r"'([a-z]+/[a-z0-9]+)'", m.group(1))]
+
+
+def prev_class(classes, cl):
+    prev = None
+    for p in classes:
+        if p == cl:
+            break
+        if p[-2:] == cl[-2:]:
+            prev = p
+    return prev
+
+
+def run(mod, argv):
+    sys.argv = [mod.__name__] + argv
+    mod.main()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--mode', choices=['c', 'rs'], required=True)
+    parser.add_argument('--meson-build', required=True)
+    parser.add_argument('--out-dir', required=True,
+                        help='Headers (mode c) or Rust files (mode rs).')
+    parser.add_argument('--c-out-dir',
+                        help='Mode c: where the .c files go (else dropped).')
+    args = parser.parse_args()
+
+    classes_dir = os.path.join(os.path.dirname(args.meson_build),
+                               'nvidia', 'classes')
+    classes = nv_classes(args.meson_build)
+    out = args.out_dir
+
+    def cl_h(cl, suffix=''):
+        return os.path.join(classes_dir, cl + suffix + '.h')
+
+    if args.mode == 'c':
+        c_out = args.c_out_dir or tempfile.mkdtemp()
+        for cl in classes:
+            argv = ['--in-h', cl_h(cl),
+                    '--out-h', os.path.join(out, 'nv_push_' + cl + '.h'),
+                    '--out-c', os.path.join(c_out, 'nv_push_' + cl + '.c')]
+            prev = prev_class(classes, cl)
+            if prev:
+                argv += ['--prev-in-h', cl_h(prev)]
+            run(class_parser, argv)
+        run(nv_push_class_dump_h,
+            ['--classes', ' '.join(classes) + ' ',
+             '--out-h', os.path.join(out, 'nv_push_class_dump.h')])
+        return
+
+    rs = []
+    for cl in classes:
+        f = os.path.join(out, 'nvh_classes_' + cl + '.rs')
+        run(class_parser, ['--in-h', cl_h(cl), '--out-rs', f])
+        rs.append(f)
+
+        f = os.path.join(out, 'nvh_classes_' + cl + '_mthd.rs')
+        argv = ['--in-h', cl_h(cl), '--out-rs-mthd', f]
+        prev = prev_class(classes, cl)
+        if prev:
+            argv += ['--prev-in-h', cl_h(prev)]
+        run(class_parser, argv)
+        rs.append(f)
+
+        for suffix, cond in (('qmd', cl.endswith('c0')),
+                             ('tex', cl.endswith('97')),
+                             ('sph', True)):
+            if cond and os.path.isfile(cl_h(cl, suffix)):
+                f = os.path.join(out, 'nvh_classes_' + cl + '_' + suffix + '.rs')
+                run(struct_parser, ['--in-h', cl_h(cl, suffix), '--out-rs', f])
+                rs.append(f)
+
+    # The hwref MMU modules come from rust_bindgen crates (Soong cannot put a
+    # bindgen output next to generated sources), so lib.rs aliases them.
+    hwref = ['nvh_hwref_' + g + '_mmu' for g in hwref_gens(args.meson_build)]
+    lib_rs = os.path.join(out, 'lib.rs')
+    run(lib_rs_gen, ['--out-rs', lib_rs] + rs + [h + '.rs' for h in hwref])
+    with open(lib_rs, encoding='utf-8') as f:
+        text = f.read()
+    for h in hwref:
+        text = text.replace('mod ' + h + ';',
+                            'extern crate ' + h + '_bindgen as ' + h + ';')
+    with open(lib_rs, 'w', encoding='utf-8') as f:
+        f.write(text)
+
+
+if __name__ == '__main__':
+    main()
