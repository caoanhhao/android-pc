+    crate_name: "nak_latencies",
+    srcs: [":nak_latencies_rs"],
+}
+
+rust_bindgen {
+    name: "libnak_bindings",
+    defaults: ["mesa_bindgen_defaults"],
+    crate_name: "nak_bindings",
+    wrapper_src: "compiler/nak_bindings.h",
+    source_stem: "bindings",
