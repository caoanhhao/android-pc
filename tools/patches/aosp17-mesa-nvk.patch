+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written (not meson2hermetic output): the Rust compiler helpers for
+ * NAK (src/nouveau), translated from meson.build in this directory.
+ */
+
+package {
+    // See: http://go/android-license-faq
+    default_applicable_licenses: ["external_mesa3d_license"],
+}
+
+rust_defaults {
+    name: "mesa_rust_defaults",
+    vendor: true,
+    edition: "2021",
