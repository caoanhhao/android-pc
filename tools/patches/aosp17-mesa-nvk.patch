+        "--with-derive-default",
+''')
+for t in ['exec_list', 'exec_node', 'float_controls', 'gc_ctx',
+          'gl_access_qualifier', 'gl_frag_result', 'gl_interp_mode',
+          'mesa_shader_stage', 'gl_subgroup_size', 'gl_system_value',
+          'gl_tess_spacing', 'gl_varying_slot', 'gl_vert_attrib', 'glsl_type',
+          'glsl_matrix_layout', 'nir_.*', 'mesa_scope', 'mesa_prim',
+          'shader_info', 'tess_primitive_mode', 'u_printf_info']:
+    w(f'        "--blocklist-type", "{t}",\n')
+w('''    ],
+}
+
+rust_proc_macro {
+    name: "libnak_ir_proc",
+    crate_name: "nak_ir_proc",
+    edition: "2021",
+    lints: "none",
+    clippy_lints: "none",
