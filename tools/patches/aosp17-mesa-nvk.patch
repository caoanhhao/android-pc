+}
+
+genrule {
+    name: "nil_format_table_c",
+    tools: ["nil_format_table_gen"],
+    srcs: ["nil/nil_formats.csv"],
+    cmd: "$(location nil_format_table_gen) --csv $(in) " +
+        "--out-h $(genDir)/nil_format_table.h --out-c $(location nil_format_table.c)",
+    out: ["nil_format_table.c"],
+}
+
+cc_library_static {
+    name: "nil_format_table",
+    defaults: ["nouveau_c_defaults"],
+    srcs: [":nil_format_table_c"],
+    generated_headers: ["u_format_gen.h"],
+}
+
+cc_library_static {
+    name: "nil_layout_check",
+    defaults: ["nouveau_c_defaults"],
+    srcs: ["nil/android/nil_layout_check.c"],
+}
+
+rust_bindgen {
+    name: "libnil_rs_bindings",
+    defaults: ["mesa_bindgen_defaults"],
+    crate_name: "nil_rs_bindings",
+    wrapper_src: "nil/nil_bindings.h",
+    source_stem: "bindings",
+    header_libs: ["nouveau_headers"],
+    bindgen_flags: [
+        "--raw-line", "#![allow(non_camel_case_types)]",
+        "--raw-line", "#![allow(non_snake_case)]",
+        "--raw-line", "#![allow(non_upper_case_globals)]",
+        "--raw-line", "#![allow(improper_ctypes)]",
+        "--raw-line", "#![allow(clippy::all)]",
