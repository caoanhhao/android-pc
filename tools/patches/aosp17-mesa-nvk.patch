+}
+
+cc_library_static {
+    name: "nvk",
+    defaults: [
+        "nouveau_c_defaults",
+        "vulkan_wsi_list",
+    ],
+    header_libs: [
+        "hwvulkan_headers",
+        "inc_src_vulkan_runtime",
+        "inc_src_vulkan_util",
+        "inc_src_vulkan_wsi",
+    ],
+    generated_headers: [
+        "git_sha1.h",
+        "nvk_entrypoints_headers",
+        "nvkcl_h",
+        "shader_stats.h",
+        "spirv_info_headers",
+        "vk_cmd_enqueue_entrypoints_headers",
+        "vk_cmd_queue_headers",
+        "vk_common_entrypoints_headers",
+        "vk_dispatch_table_headers",
+        "vk_enum_to_str_headers",
+        "vk_extensions_headers",
+        "vk_format_info_headers",
+        "vk_physical_device_features_headers",
+        "vk_physical_device_properties_headers",
+        "vk_physical_device_spirv_caps",
+        "vk_struct_type_cast",
+        "vk_synchronization_helpers",
+        "wsi_entrypoints_headers",
+    ],
+    generated_sources: [
+        "nvk_entrypoints_impl",
+        "nvkcl_cpp",
+    ],
+    srcs: [
+''')
+w(lst(['vulkan/' + f for f in nvk_c] + ['vulkan/nvk_android.c']))
+w('''    ],
+    shared_libs: [
+        "libcutils",
+        "libhardware",
+        "liblog",
+        "libnativewindow",
+        "libsync",
+    ],
+}
+
+cc_library_shared {
+    name: "vulkan.nouveau",
+    host_supported: false,
+    defaults: [
+        "aosp_mesa3d_c_link_args",
+        "aosp_mesa3d_cpp_link_args",
+        "ld_args_bsymbolic",
+        "ld_args_gc_sections",
+        "nouveau_c_defaults",
+    ],
+    // 64-bit only: NAK is a Rust staticlib and 32-bit apps keep the
+    // software driver.
+    compile_multilib: "64",
+    // NVK derives its pipeline cache UUID from the build-id and refuses
+    // to create an instance (VK_ERROR_INITIALIZATION_FAILED) unless it
+    // is a 20-byte SHA-1; Soong links with --build-id=md5 (16 bytes).
+    // Meson passes -Wl,--build-id=sha1 for the same reason.
+    ldflags: ["-Wl,--build-id=sha1"],
