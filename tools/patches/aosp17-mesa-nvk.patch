diff --git a/src/compiler/spirv/vtn_bindgen2.c b/src/compiler/spirv/vtn_bindgen2.c
index f4db0e79..29e34fbc 100644
--- a/src/compiler/spirv/vtn_bindgen2.c
+++ b/src/compiler/spirv/vtn_bindgen2.c
@@ -257,6 +257,17 @@ compile(void *memctx, const uint32_t *spirv, size_t spirv_size)
    /* Re-index SSA defs at the very end to make the NIR more legible. This
     * doesn't matter for correctness, but it's polite.
     */
+   /* SPIR-V from LLVM's own SPIR-V backend (android-pc builds NVK's kernels
+    * that way, without SPIRV-LLVM-Translator) has no OpName for function
+    * parameters; the generated C needs a name for each.
+    */
+   nir_foreach_function(func, nir) {
+      for (unsigned i = 0; i < func->num_params; ++i) {
+         if (func->params[i].name == NULL)
+            func->params[i].name = ralloc_asprintf(nir, "arg%u", i);
+      }
+   }
+
    nir_foreach_function_impl(it, nir) {
       nir_index_ssa_defs(it);
    }
