+# Copyright © 2026 android-pc
+# SPDX-License-Identifier: MIT
+
+# Writes src/nouveau/Android.bp (NVK, NAK, NIL for Soong) from the
+# meson.build files of src/nouveau, so the file lists stay in sync.
+# Run it from anywhere after a Mesa update:  python3 android_bp_gen.py
+
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, 'headers'))
+import android_gen  # noqa: E402
+
+
+def meson_files(path, var):
+    """The quoted file names of `var = files(...)` / `var = [...]`."""
+    with open(os.path.join(HERE, path), encoding='utf-8') as f:
+        text = f.read()
+    m = re.search(var + r"\s*=\s*(?:files\()?\s*[\(\[](.*?)[\)\]]", text, re.S)
+    if not m:
+        m = re.search(var + r"\s*=\s*files\((.*?)\)", text, re.S)
+    return re.findall(r"'([^']+)'", m.group(1))
+
+
+def lst(items, indent=8):
+    pad = ' ' * indent
+    return ''.join(f'{pad}"{i}",\n' for i in items)
+
+
+hdr_meson = os.path.join(HERE, 'headers', 'meson.build')
+classes = android_gen.nv_classes(hdr_meson)
+gens = android_gen.hwref_gens(hdr_meson)
+classes_dir = os.path.join(HERE, 'headers', 'nvidia', 'classes')
+
+push_h = [f'nv_push_{cl}.h' for cl in classes] + ['nv_push_class_dump.h']
+push_c = [f'nv_push_{cl}.c' for cl in classes]
+rs = []
+for cl in classes:
+    rs += [f'nvh_classes_{cl}.rs', f'nvh_classes_{cl}_mthd.rs']
+    for suffix, cond in (('qmd', cl.endswith('c0')), ('tex', cl.endswith('97')),
+                         ('sph', True)):
+        if cond and os.path.isfile(os.path.join(classes_dir, cl + suffix + '.h')):
+            rs.append(f'nvh_classes_{cl}_{suffix}.rs')
+rs = ['lib.rs'] + rs   # crate root first
+
+hwref_family = {}
+with open(hdr_meson, encoding='utf-8') as f:
+    for fam, gen in re.findall(r"'([a-z]+)/([a-z0-9]+)'", f.read()):
+        hwref_family[gen] = fam
+
+mme_c = [f for f in meson_files('mme/meson.build', 'libnouveau_mme_files')
+         if f.endswith('.c')]
+nak_c = [f for f in meson_files('compiler/meson.build', 'libnak_c_files')
+         if f.endswith('.c')]
+nvk_c = [f for f in meson_files('vulkan/meson.build', 'nvk_files')
+         if f.endswith('.c')]
+
+out = []
+w = out.append
+
+w('''/*
+ * Copyright (C) 2026 android-pc
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * NVK (Vulkan for NVIDIA through nouveau), with the NAK shader compiler and
+ * the NIL image layout library, for Soong.  Generated by
+ * android_bp_gen.py from the meson.build files of this directory; edit the
+ * generator, not this file.  Differences from meson:
+ *  - nil.h is hand-written (nil/android/nil.h; no cbindgen in Soong) and
+ *    checked against the Rust layout at build time;
+ *  - the internal OpenCL kernels are compiled to SPIR-V on the host
+ *    (vulkan/cl/android/nvkcl.spv, see tools/mesa-nvkcl-spv.sh in
+ *    android-pc), vtn_bindgen2 runs here;
+ *  - the hwref MMU bindings are separate rust_bindgen crates aliased in
+ *    the generated nvidia_headers lib.rs (headers/android_gen.py).
+ */
+
+package {
+    // See: http://go/android-license-faq
+    default_applicable_licenses: ["external_mesa3d_license"],
+}
+
+// ---- Python generators ---------------------------------------------------
+
+filegroup {
+    name: "nouveau_headers_py",
+    srcs: [
+        "headers/android_gen.py",
+        "headers/class_parser.py",
+        "headers/lib_rs_gen.py",
+        "headers/nv_push_class_dump_h.py",
+        "headers/struct_parser.py",
+        "headers/util.py",
+    ],
+    path: "headers",
+}
+
+python_binary_host {
+    name: "nouveau_headers_gen",
+    main: "android_gen.py",
+    srcs: [":nouveau_headers_py"],
+    libs: ["mako"],
+}
+
+filegroup {
+    name: "nouveau_lat_py",
+    srcs: [
+        "compiler/latencies/lat_rs_gen.py",
+        "compiler/latencies/lib_rs_gen.py",
+    ],
+    path: "compiler/latencies",
+}
+
+filegroup {
+    name: "nouveau_util_py",
+    srcs: ["headers/util.py"],
+    path: "headers",
+}
+
+python_binary_host {
+    name: "nak_lat_rs_gen",
+    main: "lat_rs_gen.py",
+    srcs: [
+        ":nouveau_lat_py",
+        ":nouveau_util_py",
+    ],
+    libs: ["mako"],
+}
+
+python_binary_host {
+    name: "nak_lat_lib_rs_gen",
+    main: "lib_rs_gen.py",
+    srcs: [
+        ":nouveau_lat_py",
+        ":nouveau_util_py",
+    ],
+    libs: ["mako"],
+}
+
+filegroup {
+    name: "nak_nir_algebraic_py_src",
+    srcs: ["compiler/nak_nir_algebraic.py"],
+    path: "compiler",
+}
+
+python_binary_host {
+    name: "nak_nir_algebraic_py_binary",
+    main: "nak_nir_algebraic.py",
+    srcs: [
+        ":nak_nir_algebraic_py_src",
+        ":nir_algebraic_py",
+    ],
+    libs: ["mako"],
+}
+
+filegroup {
+    name: "nil_format_table_py",
+    srcs: ["nil/nil_format_table_gen.py"],
+    path: "nil",
+}
+
+python_binary_host {
+    name: "nil_format_table_gen",
+    main: "nil_format_table_gen.py",
+    srcs: [":nil_format_table_py"],
+    libs: ["mako"],
+}
+
+// ---- headers: class headers and nv_push ----------------------------------
+
+genrule {
+    name: "nouveau_nv_push_headers",
+    tools: ["nouveau_headers_gen"],
+    srcs: [
+        "headers/meson.build",
+        "headers/nvidia/classes/*.h",
+    ],
+    cmd: "$(location nouveau_headers_gen) --mode c " +
+        "--meson-build $(location headers/meson.build) --out-dir $(genDir)",
+    out: [
+''')
+w(lst(push_h))
+w('''    ],
+}
+
+genrule {
+    name: "nouveau_nv_push_sources",
+    tools: ["nouveau_headers_gen"],
+    srcs: [
+        "headers/meson.build",
+        "headers/nvidia/classes/*.h",
+    ],
+    cmd: "mkdir -p $(genDir)/h && $(location nouveau_headers_gen) --mode c " +
+        "--meson-build $(location headers/meson.build) " +
+        "--out-dir $(genDir)/h --c-out-dir $(genDir)",
+    out: [
+''')
+w(lst(push_c))
+w('''    ],
+}
+
+genrule {
+    name: "nouveau_nvidia_headers_rs",
+    tools: ["nouveau_headers_gen"],
+    srcs: [
+        "headers/meson.build",
+        "headers/nvidia/classes/*.h",
+    ],
+    cmd: "$(location nouveau_headers_gen) --mode rs " +
+        "--meson-build $(location headers/meson.build) --out-dir $(genDir)",
+    out: [
+''')
+w(lst(rs))
+w('''    ],
+}
+
+// Include directories of the whole driver (meson's inc_* plus the
+// directories every nouveau declare_dependency() exports).
+cc_library_headers {
+    name: "nouveau_headers",
+    vendor: true,
+    header_libs: ["mesa_compiler_rs_headers"],
+    export_header_lib_headers: ["mesa_compiler_rs_headers"],
+    export_include_dirs: [
+        "headers",
+        "headers/nvidia/classes",
+        "drm",
+        "winsys",
+        "mme",
+        "nil/android",
+        "nil",
+        "compiler",
+        "vulkan",
+    ],
+    generated_headers: [
+        "nouveau_nv_push_headers",
+        "nil_format_table_h",
+    ],
+    export_generated_headers: [
+        "nouveau_nv_push_headers",
+        "nil_format_table_h",
+    ],
+}
+
+cc_defaults {
+    name: "nouveau_c_defaults",
+    vendor: true,
+    // Device only (the Mesa project defaults turn host builds on).
+    host_supported: false,
+    c_std: "c11",
+    cpp_std: "c++17",
+    defaults: [
+        "aosp_mesa3d_c_project_args",
+        "aosp_mesa3d_cpp_project_args",
+        "no_override_init_args",
+    ],
+    header_libs: [
+        "inc_include",
+        "inc_src",
+        "inc_util",
+        "inc_util_c11",
+        "nouveau_headers",
+    ],
+    cflags: [
+        "-fvisibility=hidden",
+        "-Wno-gnu-variable-sized-type-not-at-end",
+        // Mesa's meson build allows void pointer arithmetic (a GNU extension).
+        "-Wno-gnu-pointer-arith",
+        "-Wno-pointer-arith",
+    ],
+    shared_libs: ["libdrm"],
+}
+
+cc_library_static {
+    name: "nouveau_nvidia_headers_c",
+    defaults: ["nouveau_c_defaults"],
+    srcs: [
+        "headers/nv_push.c",
+        ":nouveau_nv_push_sources",
+    ],
+}
+
+''')
+
+for gen in gens:
+    fam = hwref_family[gen]
+    w(f'''rust_bindgen {{
+    name: "libnvh_hwref_{gen}_mmu_bindgen",
+    defaults: ["mesa_bindgen_defaults"],
+    crate_name: "nvh_hwref_{gen}_mmu_bindgen",
+    wrapper_src: "headers/nvidia/hwref/{fam}/{gen}/dev_mmu.h",
+    source_stem: "bindings",
+    bindgen_flags: [
+        "--allowlist-var", "NV_MMU_.*",
+        "--raw-line", "#![allow(non_upper_case_globals)]",
+    ],
+}}
+
+''')
+
+w('''rust_library {
+    name: "libnvidia_headers",
+    defaults: ["mesa_rust_defaults"],
+    crate_name: "nvidia_headers",
+    srcs: [":nouveau_nvidia_headers_rs"],
+    rustlibs: [
+''')
+w(lst([f'libnvh_hwref_{g}_mmu_bindgen' for g in gens]))
+w('''    ],
+}
+
+rust_library {
+    name: "libnv_push_rs",
+    defaults: ["mesa_rust_defaults"],
+    crate_name: "nv_push_rs",
+    srcs: ["headers/nv_push_rs/lib.rs"],
+    rustlibs: ["libnvidia_headers"],
+}
+
+rust_library {
+    name: "libbitview",
+    defaults: ["mesa_rust_defaults"],
+    crate_name: "bitview",
+    srcs: ["rust/bitview/lib.rs"],
+}
+
+// ---- winsys, mme -----------------------------------------------------------
+
+cc_library_static {
+    name: "nouveau_ws",
+    defaults: ["nouveau_c_defaults"],
+    srcs: [
+        "winsys/nouveau_bo.c",
+        "winsys/nouveau_context.c",
+        "winsys/nouveau_device.c",
+    ],
+}
+
+cc_library_static {
+    name: "nouveau_mme",
+    defaults: ["nouveau_c_defaults"],
+    srcs: [
+''')
+w(lst(['mme/' + f for f in mme_c]))
+w('''    ],
+}
+
+// ---- NIL -------------------------------------------------------------------
+
+genrule {
+    name: "nil_format_table_h",
+    tools: ["nil_format_table_gen"],
+    srcs: ["nil/nil_formats.csv"],
+    cmd: "$(location nil_format_table_gen) --csv $(in) " +
+        "--out-h $(location nil_format_table.h) --out-c $(genDir)/nil_format_table.c",
