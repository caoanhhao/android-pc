new file mode 100644
index 00000000..ef1cea50
--- /dev/null
+++ b/src/util/u_gralloc/u_gralloc_minigbm.c
@@ -0,0 +1,130 @@
+/*
+ * Mesa 3-D graphics library
+ *
+ * Copyright © 2026 android-pc
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Buffer info straight from minigbm's native handle (struct
+ * cros_gralloc_handle in minigbm/cros_gralloc/cros_gralloc_handle.h), the
+ * way gfxstream's GrallocMinigbm.cpp does it.  Needed when minigbm runs
+ * behind the AIDL allocator and the stable-C IMapper: the CrOS backend
+ * needs the gralloc0 module and a buffer it imported itself, and the
+ * IMapper backends need libui, which vendor code cannot link.  Unlike the
+ * fallback backend it reports the real format modifier and plane layout.
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <cutils/properties.h>
+#include <cutils/native_handle.h>
+
+#include "drm-uapi/drm_fourcc.h"
+#include "util/log.h"
+#include "util/u_memory.h"
+
+#include "u_gralloc_internal.h"
+
+#define MINIGBM_MAGIC 0xABCDDCBA
+#define MINIGBM_MAX_PLANES 4
+#define MINIGBM_MAX_FDS (MINIGBM_MAX_PLANES + 1)
+/* minigbm's internal fourcc for HAL_PIXEL_FORMAT_YV12 */
+#define MINIGBM_FORMAT_YVU420_ANDROID fourcc_code('9', '9', '9', '7')
+
+/* struct cros_gralloc_handle, with native_handle_t's header spelled out */
+struct minigbm_handle {
+   int version;
+   int numFds;
+   int numInts;
+   int32_t fds[MINIGBM_MAX_FDS];
+   uint32_t strides[MINIGBM_MAX_PLANES];
+   uint32_t offsets[MINIGBM_MAX_PLANES];
+   uint32_t sizes[MINIGBM_MAX_PLANES];
+   uint32_t id;
+   uint32_t width;
+   uint32_t height;
+   uint32_t format;
+   uint32_t tiling;
+   uint64_t format_modifier;
+   uint64_t use_flags;
+   uint32_t magic;
+   uint32_t pixel_stride;
+   int32_t droid_format;
+   int64_t usage;
+   uint32_t num_planes;
+   uint64_t reserved_region_size;
+   uint64_t total_size;
+} __attribute__((packed));
+
+static const struct minigbm_handle *
+minigbm_handle(const native_handle_t *handle)
+{
+   if (!handle || handle->version != sizeof(native_handle_t))
+      return NULL;
+
+   size_t size = sizeof(native_handle_t) +
+                 sizeof(int) * (handle->numFds + handle->numInts);
+   if (size < sizeof(struct minigbm_handle))
+      return NULL;
+
+   const struct minigbm_handle *hnd = (const struct minigbm_handle *)handle;
+   if (hnd->magic != MINIGBM_MAGIC || hnd->num_planes == 0 ||
+       hnd->num_planes > MINIGBM_MAX_PLANES)
+      return NULL;
+
+   return hnd;
+}
+
+static int
+minigbm_get_buffer_basic_info(struct u_gralloc *gralloc,
+                              struct u_gralloc_buffer_handle *hnd,
+                              struct u_gralloc_buffer_basic_info *out)
+{
+   const struct minigbm_handle *mh = minigbm_handle(hnd->handle);
+   if (!mh) {
+      mesa_loge("not a minigbm buffer handle");
+      return -EINVAL;
+   }
+
+   out->drm_fourcc = mh->format == MINIGBM_FORMAT_YVU420_ANDROID ?
+                     DRM_FORMAT_YVU420 : mh->format;
+   out->modifier = mh->format_modifier;
+   out->num_planes = mh->num_planes;
+   for (uint32_t i = 0; i < mh->num_planes; i++) {
+      out->fds[i] = mh->fds[i];
+      out->offsets[i] = mh->offsets[i];
+      out->strides[i] = mh->strides[i];
+   }
+
+   return 0;
+}
+
+static int
+minigbm_destroy(struct u_gralloc *gralloc)
+{
+   FREE(gralloc);
+   return 0;
+}
+
+struct u_gralloc *
+u_gralloc_minigbm_create(void)
+{
+   char value[PROPERTY_VALUE_MAX];
+
+   property_get("ro.hardware.gralloc", value, "");
+   if (strncmp(value, "minigbm", strlen("minigbm")) != 0)
+      return NULL;
+
+   struct u_gralloc *gr = CALLOC_STRUCT(u_gralloc);
+   if (!gr)
+      return NULL;
+
+   gr->ops.get_buffer_basic_info = minigbm_get_buffer_basic_info;
+   gr->ops.destroy = minigbm_destroy;
+
+   mesa_logi("Using minigbm native handles (ro.hardware.gralloc=%s)", value);
+
+   return gr;
+}
