+std::map<int, dev_t> GetPartitionDevices(const std::string& sysPath) {
+    std::map<int, dev_t> parts;
+    std::unique_ptr<DIR, decltype(&closedir)> dir(opendir(sysPath.c_str()), closedir);
+    if (!dir) return parts;
+    while (dirent* ent = readdir(dir.get())) {
+        std::string num, devNum;
+        if (ent->d_name[0] == '.' ||
+            !ReadFileToString(sysPath + "/" + ent->d_name + "/partition", &num) ||
+            !ReadFileToString(sysPath + "/" + ent->d_name + "/dev", &devNum)) {
+            continue;
+        }
+        unsigned int maj, min;
+        int n;
+        if (android::base::ParseInt(android::base::Trim(num), &n) &&
+            sscanf(devNum.c_str(), "%u:%u", &maj, &min) == 2) {
+            parts[n] = makedev(maj, min);
+        }
+    }
+    return parts;
+}
