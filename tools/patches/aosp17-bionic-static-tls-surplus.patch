+static bool has_df_static_tls(const soinfo* si) {
+  if (si->dynamic == nullptr) return false;
+  for (const ElfW(Dyn)* d = si->dynamic; d->d_tag != DT_NULL; ++d) {
+    if (d->d_tag == DT_FLAGS && (d->d_un.d_val & DF_STATIC_TLS) != 0) return true;
