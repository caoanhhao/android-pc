+static size_t reserve_static_tls_surplus(soinfo* si, const TlsSegment& seg) {
+  if (g_static_tls_surplus_cursor == SIZE_MAX || !has_df_static_tls(si)) return SIZE_MAX;
+  bool zero_image = true;
+  const char* init = static_cast<const char*>(seg.init_ptr);
+  for (size_t i = 0; i < seg.init_size; ++i) {
+    if (init[i] != 0) zero_image = false;
+  }
+  if (!zero_image && __libc_shared_globals()->static_tls_init_callback == nullptr) return SIZE_MAX;
+  const TlsAlign align = seg.aligned_size.align;
+  if (align.value > kStaticTlsSurplusAlign) return SIZE_MAX;
+  const size_t cursor = g_static_tls_surplus_cursor;
+  const size_t offset = ((cursor - align.skew + align.value - 1) & ~(align.value - 1)) + align.skew;
+  if (offset < cursor || offset > g_static_tls_surplus_end ||
+      seg.aligned_size.size > g_static_tls_surplus_end - offset) {
+    return SIZE_MAX;
+  }
+  g_static_tls_surplus_cursor = offset + seg.aligned_size.size;
+  si->set_nodelete();
+  if (seg.init_size != 0) g_static_tls_surplus_pending.push_back(si);
+  LD_DEBUG(any, "[ \"%s\" uses %zu bytes of the static TLS surplus at offset %zu ]",
+           si->get_realpath(), seg.aligned_size.size, offset);
+  return offset;
