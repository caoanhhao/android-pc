+// The linker's static TLS surplus: copies a dlopen()ed module's image into every thread. Threads
+// being created hold g_thread_creation_lock for reading and copy it themselves
+// (__init_static_tls_surplus), so none is missed.
+void __pthread_internal_init_static_tls(size_t offset, const void* init, size_t init_size) {
+  ScopedWriteLock creation_locker(&g_thread_creation_lock);
+  ScopedReadLock list_locker(&g_thread_list_lock);
+  const size_t tcb_offset = __libc_shared_globals()->static_tls_layout.offset_bionic_tcb();
+  for (pthread_internal_t* t = g_thread_list; t != nullptr; t = t->next) {
+    memcpy(reinterpret_cast<char*>(t->bionic_tcb) - tcb_offset + offset, init, init_size);
+  }
+}
