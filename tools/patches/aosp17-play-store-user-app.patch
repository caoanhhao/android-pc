+    // Local (android-pc): Google Play Store and microG installed as ordinary apps in userdata get
+    // the allow-in-power-save the ROM's sysconfig lists for them, as preinstalled ones get from
+    // google.xml on GMS devices. Play's systemExempted foreground services (VpaService at boot,
+    // DownloadService) crash without it, and `cmd deviceidle whitelist` does not survive Play
+    // reinstalling itself. Only with their own signing certificates (past ones count, Play rotates
+    // its key), so another app with the same package name gets nothing. Same certificates as
+    // AppIdPermissionPolicy.PLAY_STORE_CERT_SHA256 and ComputerEngine's microG ones.
+    private static final ArrayMap<String, String[]> USER_APP_CERTS_SHA256 = new ArrayMap<>();
+    static {
+        USER_APP_CERTS_SHA256.put("com.android.vending", new String[] {
+                "f0fd6c5b410f25cb25c3b53346c8972fae30f8ee7411df910480ad6b2d60db83"});
+        USER_APP_CERTS_SHA256.put("com.google.android.gms", new String[] {
+                "9bd06727e62796c0130eb6dab39b73157451582cbd138e86c468acc395d14165",
+                "a40da80a59d170caa950cf15c18c454d47a39b26989d8b640ecd745ba71bf5dc"});
+    }
+
+    private ApplicationInfo getAllowInPowerSaveAppInfo(String pkg)
+            throws PackageManager.NameNotFoundException {
+        try {
+            return mPackageManager.getApplicationInfo(pkg,
+                    PackageManager.MATCH_ANY_USER | PackageManager.MATCH_SYSTEM_ONLY);
+        } catch (PackageManager.NameNotFoundException e) {
+            String[] certs = USER_APP_CERTS_SHA256.get(pkg);
+            for (int i = 0; certs != null && i < certs.length; i++) {
+                if (mPackageManager.hasSigningCertificate(pkg,
+                        HexDump.hexStringToByteArray(certs[i]),
+                        PackageManager.CERT_INPUT_SHA256)) {
+                    return mPackageManager.getApplicationInfo(pkg, PackageManager.MATCH_ANY_USER);
+                }
+            }
+            throw e;
+        }
+    }
