+package com.android.server.locksettings;
+
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PASSWORD;
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PATTERN;
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PIN;
+
+import android.security.keystore.KeyProperties;
+import android.security.keystore.KeyProtection;
+
+import com.android.internal.util.ArrayUtils;
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.KeyStore;
+import java.security.SecureRandom;
+import java.util.Arrays;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Wraps the user's lock screen credential with a keystore key, so that a strong biometric can
+ * unlock credential-encrypted storage after boot when {@code config_strongAuthRequiredOnBoot} is
+ * false (android-pc, docs/lockdown-biometric.md). The key needs no user authentication: whoever
+ * can use system_server's keystore keys can read the credential.
+ *
+ * <p>Blob format: credential type (1 byte), GCM IV (12 bytes), ciphertext.</p>
+ */
+class BootUnlockCredentialCrypto {
+
+    private static final String KEY_ALIAS = "boot_unlock_credential_";
+    private static final String TRANSFORMATION = KeyProperties.KEY_ALGORITHM_AES + "/"
+            + KeyProperties.BLOCK_MODE_GCM + "/" + KeyProperties.ENCRYPTION_PADDING_NONE;
+    private static final int IV_SIZE = 12;
+
+    private BootUnlockCredentialCrypto() {
+    }
+
+    static byte[] encrypt(KeyStore keyStore, int userId, LockscreenCredential credential)
+            throws GeneralSecurityException {
+        KeyGenerator keyGenerator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES);
+        keyGenerator.init(256, new SecureRandom());
+        SecretKey secretKey = keyGenerator.generateKey();
+        keyStore.setEntry(
+                alias(userId),
+                new KeyStore.SecretKeyEntry(secretKey),
+                new KeyProtection.Builder(KeyProperties.PURPOSE_ENCRYPT
+                        | KeyProperties.PURPOSE_DECRYPT)
+                        .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                        .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                        .build());
+        Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+        cipher.init(Cipher.ENCRYPT_MODE, (SecretKey) keyStore.getKey(alias(userId), null));
+        byte[] ciphertext = cipher.doFinal(credential.getCredential());
+        byte[] iv = cipher.getIV();
+        if (iv.length != IV_SIZE) {
+            throw new GeneralSecurityException("Invalid iv length: " + iv.length);
+        }
+        return ArrayUtils.concat(new byte[] {(byte) credential.getType()}, iv, ciphertext);
+    }
+
+    static LockscreenCredential decrypt(KeyStore keyStore, int userId, byte[] blob)
+            throws GeneralSecurityException {
+        if (blob.length <= 1 + IV_SIZE) {
+            throw new GeneralSecurityException("Blob too short");
+        }
+        SecretKey key = (SecretKey) keyStore.getKey(alias(userId), null);
+        if (key == null) {
+            throw new GeneralSecurityException("No key");
+        }
+        Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+        cipher.init(Cipher.DECRYPT_MODE, key,
+                new GCMParameterSpec(128, Arrays.copyOfRange(blob, 1, 1 + IV_SIZE)));
+        byte[] secret = cipher.doFinal(blob, 1 + IV_SIZE, blob.length - 1 - IV_SIZE);
+        try {
+            switch (blob[0]) {
+                case CREDENTIAL_TYPE_PIN:
+                    return LockscreenCredential.createPin(
+                            new String(secret, StandardCharsets.ISO_8859_1));
+                case CREDENTIAL_TYPE_PASSWORD:
+                    return LockscreenCredential.createPassword(
+                            new String(secret, StandardCharsets.ISO_8859_1));
+                case CREDENTIAL_TYPE_PATTERN:
+                    return LockscreenCredential.createPattern(
+                            LockPatternUtils.byteArrayToPattern(secret));
+                default:
+                    throw new GeneralSecurityException("Unknown credential type " + blob[0]);
+            }
+        } finally {
+            ArrayUtils.zeroize(secret);
+        }
+    }
+
+    static void removeKey(KeyStore keyStore, int userId) throws GeneralSecurityException {
+        if (keyStore.containsAlias(alias(userId))) {
+            keyStore.deleteEntry(alias(userId));
+        }
+    }
+
+    private static String alias(int userId) {
+        return KEY_ALIAS + userId;
+    }
+}
