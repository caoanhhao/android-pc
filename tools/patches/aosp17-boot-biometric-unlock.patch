+    /**
+     * Whether a strong biometric may unlock the user after boot (android-pc,
+     * docs/lockdown-biometric.md). {@code config_strongAuthRequiredOnBoot} false lets the
+     * biometric dismiss the keyguard, but the user stays RUNNING_LOCKED until the synthetic
+     * password unlocks its credential-encrypted storage, with file-based encryption or without.
+     */
+    private boolean isBootUnlockCredentialEnabled() {
+        return !mContext.getResources().getBoolean(
+                com.android.internal.R.bool.config_strongAuthRequiredOnBoot);
+    }
+
+    /** Keeps the user's credential, wrapped by keystore, for {@link
+     * #unlockUserWithBootUnlockCredential}; removes it when the feature is off. */
+    private void rememberBootUnlockCredential(LockscreenCredential credential, int userId) {
+        if (!isBootUnlockCredentialEnabled() || credential.isNone()
+                || isCredentialShareableWithParent(userId)) {
+            forgetBootUnlockCredential(userId);
+            return;
+        }
+        try {
+            mStorage.writeBootUnlockCredential(userId,
+                    BootUnlockCredentialCrypto.encrypt(mKeyStore, userId, credential));
+        } catch (GeneralSecurityException | RuntimeException e) {
+            Slog.e(TAG, "Failed to remember the credential for boot unlock", e);
+            forgetBootUnlockCredential(userId);
+        }
+    }
+
+    private void forgetBootUnlockCredential(int userId) {
+        if (!mStorage.hasBootUnlockCredential(userId)) {
+            return;
+        }
+        mStorage.removeBootUnlockCredential(userId);
+        try {
+            BootUnlockCredentialCrypto.removeKey(mKeyStore, userId);
+        } catch (GeneralSecurityException e) {
+            Slog.w(TAG, "Failed to remove the boot unlock key", e);
+        }
+    }
+
+    /**
+     * After a strong biometric unlock, unlocks a user whose credential-encrypted storage is still
+     * locked since boot with the credential remembered at its last unlock.
+     */
+    private void unlockUserWithBootUnlockCredential(int userId) {
+        if (!isBootUnlockCredentialEnabled() || mUserManager.isUserUnlockingOrUnlocked(userId)) {
+            return;
+        }
+        byte[] blob = mStorage.readBootUnlockCredential(userId);
+        if (blob == null) {
+            Slogf.i(TAG, "No boot unlock credential for user %d; the credential is needed once",
+                    userId);
+            return;
+        }
+        LockscreenCredential credential;
+        try {
+            credential = BootUnlockCredentialCrypto.decrypt(mKeyStore, userId, blob);
+        } catch (GeneralSecurityException | RuntimeException e) {
+            Slog.e(TAG, "Failed to read the boot unlock credential", e);
+            forgetBootUnlockCredential(userId);
+            return;
+        }
+        try (credential) {
+            Slogf.i(TAG, "Unlocking user %d after a strong biometric unlock", userId);
+            if (!doVerifyCredential(credential, userId, null, 0).isMatched()) {
+                Slogf.w(TAG, "Boot unlock credential of user %d no longer matches", userId);
+                forgetBootUnlockCredential(userId);
+            }
+        }
+    }
+
