         if (hostActivity.getPackageManager().hasSystemFeature(FEATURE_PC)) {
             return false;
         }
+        // android-pc: a desktop window (freeform, e.g. a tile of the hypr desktop on the
+        // gts7l tablet) is no split screen. Only udfps needs the whole screen for its sensor
+        // overlay; a side-key or rear sensor enrolls fine in a window.
+        if (hostActivity.getResources().getConfiguration().windowConfiguration
