+    // Local (android-pc): restricted signature spoofing for microG. Only these packages, and
+    // only when preinstalled on a system partition, may report the Google signature carried
+    // in their "fake-signature" meta-data. The one exception is microG's GmsCore installed
+    // as an ordinary app, and only when signed with microG's own release key (SHA-256 of the
+    // certificate below), so it can live in userdata on a ROM that carries no Google apps.
+    private static final Set<String> MICROG_PACKAGES = Set.of(
+            "com.google.android.gms", "com.google.android.gsf", "com.android.vending");
+    private static final byte[] MICROG_CERT_SHA256 = libcore.util.HexEncoding.decode(
+            "9bd06727e62796c0130eb6dab39b73157451582cbd138e86c468acc395d14165");
+
+    private static void spoofMicroGSignature(PackageStateInternal ps, AndroidPackage p,
+            long flags, PackageInfo packageInfo) {
+        if ((flags & (PackageManager.GET_SIGNATURES
+                | PackageManager.GET_SIGNING_CERTIFICATES)) == 0
+                || !MICROG_PACKAGES.contains(p.getPackageName())
+                || p.getMetaData() == null) {
+            return;
+        }
+        if (!ps.isSystem() && !("com.google.android.gms".equals(p.getPackageName())
+                && p.getSigningDetails().hasSha256Certificate(MICROG_CERT_SHA256))) {
+            return;
+        }
+        final String fake = p.getMetaData().getString("fake-signature");
+        if (fake == null || fake.isEmpty()) {
+            return;
+        }
+        try {
+            final Signature[] sigs = { new Signature(fake) };
+            if ((flags & PackageManager.GET_SIGNATURES) != 0) {
+                packageInfo.signatures = sigs;
+            }
+            if ((flags & PackageManager.GET_SIGNING_CERTIFICATES) != 0) {
+                packageInfo.signingInfo = new SigningInfo(new SigningDetails(sigs,
+                        SigningDetails.SignatureSchemeVersion.SIGNING_BLOCK_V3));
+            }
+        } catch (IllegalArgumentException | java.security.cert.CertificateException e) {
+            Slog.w(TAG, "Bad fake-signature in " + p.getPackageName(), e);
+        }
+    }
+
