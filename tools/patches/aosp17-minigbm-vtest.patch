+/*
+ * vtest: gralloc for Venus over vtest (android-pc Phase K3, NVIDIA's own driver in a glibc
+ * sidecar). There is no DRM device to allocate on: GPU-only buffers (window buffers, render
+ * targets, textures) are allocated by the vtest server on the real GPU with
+ * VCMD_ALLOC_DMABUF_IMAGE (vtest protocol 6, waydroid-nvidia's virglrenderer patches) and come
+ * back as dma-bufs with the GPU's own DRM modifier (NVIDIA block-linear); every other buffer
+ * (CPU access, video, camera, blobs, and anything the server cannot allocate) is linear system
+ * memory turned into a dma-buf by udmabuf, which Venus imports and the CPU maps.
+ *
+ * Selected instead of the DRM node scan when ro.vendor.minigbm.vtest is true (init.venus.rc on the
+ * NVIDIA entry). The server's socket is ro.vendor.minigbm.vtest.socket, else
+ * vendor.mesa.vtest.socket.name (Venus's own), else /dev/socket/vtest. bo->handle is the dma-buf
+ * fd, as in the dma_heap backend.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <linux/memfd.h>
+#include <linux/udmabuf.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "drv_helpers.h"
+#include "drv_priv.h"
+#include "external/dma-buf.h"
+#include "util.h"
+
+#define VTEST_DEFAULT_SOCKET "/dev/socket/vtest"
+
+/* virglrenderer's vtest_protocol.h (MIT), the parts used here */
+#define VTEST_HDR_SIZE 2
+#define VTEST_CMD_LEN 0
+#define VTEST_CMD_ID 1
+#define VCMD_RESOURCE_BUSY_WAIT 7
+#define VCMD_CREATE_RENDERER 8
+#define VCMD_PING_PROTOCOL_VERSION 10
+#define VCMD_PROTOCOL_VERSION 11
+#define VCMD_ALLOC_DMABUF_IMAGE 40
+#define VCMD_BUSY_WAIT_SIZE 2
+#define VCMD_PING_PROTOCOL_VERSION_SIZE 0
+#define VCMD_PROTOCOL_VERSION_SIZE 1
+#define VCMD_ALLOC_DMABUF_IMAGE_FLAG_RENDER (1u << 0)
+#define VCMD_ALLOC_DMABUF_IMAGE_FLAG_TEXTURE (1u << 1)
+#define VCMD_ALLOC_DMABUF_IMAGE_FLAG_SCANOUT (1u << 2)
+#define VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS 64
+#define VCMD_ALLOC_DMABUF_IMAGE_SIZE(count) (5 + 2 * (count))
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE 7
+#define VTEST_ALLOC_PROTOCOL_VERSION 6
+
+/* Single-plane formats the server maps to a VkFormat (vtest_vk_alloc.c). */
+static const uint32_t vtest_formats[] = { DRM_FORMAT_ABGR8888,	  DRM_FORMAT_XBGR8888,
+					  DRM_FORMAT_ARGB8888,	  DRM_FORMAT_XRGB8888,
+					  DRM_FORMAT_RGB565,	  DRM_FORMAT_ABGR2101010,
+					  DRM_FORMAT_XBGR2101010, DRM_FORMAT_ABGR16161616F };
+
+static const uint32_t linear_render_formats[] = { DRM_FORMAT_BGR888 };
+
+static const uint32_t texture_only_formats[] = { DRM_FORMAT_R8, DRM_FORMAT_NV12, DRM_FORMAT_NV21,
+						 DRM_FORMAT_YVU420, DRM_FORMAT_YVU420_ANDROID };
+
+/* Buffers that never go to the server: the CPU, video, camera and sensors use them. */
+#define VTEST_LINEAR_USE                                                                           \
+	(BO_USE_LINEAR | BO_USE_SW_MASK | BO_USE_CURSOR | BO_USE_PROTECTED |                       \
+	 BO_USE_HW_VIDEO_DECODER | BO_USE_HW_VIDEO_ENCODER | BO_USE_CAMERA_READ |                  \
+	 BO_USE_CAMERA_WRITE | BO_USE_FRONT_RENDERING | BO_USE_RENDERSCRIPT |                      \
+	 BO_USE_GPU_DATA_BUFFER | BO_USE_SENSOR_DIRECT_DATA)
+
+struct vtest_modifiers {
+	uint32_t count;
+	uint64_t modifiers[VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS];
+};
+
+struct vtest_priv {
+	pthread_mutex_t lock;
+	/* per vtest_formats[] entry, for scanout buffers */
+	struct vtest_modifiers scanout[ARRAY_SIZE(vtest_formats)];
+	char socket_path[PATH_MAX];
+	int sock;
+	int udmabuf;
+	bool warned;
+};
+
+static int write_all(int sock, const void *buf, size_t size)
+{
+	const char *p = buf;
+	while (size) {
+		const ssize_t ret = write(sock, p, size);
+		if (ret < 0 && errno == EINTR)
+			continue;
+		if (ret <= 0)
+			return -EPIPE;
+		p += ret;
+		size -= ret;
+	}
+	return 0;
+}
+
+static int read_all(int sock, void *buf, size_t size)
+{
+	char *p = buf;
+	while (size) {
+		const ssize_t ret = read(sock, p, size);
+		if (ret < 0 && errno == EINTR)
+			continue;
+		if (ret <= 0)
+			return -EPIPE;
+		p += ret;
+		size -= ret;
+	}
+	return 0;
+}
+
+static int receive_fd(int sock)
+{
+	char cmsg_buf[CMSG_SPACE(sizeof(int))];
+	char dummy;
+	struct iovec iov = { .iov_base = &dummy, .iov_len = sizeof(dummy) };
+	struct msghdr msg = {
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+		.msg_control = cmsg_buf,
+		.msg_controllen = sizeof(cmsg_buf),
+	};
+	struct cmsghdr *cmsg;
+	ssize_t ret;
+	int fd;
+
+	do {
+		ret = recvmsg(sock, &msg, MSG_CMSG_CLOEXEC);
+	} while (ret < 0 && errno == EINTR);
+	if (ret <= 0)
+		return -EPIPE;
+
+	cmsg = CMSG_FIRSTHDR(&msg);
+	if (!cmsg || cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS)
+		return -EPIPE;
+
+	memcpy(&fd, CMSG_DATA(cmsg), sizeof(fd));
+	return fd;
+}
+
+/* VCMD_CREATE_RENDERER, then the version handshake Mesa's vtest backend does. */
+static int vtest_connect(const char *path)
+{
+	static const char name[] = "minigbm";
+	struct sockaddr_un un = { .sun_family = AF_UNIX };
+	uint32_t hdr[VTEST_HDR_SIZE] = { sizeof(name), VCMD_CREATE_RENDERER };
+	uint32_t busy_wait[VCMD_BUSY_WAIT_SIZE] = { 0, 0 };
+	uint32_t version = VTEST_ALLOC_PROTOCOL_VERSION, dummy;
+	bool has_ping;
+	int sock, ret;
+
+	if (strlen(path) >= sizeof(un.sun_path))
+		return -ENAMETOOLONG;
+	strcpy(un.sun_path, path);
+
+	sock = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (sock < 0)
+		return -errno;
+	if (connect(sock, (struct sockaddr *)&un, sizeof(un)) < 0) {
+		ret = -errno;
+		goto fail;
+	}
+
+	if ((ret = write_all(sock, hdr, sizeof(hdr))) || (ret = write_all(sock, name, sizeof(name))))
+		goto fail;
+
+	/* a ping, plus a busy wait so that a server without ping still answers */
+	hdr[VTEST_CMD_LEN] = VCMD_PING_PROTOCOL_VERSION_SIZE;
+	hdr[VTEST_CMD_ID] = VCMD_PING_PROTOCOL_VERSION;
+	if ((ret = write_all(sock, hdr, sizeof(hdr))))
+		goto fail;
+	hdr[VTEST_CMD_LEN] = VCMD_BUSY_WAIT_SIZE;
+	hdr[VTEST_CMD_ID] = VCMD_RESOURCE_BUSY_WAIT;
+	if ((ret = write_all(sock, hdr, sizeof(hdr))) ||
+	    (ret = write_all(sock, busy_wait, sizeof(busy_wait))) ||
+	    (ret = read_all(sock, hdr, sizeof(hdr))))
+		goto fail;
+	has_ping = hdr[VTEST_CMD_ID] == VCMD_PING_PROTOCOL_VERSION;
+	if ((has_ping && (ret = read_all(sock, hdr, sizeof(hdr)))) ||
+	    (ret = read_all(sock, &dummy, sizeof(dummy))))
+		goto fail;
+	if (!has_ping) {
+		ret = -EPROTONOSUPPORT;
+		goto fail;
+	}
+
+	hdr[VTEST_CMD_LEN] = VCMD_PROTOCOL_VERSION_SIZE;
+	hdr[VTEST_CMD_ID] = VCMD_PROTOCOL_VERSION;
+	if ((ret = write_all(sock, hdr, sizeof(hdr))) ||
+	    (ret = write_all(sock, &version, sizeof(version))) ||
+	    (ret = read_all(sock, hdr, sizeof(hdr))) ||
+	    (ret = read_all(sock, &version, sizeof(version))))
+		goto fail;
+	if (version < VTEST_ALLOC_PROTOCOL_VERSION) {
+		ret = -EPROTONOSUPPORT;
+		goto fail;
+	}
+
+	return sock;
+
+fail:
+	close(sock);
+	return ret;
+}
+
+struct vtest_image {
+	int fd;
+	uint64_t modifier;
+	uint32_t stride;
+	uint32_t offset;
+	uint64_t size;
+};
+
+static int vtest_alloc_image(int sock, uint32_t width, uint32_t height, uint32_t format,
+			     uint32_t flags, const uint64_t *modifiers, uint32_t count,
+			     struct vtest_image *out)
+{
+	uint32_t req[VCMD_ALLOC_DMABUF_IMAGE_SIZE(VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS)];
+	uint32_t resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE];
+	uint32_t hdr[VTEST_HDR_SIZE];
+	uint32_t len;
+	int ret, fd;
+
+	if (count > VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS)
+		count = VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS;
+	len = VCMD_ALLOC_DMABUF_IMAGE_SIZE(count);
+	req[0] = width;
+	req[1] = height;
+	req[2] = format;
+	req[3] = flags;
+	req[4] = count;
+	for (uint32_t i = 0; i < count; i++) {
+		req[5 + 2 * i] = (uint32_t)modifiers[i];
+		req[6 + 2 * i] = (uint32_t)(modifiers[i] >> 32);
+	}
+
+	hdr[VTEST_CMD_LEN] = len;
+	hdr[VTEST_CMD_ID] = VCMD_ALLOC_DMABUF_IMAGE;
+	if ((ret = write_all(sock, hdr, sizeof(hdr))) ||
+	    (ret = write_all(sock, req, len * sizeof(uint32_t))) ||
+	    (ret = read_all(sock, hdr, sizeof(hdr))))
+		return ret;
+	if (hdr[VTEST_CMD_ID] != VCMD_ALLOC_DMABUF_IMAGE ||
+	    hdr[VTEST_CMD_LEN] != VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE)
+		return -EPIPE;
+	if ((ret = read_all(sock, resp, sizeof(resp))))
+		return ret;
+	/* a server-side error is not a broken connection */
+	if (resp[0])
+		return resp[0] == EPIPE ? -EIO : -(int)resp[0];
+
+	fd = receive_fd(sock);
+	if (fd < 0)
+		return fd;
+
+	out->fd = fd;
+	out->modifier = resp[1] | (uint64_t)resp[2] << 32;
+	out->stride = resp[3];
+	out->offset = resp[4];
+	out->size = resp[5] | (uint64_t)resp[6] << 32;
+	return 0;
+}
+
+static int vtest_format_index(uint32_t format)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(vtest_formats); i++) {
+		if (vtest_formats[i] == format)
+			return i;
+	}
+	return -1;
+}
+
+static bool vtest_format(uint32_t format)
+{
+	return vtest_format_index(format) >= 0;
+}
+
+/*
+ * The modifiers the display can scan out, vendor.gralloc.vtest.modifiers.<fourcc hex>.<n>
+ * (hex), set by the composer side (K4) from the KMS plane's IN_FORMATS. Read again until the
+ * list is there: the props may come after the first allocation. Called with priv->lock held.
+ */
+static const struct vtest_modifiers *vtest_scanout_modifiers(struct vtest_priv *priv,
+							     uint32_t format)
+{
+	const int idx = vtest_format_index(format);
+	struct vtest_modifiers *mods;
+	char name[96];
+
+	if (idx < 0)
+		return NULL;
+	mods = &priv->scanout[idx];
+	if (mods->count)
+		return mods;
+
+	for (uint32_t i = 0; i < VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS; i++) {
+		const char *value;
+
+		snprintf(name, sizeof(name), "vendor.gralloc.vtest.modifiers.%x.%u", format, i);
+		value = drv_get_os_option(name);
+		if (!value || !value[0])
+			break;
+		mods->modifiers[i] = strtoull(value, NULL, 16);
+		mods->count = i + 1;
+	}
+	return mods;
+}
+
+static int vtest_bo_create_on_server(struct bo *bo, uint32_t width, uint32_t height,
+				     uint32_t format, uint64_t use_flags, const uint64_t *modifiers,
+				     uint32_t count)
+{
+	struct vtest_priv *priv = bo->drv->priv;
+	uint32_t flags = VCMD_ALLOC_DMABUF_IMAGE_FLAG_RENDER | VCMD_ALLOC_DMABUF_IMAGE_FLAG_TEXTURE;
+	struct vtest_image image;
+	bool warn;
+	int ret = -EPIPE;
+
+	if (use_flags & BO_USE_SCANOUT)
+		flags |= VCMD_ALLOC_DMABUF_IMAGE_FLAG_SCANOUT;
+
+	pthread_mutex_lock(&priv->lock);
+	/* a second try on a new connection when the server went away (restarted) */
+	for (int attempt = 0; attempt < 2 && ret == -EPIPE; attempt++) {
+		if (priv->sock < 0) {
+			ret = vtest_connect(priv->socket_path);
+			if (ret < 0)
+				break;
+			priv->sock = ret;
+		}
+		if (!count && (use_flags & BO_USE_SCANOUT)) {
+			const struct vtest_modifiers *mods = vtest_scanout_modifiers(priv, format);
+			if (mods) {
+				modifiers = mods->modifiers;
+				count = mods->count;
+			}
+		}
+		ret = vtest_alloc_image(priv->sock, width, height, format, flags, modifiers, count,
+					&image);
+		if (ret == -EPIPE) {
+			close(priv->sock);
+			priv->sock = -1;
+		}
+	}
+	warn = ret && !priv->warned;
+	if (ret)
+		priv->warned = true;
+	else
+		priv->warned = false;
+	pthread_mutex_unlock(&priv->lock);
+
+	if (ret) {
+		if (warn)
+			drv_loge("vtest: allocation through %s failed (%s), using linear memory\n",
+				 priv->socket_path, strerror(-ret));
+		return ret;
+	}
+
+	/* one plane at offset 0, as minigbm describes single-plane buffers */
+	if (image.offset) {
+		drv_loge("vtest: plane offset %u, using linear memory\n", image.offset);
+		close(image.fd);
+		return -EINVAL;
+	}
+
+	drv_bo_from_format(bo, image.stride, 1, height, format);
+	bo->meta.format_modifier = image.modifier;
+	bo->meta.tiling = image.modifier != DRM_FORMAT_MOD_LINEAR;
+	bo->meta.sizes[0] = image.size;
+	bo->meta.total_size = image.size;
+	bo->handle.fd = image.fd;
+	return 0;
+}
+
+/* Linear system memory: a sealed memfd turned into a dma-buf by udmabuf. */
+static int vtest_bo_create_linear(struct bo *bo, uint32_t width, uint32_t height, uint32_t format)
+{
+	struct vtest_priv *priv = bo->drv->priv;
+	uint32_t aligned_width = width, aligned_height = height, stride;
+	struct udmabuf_create create = { 0 };
+	size_t size;
+	int memfd, fd;
+
+	/* opened on the first linear buffer: only the allocator creates buffers */
+	pthread_mutex_lock(&priv->lock);
+	if (priv->udmabuf == -1) {
+		priv->udmabuf = open("/dev/udmabuf", O_RDWR | O_CLOEXEC);
+		if (priv->udmabuf < 0) {
+			drv_loge("vtest: cannot open /dev/udmabuf (%s)\n", strerror(errno));
+			priv->udmabuf = -2;
+		}
+	}
+	pthread_mutex_unlock(&priv->lock);
+	if (priv->udmabuf < 0)
+		return -ENODEV;
+
+	/* the sizes of drv_dumb_bo_create() */
+	switch (format) {
+	case DRM_FORMAT_R16:
+		aligned_width = ALIGN(width, 16);
+		break;
+	case DRM_FORMAT_YVU420_ANDROID:
+		aligned_width = ALIGN(width, 32);
+		aligned_height = 3 * DIV_ROUND_UP(height, 2);
+		break;
+	case DRM_FORMAT_YVU420:
+	case DRM_FORMAT_NV12:
+	case DRM_FORMAT_NV21:
+	case DRM_FORMAT_P010:
+		aligned_height = 3 * DIV_ROUND_UP(height, 2);
+		break;
+	default:
+		break;
+	}
+	/* 256 bytes: the pitch alignment NVIDIA's and most GPUs' linear images need */
+	stride = ALIGN(aligned_width * drv_bytes_per_pixel_from_format(format, 0), 256);
+	drv_bo_from_format(bo, stride, 1, height, format);
+	size = ALIGN(MAX(bo->meta.total_size, (size_t)stride * aligned_height), getpagesize());
+
+	memfd = memfd_create("minigbm-vtest", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+	if (memfd < 0)
+		return -errno;
+	if (ftruncate(memfd, size) || fcntl(memfd, F_ADD_SEALS, F_SEAL_SHRINK)) {
+		fd = -errno;
+		goto out;
+	}
+
+	create.memfd = memfd;
+	create.flags = UDMABUF_FLAGS_CLOEXEC;
+	create.offset = 0;
+	create.size = size;
+	fd = ioctl(priv->udmabuf, UDMABUF_CREATE, &create);
+	if (fd < 0) {
+		fd = -errno;
+		drv_loge("vtest: UDMABUF_CREATE failed (%s)\n", strerror(-fd));
+		goto out;
+	}
+
+	bo->meta.format_modifier = DRM_FORMAT_MOD_LINEAR;
+	bo->meta.tiling = 0;
+	bo->meta.total_size = size;
+	bo->handle.fd = fd;
+	fd = 0;
+out:
+	close(memfd);
+	return fd;
+}
+
+static int vtest_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+			   uint64_t use_flags)
+{
+	if (vtest_format(format) && !(use_flags & VTEST_LINEAR_USE) && height > 1 &&
+	    !vtest_bo_create_on_server(bo, width, height, format, use_flags, NULL, 0))
+		return 0;
+
+	return vtest_bo_create_linear(bo, width, height, format);
+}
+
+static int vtest_bo_create_with_modifiers(struct bo *bo, uint32_t width, uint32_t height,
+					  uint32_t format, const uint64_t *modifiers,
+					  uint32_t count)
+{
+	const bool linear = drv_has_modifier(modifiers, count, DRM_FORMAT_MOD_LINEAR);
+
+	if (vtest_format(format) &&
+	    !vtest_bo_create_on_server(bo, width, height, format, BO_USE_NONE, modifiers, count))
+		return 0;
+
+	return linear ? vtest_bo_create_linear(bo, width, height, format) : -EINVAL;
+}
+
+static int vtest_bo_destroy(struct bo *bo)
+{
+	return close(bo->handle.fd);
+}
+
+static int vtest_bo_import(struct bo *bo, struct drv_import_fd_data *data)
+{
+	/* every plane is in the same dma-buf */
+	const int fd = fcntl(data->fds[0], F_DUPFD_CLOEXEC, 0);
+
+	if (fd < 0)
+		return -errno;
+
+	bo->handle.fd = fd;
+	return 0;
+}
+
+static int vtest_bo_export(struct bo *bo, size_t plane)
+{
+	const int fd = fcntl(bo->handle.fd, F_DUPFD_CLOEXEC, 0);
+
+	return fd >= 0 ? fd : -errno;
+}
+
+/* udmabuf buffers map; a GPU buffer from the server may refuse (NVIDIA video memory). */
+static void *vtest_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
+{
+	vma->length = bo->meta.total_size;
+	return mmap(NULL, vma->length, drv_get_prot(map_flags), MAP_SHARED, bo->handle.fd, 0);
+}
+
+static int vtest_bo_sync(struct bo *bo, bool start, uint32_t map_flags)
+{
+	struct dma_buf_sync args = { 0 };
+
+	args.flags = start ? DMA_BUF_SYNC_START : DMA_BUF_SYNC_END;
+	if (map_flags & BO_MAP_READ)
+		args.flags |= DMA_BUF_SYNC_READ;
+	if (map_flags & BO_MAP_WRITE)
+		args.flags |= DMA_BUF_SYNC_WRITE;
+
+	return ioctl(bo->handle.fd, DMA_BUF_IOCTL_SYNC, &args) ? -errno : 0;
+}
+
+static int vtest_bo_invalidate(struct bo *bo, struct mapping *mapping)
+{
+	return vtest_bo_sync(bo, true, mapping->vma->map_flags);
+}
+
+static int vtest_bo_flush(struct bo *bo, struct mapping *mapping)
+{
+	return vtest_bo_sync(bo, false, mapping->vma->map_flags);
+}
+
+static int vtest_init(struct driver *drv)
+{
+	struct vtest_priv *priv;
+	const char *path;
+
+	priv = calloc(1, sizeof(*priv));
+	if (!priv)
+		return -ENOMEM;
+	pthread_mutex_init(&priv->lock, NULL);
+	priv->sock = -1;
+	priv->udmabuf = -1;
+
+	path = drv_get_os_option("ro.vendor.minigbm.vtest.socket");
+	if (!path || !path[0])
+		path = drv_get_os_option("vendor.mesa.vtest.socket.name");
+	if (!path || !path[0])
+		path = VTEST_DEFAULT_SOCKET;
+	snprintf(priv->socket_path, sizeof(priv->socket_path), "%s", path);
+	drv->priv = priv;
+
+	drv_add_combinations(drv, vtest_formats, ARRAY_SIZE(vtest_formats), &LINEAR_METADATA,
+			     BO_USE_RENDER_MASK | BO_USE_SCANOUT | BO_USE_TEXTURE_MASK |
+				 BO_USE_CURSOR);
+	drv_add_combinations(drv, linear_render_formats, ARRAY_SIZE(linear_render_formats),
+			     &LINEAR_METADATA, BO_USE_RENDER_MASK | BO_USE_TEXTURE_MASK);
+	drv_add_combinations(drv, texture_only_formats, ARRAY_SIZE(texture_only_formats),
+			     &LINEAR_METADATA, BO_USE_TEXTURE_MASK);
+
+	drv_modify_combination(drv, DRM_FORMAT_R8, &LINEAR_METADATA,
+			       BO_USE_HW_VIDEO_ENCODER | BO_USE_HW_VIDEO_DECODER |
+				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE |
+				   BO_USE_GPU_DATA_BUFFER | BO_USE_SENSOR_DIRECT_DATA);
+	drv_modify_combination(drv, DRM_FORMAT_NV12, &LINEAR_METADATA,
+			       BO_USE_HW_VIDEO_ENCODER | BO_USE_HW_VIDEO_DECODER |
+				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE);
+	drv_modify_combination(drv, DRM_FORMAT_NV21, &LINEAR_METADATA, BO_USE_HW_VIDEO_ENCODER);
+
+	return drv_modify_linear_combinations(drv);
+}
+
+static void vtest_close(struct driver *drv)
+{
+	struct vtest_priv *priv = drv->priv;
+
+	if (priv->sock >= 0)
+		close(priv->sock);
+	if (priv->udmabuf >= 0)
+		close(priv->udmabuf);
+	pthread_mutex_destroy(&priv->lock);
+	free(priv);
+	drv->priv = NULL;
+}
+
+const struct backend backend_vtest = {
+	.name = "vtest",
+	.init = vtest_init,
+	.close = vtest_close,
+	.bo_create = vtest_bo_create,
+	.bo_create_with_modifiers = vtest_bo_create_with_modifiers,
+	.bo_destroy = vtest_bo_destroy,
+	.bo_import = vtest_bo_import,
+	.bo_export = vtest_bo_export,
+	.bo_map = vtest_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.bo_invalidate = vtest_bo_invalidate,
+	.bo_flush = vtest_bo_flush,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
+};
