@@ -1336,6 +1336,43 @@ static struct dentry *create_debugfs(struct nvkm_gsp *gsp, const char *name,
 	return dent;
 }
 
+/* NV2080_CTRL_CMD_PERF_GET_CURRENT_PSTATE (ctrl2080perf.h): one NvU32, the P-state bit. */
+#define R535_GSP_CTRL_PERF_GET_CURRENT_PSTATE 0x20802068
+
+/*
+ * The "perf" debugfs entry: the P-state GSP-RM has picked (it raises the clocks under load
+ * by itself, there is no clock control in nouveau on GSP) and the raw thermal sensor
+ * register that nouveau_hwmon reads for temp1_input.
+ */
+static int
+r535_gsp_perf_show(struct seq_file *m, void *unused)
+{
+	struct nvkm_gsp *gsp = m->private;
+	u32 *ctrl, tsensor;
+
+	if (!gsp->running) {
+		seq_puts(m, "gsp not running\n");
+		return 0;
+	}
+
+	ctrl = nvkm_gsp_rm_ctrl_rd(&gsp->internal.device.subdevice,
+				   R535_GSP_CTRL_PERF_GET_CURRENT_PSTATE, sizeof(*ctrl));
+	if (IS_ERR(ctrl)) {
+		seq_printf(m, "pstate error %ld\n", PTR_ERR(ctrl));
+	} else {
+		if (*ctrl)
+			seq_printf(m, "pstate P%lu (0x%x)\n", __ffs(*ctrl), *ctrl);
+		else
+			seq_puts(m, "pstate none (0x0)\n");
+		nvkm_gsp_rm_ctrl_done(&gsp->internal.device.subdevice, ctrl);
+	}
+
+	tsensor = nvkm_rd32(gsp->subdev.device, 0x020460);
+	seq_printf(m, "tsensor 0x%08x temp %u\n", tsensor, (tsensor & 0x0001fff8) >> 8);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(r535_gsp_perf);
+
