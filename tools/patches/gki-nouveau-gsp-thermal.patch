 	.info = nouveau_info,
 };
+
+/*
+ * GPUs booted with GSP-RM have no therm subdev: GSP-RM runs the fans and thermal
+ * slowdown itself. Its core sensor is still readable at the register gp100_temp_get()
+ * uses, so report that as temp1_input (read only, no thresholds, no fan).
+ */
+static int
+nouveau_gsp_temp_get(struct nvkm_device *device)
+{
+	u32 tsensor = nvkm_rd32(device, 0x020460);
+	int temp = (tsensor & 0x0001fff8) >> 8;
+
+	/* 0xbadXXXXX: a PRI error, which has the "valid" bit set as well. */
+	if ((tsensor & 0xfff00000) == 0xbad00000 || !(tsensor & 0x20000000) || temp > 150)
+		return -ENODEV;
+	return temp;
+}
+
+static umode_t
+nouveau_gsp_is_visible(const void *data, enum hwmon_sensor_types type, u32 attr,
+		       int channel)
+{
+	return type == hwmon_temp && attr == hwmon_temp_input ? 0444 : 0;
+}
+
+static int
+nouveau_gsp_read(struct device *dev, enum hwmon_sensor_types type, u32 attr,
+		 int channel, long *val)
+{
+	struct nouveau_drm *drm = nouveau_drm(dev_get_drvdata(dev));
+	int ret;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input)
+		return -EOPNOTSUPP;
+	if (drm->dev->switch_power_state != DRM_SWITCH_POWER_ON)
+		return -EINVAL;
+
+	ret = nouveau_gsp_temp_get(nvxx_device(drm));
+	if (ret < 0)
+		return ret;
+	*val = ret * 1000;
+	return 0;
+}
+
+static const struct hwmon_channel_info * const nouveau_gsp_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT),
+	NULL
+};
+
+static const struct hwmon_ops nouveau_gsp_hwmon_ops = {
+	.is_visible = nouveau_gsp_is_visible,
+	.read = nouveau_gsp_read,
+};
+
+static const struct hwmon_chip_info nouveau_gsp_chip_info = {
+	.ops = &nouveau_gsp_hwmon_ops,
+	.info = nouveau_gsp_info,
+};
 #endif
 
