+// Waydroid: its hwcomposer writes input_event records for the Wayland seat into these FIFOs
+// (docs/waydroid-aosp17.md). A FIFO takes no evdev ioctls, so EventHub describes the device
+// itself, as upstream Waydroid's "EventHub: Add wayland inputs support" does. The nodes exist
+// only in Waydroid's container.
+enum { WL_INPUT_TOUCH, WL_INPUT_KEYBOARD, WL_INPUT_POINTER, WL_INPUT_TABLET, WL_INPUT_TOTAL };
+static const char* WL_INPUT_PIPE[WL_INPUT_TOTAL] = {
+        "/dev/input/wl_touch_events",
+        "/dev/input/wl_keyboard_events",
+        "/dev/input/wl_pointer_events",
+        "/dev/input/wl_tablet_events",
+};
+static const char* WL_INPUT_NAME[WL_INPUT_TOTAL] = {
+        "wayland_touch",
+        "wayland_keyboard",
+        "wayland_pointer",
+        "wayland_tablet",
+};
+static const char* WL_INPUT_LOCATION = "wayland";
+
+static int waydroidInputType(const std::string& devicePath) {
+    for (int type = 0; type < WL_INPUT_TOTAL; type++) {
+        if (devicePath == WL_INPUT_PIPE[type]) return type;
+    }
+    return -1;
+}
+
+// The axes of a Waydroid FIFO: positions span the window size the hwcomposer publishes.
+static input_absinfo waydroidAbsInfo(int axis) {
+    input_absinfo info{};
+    switch (axis) {
+        case ABS_X:
+        case ABS_MT_POSITION_X:
+            info.maximum = property_get_int32("waydroid.display_width", 0);
+            break;
+        case ABS_Y:
+        case ABS_MT_POSITION_Y:
+            info.maximum = property_get_int32("waydroid.display_height", 0);
+            break;
+        case ABS_MT_SLOT:
+            info.maximum = 9;
+            break;
+        case ABS_PRESSURE:
+        case ABS_MT_PRESSURE:
+            info.maximum = 255;
+            break;
+        case ABS_MT_TRACKING_ID:
+            info.maximum = 65535;
+            break;
+        case ABS_MT_TOUCH_MAJOR:
+        case ABS_MT_TOUCH_MINOR:
+            info.maximum = 15;
+            break;
+        case ABS_MT_ORIENTATION:
+            info.maximum = 1;
+            break;
+    }
+    info.resolution = 1;
+    return info;
+}
