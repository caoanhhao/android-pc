+void EventHub::setWaydroidInputClassesLocked(Device& device, int type) {
+    if (type == WL_INPUT_TOUCH) {
+        device.classes |= InputDeviceClass::TOUCH_MT;
+        device.propBitmask.set(INPUT_PROP_DIRECT, true);
+        for (int axis : {ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TOOL_TYPE, ABS_MT_TOUCH_MAJOR,
+                         ABS_MT_TOUCH_MINOR, ABS_MT_ORIENTATION, ABS_MT_TRACKING_ID,
+                         ABS_MT_PRESSURE, ABS_MT_SLOT, ABS_X, ABS_Y, ABS_PRESSURE}) {
+            device.absBitmask.set(axis, true);
+        }
+    } else if (type == WL_INPUT_KEYBOARD) {
+        device.classes |= InputDeviceClass::KEYBOARD | InputDeviceClass::ALPHAKEY |
+                InputDeviceClass::DPAD;
+        device.keyBitmask.set(BTN_MISC, true);
+        device.keyBitmask.set(KEY_OK, true);
+        device.loadKeyMapLocked();
+    } else if (type == WL_INPUT_POINTER) {
+        device.classes |= InputDeviceClass::CURSOR;
+        device.propBitmask.set(INPUT_PROP_POINTER, true);
+        device.absBitmask.set(ABS_X, true);
+        device.absBitmask.set(ABS_Y, true);
+        device.keyBitmask.set(BTN_MOUSE, true);
+        for (int axis : {REL_X, REL_Y, REL_HWHEEL, REL_WHEEL}) {
+            device.relBitmask.set(axis, true);
+        }
+    } else if (type == WL_INPUT_TABLET) {
+        device.classes |= InputDeviceClass::EXTERNAL_STYLUS | InputDeviceClass::TOUCH;
+        device.propBitmask.set(INPUT_PROP_DIRECT, true);
+        for (int key : {BTN_TOOL_PEN, BTN_TOOL_RUBBER, BTN_TOOL_BRUSH, BTN_TOOL_PENCIL,
+                        BTN_TOOL_AIRBRUSH, BTN_TOOL_FINGER, BTN_TOOL_MOUSE, BTN_TOOL_LENS,
+                        BTN_TOUCH, BTN_STYLUS, BTN_STYLUS2, BTN_STYLUS3}) {
+            device.keyBitmask.set(key, true);
+        }
+        for (int axis : {ABS_X, ABS_Y, ABS_PRESSURE, ABS_DISTANCE, ABS_TILT_X, ABS_TILT_Y}) {
+            device.absBitmask.set(axis, true);
+        }
+    }
+}
