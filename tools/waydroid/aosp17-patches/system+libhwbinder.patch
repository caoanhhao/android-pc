@@ -74,6 +74,16 @@ static size_t pad_size(size_t s) {
 #define STRICT_MODE_PENALTY_GATHER (0x40 << 16)
 
 namespace android {
+
+// android-pc: inside Waydroid's container (docs/waydroid-aosp17.md) the host kernel has no
+// SELinux, so binder cannot hand a security context to a transaction and fails those that ask
+// for one. The host bind-mounts its waydroid.prop on /vendor/waydroid.prop; that file never
+// exists on the PC.
+static bool InWaydroidContainer() {
+    static const bool waydroid = access("/vendor/waydroid.prop", F_OK) == 0;
+    return waydroid;
+}
