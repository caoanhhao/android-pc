diff --git a/libprocessgroup/setup/cgroup_map_write.cpp b/libprocessgroup/setup/cgroup_map_write.cpp
index 0b26e95..d8577da 100644
--- a/libprocessgroup/setup/cgroup_map_write.cpp
+++ b/libprocessgroup/setup/cgroup_map_write.cpp
@@ -27,7 +27,9 @@
 #include <sys/types.h>
 #include <unistd.h>
 
+#include <android-base/file.h>
 #include <android-base/logging.h>
+#include <android-base/strings.h>
 #include <processgroup/cgroup_descriptor.h>
 #include <processgroup/processgroup.h>
 #include <processgroup/setup.h>
@@ -134,9 +136,46 @@ static bool IsOptionalController(const CgroupController* controller) {
     return controller->flags() & CGROUPRC_CONTROLLER_FLAG_OPTIONAL;
 }
 
+// In Waydroid's LXC container (docs/waydroid-aosp17.md) the host has only cgroup v2, and
+// waydroid-preinit has remounted the container's cgroup2 (its own subtree, in a cgroup
+// namespace) writable at /sys/fs/cgroup.
+static bool InWaydroidContainer() {
+    static const bool waydroid = access("/vendor/waydroid.prop", F_OK) == 0;
+    return waydroid;
+}
+
+// Moves the container's processes out of its cgroup root into <root>/init: controllers
+// cannot be enabled for children of a cgroup that has processes ("no internal processes").
+static bool MoveProcessesOutOfRoot(const std::string& root) {
+    std::string pids;
+    if (!android::base::ReadFileToString(root + "/cgroup.procs", &pids)) {
+        PLOG(ERROR) << "Failed to read " << root << "/cgroup.procs";
+        return false;
+    }
+    const std::string init_cgroup = root + "/init";
+    if (!Mkdir(init_cgroup, 0, "", "")) return false;
+    for (const auto& pid : android::base::Split(pids, "\n")) {
+        if (pid.empty()) continue;
+        // A process may have exited in between.
+        if (!android::base::WriteStringToFile(pid, init_cgroup + "/cgroup.procs") &&
+            errno != ESRCH) {
+            PLOG(ERROR) << "Failed to move " << pid << " into " << init_cgroup;
+            return false;
+        }
+    }
+    return true;
+}
+
 static bool MountV2CgroupController(const CgroupDescriptor& descriptor) {
     const CgroupController* controller = descriptor.controller();
 
+    if (InWaydroidContainer()) {
+        if (!MoveProcessesOutOfRoot(controller->path())) return false;
+        return ChangeDirModeAndOwner(controller->path(), descriptor.mode(), descriptor.uid(),
+                                     descriptor.gid()) ||
+               IsOptionalController(controller);
+    }
+
     // /sys/fs/cgroup is created by cgroup2 with specific selinux permissions,
     // try to create again in case the mount point is changed
     if (!Mkdir(controller->path(), 0, "", "")) {
@@ -220,6 +259,10 @@ static bool SetupCgroup(const CgroupDescriptor& descriptor) {
         } else {
             return ActivateV2CgroupController(descriptor);
         }
+    } else if (InWaydroidContainer()) {
+        // No cgroup v1 on the host (and no mounting it from a container).
+        LOG(INFO) << "Waydroid container: no cgroup v1 controller " << controller->name();
+        return true;
     } else {
         return MountV1CgroupController(descriptor);
     }
