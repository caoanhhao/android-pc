+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// android-pc: the first stage of init inside Waydroid's LXC container
+// (docs/waydroid-aosp17.md). Waydroid starts /init (this binary, second-stage init) with no
+// argument as the container's first process: there is no ramdisk, the host already mounted
+// system.img as / and vendor.img on /vendor, made /dev a tmpfs with the binder nodes, and
+// mounted /proc, a read-only /sys and the cgroup2 hierarchy. The host has no SELinux, so the
+// selinux_setup stage is skipped too.
+
+#include "waydroid_first_stage.h"
+
+#include <fcntl.h>
+#include <grp.h>
+#include <paths.h>
+#include <spawn.h>
+#include <stdlib.h>
+#include <linux/capability.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <android-base/chrono_utils.h>
+#include <android-base/logging.h>
+#include <private/android_filesystem_config.h>
+
+#include "first_stage_init.h"
+#include "second_stage_resources.h"
+#include "util.h"
+
+namespace android {
+namespace init {
+
+static int MkdirIfMissing(const char* dir, mode_t mode) {
+    return access(dir, F_OK) == 0 ? 0 : mkdir(dir, mode);
+}
+
+static int MknodIfMissing(const char* path, mode_t mode, dev_t dev) {
+    return access(path, F_OK) == 0 ? chmod(path, mode & 07777) : mknod(path, mode, dev);
+}
+
+static int RemountOrMount(const char* source, const char* target, const char* type,
+                          unsigned long flags, const char* data) {
+    if (mount(source, target, type, MS_REMOUNT | flags, data) == 0) return 0;
+    return mount(source, target, type, flags, data);
+}
+
+int WaydroidFirstStageMain(char** argv) {
+    android::base::boot_clock::time_point start_time = android::base::boot_clock::now();
+    std::vector<std::pair<std::string, int>> errors;
+#define CHECKCALL(x) \
+    if ((x) != 0) errors.emplace_back(#x " failed", errno);
+
+    // Capabilities that reach the host kernel and that nothing in the container needs (as
+    // upstream Waydroid's init): no reboot, module loading, raw I/O or clock setting, and no
+    // regaining them through exec.
+    for (int cap : {CAP_MAC_ADMIN, CAP_MAC_OVERRIDE, CAP_SYS_TIME, CAP_SYS_MODULE,
+                    CAP_SYS_RAWIO, CAP_SYS_BOOT}) {
+        prctl(PR_CAPBSET_DROP, cap, 0, 0, 0);
+    }
+    prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
+
+    umask(0);
+    CHECKCALL(clearenv());
+    CHECKCALL(setenv("PATH", _PATH_DEFPATH, 1));
+
+    // waydroid-preinit (waydroid/android_vendor_waydroid_init): binder nodes if missing,
+    // /dev permissions, a writable cgroup2 mount, read-only /sys and /proc/sys.
+    pid_t preinit;
+    char* const preinit_argv[] = {const_cast<char*>("/system/bin/waydroid-preinit"), nullptr};
+    char* const preinit_env[] = {nullptr};
+    if (posix_spawn(&preinit, preinit_argv[0], nullptr, nullptr, preinit_argv, preinit_env) == 0) {
+        waitpid(preinit, nullptr, 0);
+    }
+
+    CHECKCALL(RemountOrMount("tmpfs", "/dev", "tmpfs", MS_NOSUID, "mode=0755"));
+    CHECKCALL(MkdirIfMissing("/dev/pts", 0755));
+    CHECKCALL(MkdirIfMissing("/dev/socket", 0755));
+    CHECKCALL(MkdirIfMissing("/dev/dm-user", 0755));
+#define MAKE_STR(x) __STRING(x)
+    // Remount only: a new proc mount would cover LXC's read-only /proc/sys and
+    // /proc/sysrq-trigger, which are the host kernel's.
+    CHECKCALL(mount("proc", "/proc", "proc", MS_REMOUNT,
+                    "hidepid=2,gid=" MAKE_STR(AID_READPROC)));
+#undef MAKE_STR
+    gid_t groups[] = {AID_READPROC};
+    CHECKCALL(setgroups(1, groups));
+
+    CHECKCALL(MknodIfMissing("/dev/kmsg", S_IFCHR | 0600, makedev(1, 11)));
+    CHECKCALL(MknodIfMissing("/dev/random", S_IFCHR | 0666, makedev(1, 8)));
+    CHECKCALL(MknodIfMissing("/dev/urandom", S_IFCHR | 0666, makedev(1, 9)));
+    CHECKCALL(MknodIfMissing("/dev/ptmx", S_IFCHR | 0666, makedev(5, 2)));
+    CHECKCALL(MknodIfMissing("/dev/null", S_IFCHR | 0666, makedev(1, 3)));
+    // APEXes are loop-mounted: apexd makes /dev/block/loopN itself (mount_before_data) but
+    // needs loop-control; ueventd's cold boot cannot run on the read-only /sys.
+    CHECKCALL(MkdirIfMissing("/dev/block", 0755));
+    CHECKCALL(MknodIfMissing("/dev/loop-control", S_IFCHR | 0660, makedev(10, 237)));
+
+    // Waydroid's composer instead of the PC's (aosp-device/waydroid): its HIDL declarations
+    // go over the empty VINTF fragment here, before init splits the bootstrap and default
+    // mount namespaces, so that hwservicemanager (default namespace) sees them too.
+    CHECKCALL(mount("/vendor/etc/waydroid/composer-hidl.xml",
+                    "/vendor/etc/vintf/manifest/waydroid.xml", nullptr, MS_BIND, nullptr));
+
+    CHECKCALL(RemountOrMount("tmpfs", "/mnt", "tmpfs", MS_NOEXEC | MS_NOSUID | MS_NODEV,
+                             "mode=0755,uid=0,gid=1000"));
+    CHECKCALL(MkdirIfMissing("/mnt/vendor", 0755));
+    CHECKCALL(MkdirIfMissing("/mnt/product", 0755));
+    CHECKCALL(mount("tmpfs", "/debug_ramdisk", "tmpfs", MS_NOEXEC | MS_NOSUID | MS_NODEV,
+                    "mode=0755,uid=0,gid=0"));
+    CHECKCALL(mount("tmpfs", kSecondStageRes, "tmpfs", MS_NOEXEC | MS_NOSUID | MS_NODEV,
+                    "mode=0755,uid=0,gid=0"));
+#undef CHECKCALL
+
+    SetStdioToDevNull(argv);
+    InitKernelLogging(argv);
+    LOG(INFO) << "init first stage started (Waydroid container)";
+    for (const auto& [error_string, error_errno] : errors) {
+        LOG(ERROR) << error_string << " " << strerror(error_errno);
+    }
+
+    setenv(kEnvFirstStageStartedAt, std::to_string(start_time.time_since_epoch().count()).c_str(),
+           1);
+
+    // No SELinux on the host: straight to the second stage.
+    const char* path = "/system/bin/init";
+    const char* args[] = {path, "second_stage", nullptr};
+    execv(path, const_cast<char**>(args));
+    PLOG(FATAL) << "execv(\"" << path << "\") failed";
+    return 1;
+}
+
+}  // namespace init
+}  // namespace android
