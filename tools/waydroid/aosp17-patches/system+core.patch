+// android-pc in Waydroid's container (docs/waydroid-aosp17.md): cold boot cannot regenerate
+// uevents there (the host's /sys is read-only, and a write would reach the host's udev), so
+// the input devices present before Waydroid started are added from /sys/class/input; the
+// device handler keeps only gamepads (IsWaydroidGamepad).
+static void WaydroidColdplugInput(DeviceHandler& devices) {
+    std::unique_ptr<DIR, decltype(&closedir)> dir(opendir("/sys/class/input"), closedir);
+    if (!dir) return;
+    while (dirent* entry = readdir(dir.get())) {
+        std::string name = entry->d_name;
+        if (!android::base::StartsWith(name, "event") && !android::base::StartsWith(name, "js")) {
+            continue;
+        }
+        std::string sys_path;
+        if (!android::base::Realpath("/sys/class/input/" + name, &sys_path)) continue;
+        std::string contents;
+        if (!android::base::ReadFileToString(sys_path + "/uevent", &contents)) continue;
+        Uevent uevent{};
+        uevent.action = "add";
+        uevent.path = sys_path.substr(strlen("/sys"));
+        uevent.subsystem = "input";
+        uevent.partition_num = -1;
+        uevent.major = -1;
+        uevent.minor = -1;
+        for (const auto& line : android::base::Split(contents, "\n")) {
+            if (android::base::StartsWith(line, "MAJOR=")) uevent.major = atoi(line.c_str() + 6);
+            if (android::base::StartsWith(line, "MINOR=")) uevent.minor = atoi(line.c_str() + 6);
+            if (android::base::StartsWith(line, "DEVNAME=")) uevent.device_name = line.substr(8);
+        }
+        devices.HandleUevent(uevent);
+    }
+}
