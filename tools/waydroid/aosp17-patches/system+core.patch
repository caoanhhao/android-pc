+// android-pc in Waydroid's container (docs/waydroid-aosp17.md): the container receives every
+// host uevent. Android gets the desktop's keyboard and mouse through the Wayland seat, so of
+// the host's input devices only gamepads and joysticks (BTN_JOYSTICK..BTN_THUMBR, as padctl's
+// virtual pads report) get nodes; anything else would type and click twice.
+static bool IsWaydroidGamepad(const std::string& sys_device_path) {
+    std::string caps;
+    if (!ReadFileToString(sys_device_path + "/device/capabilities/key", &caps)) return false;
+    // Hex words of BITS_PER_LONG bits, the most significant first.
+    std::vector<std::string> words = Split(Trim(caps), " ");
+    constexpr size_t kBits = sizeof(unsigned long) * 8;
+    for (int key = 0x120; key <= 0x13f; key++) {  // BTN_JOYSTICK .. BTN_THUMBR
+        size_t index = key / kBits;
+        if (index >= words.size()) continue;
+        unsigned long word = strtoul(words[words.size() - 1 - index].c_str(), nullptr, 16);
+        if (word & (1UL << (key % kBits))) return true;
+    }
+    return false;
+}
