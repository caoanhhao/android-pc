diff --git a/server/Controllers.cpp b/server/Controllers.cpp
index 8a2c3be..862d461 100644
--- a/server/Controllers.cpp
+++ b/server/Controllers.cpp
@@ -324,7 +324,10 @@ int Controllers::initIptablesRules() {
 void Controllers::init() {
     if (initIptablesRules()) {
         gLog.error("Failed to initialize iptables rules");
-        exit(1);
+        // android-pc in Waydroid's container (docs/waydroid-aosp17.md): the host may have no
+        // legacy iptables (nftables only); the host's side of Waydroid does the container's
+        // networking.
+        if (access("/vendor/waydroid.prop", F_OK) != 0) exit(1);
     }
     Stopwatch s;
 
@@ -335,7 +338,9 @@ void Controllers::init() {
         // As such simply exit netd.  This may crash loop the system, but by failing
         // to bootup we will trigger rollback and thus this offers us protection against
         // a mainline update breaking things.
-        exit(2);
+        // android-pc: not in Waydroid's container, whose host may have no legacy iptables
+        // (nftables only); the host's side of Waydroid does the container's networking.
+        if (access("/vendor/waydroid.prop", F_OK) != 0) exit(2);
     }
     gLog.info("Enabling bandwidth control: %" PRId64 "us", s.getTimeAndResetUs());
 
