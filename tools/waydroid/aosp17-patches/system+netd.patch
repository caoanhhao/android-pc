+// android-pc in Waydroid's container (docs/waydroid-aosp17.md): no BPF programs are loaded
+// into the host kernel, so netd runs without them.
+static bool inWaydroidContainer() {
+    static const bool waydroid = access("/vendor/waydroid.prop", F_OK) == 0;
+    return waydroid;
+}
+
 int main(const int argc, const char* argv[]) {
+    if ((argc == 2) && !strcmp(argv[1], "oneshot") && inWaydroidContainer()) {
+        ALOGI("Waydroid container: no BPF programs, nothing to set up");
+        return 0;
+    }
     if ((argc == 2) && !strcmp(argv[1], "oneshot")) {
         setenv("NETD_ONESHOT", "1", 1);
         return libnetd_updatable_init("/sys/fs/cgroup");
