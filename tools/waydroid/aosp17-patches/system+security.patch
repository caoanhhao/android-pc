+/// android-pc: in Waydroid's container (docs/waydroid-aosp17.md) the host has no SELinux, so
+/// binder hands over no calling sid; the checks then run against a placeholder context, which
+/// libselinux there allows. Elsewhere a missing sid stays an error.
+fn calling_sid_or_waydroid(calling_sid: Option<&CStr>) -> Option<&CStr> {
+    static IN_WAYDROID: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::path::Path::new("/vendor/waydroid.prop").exists());
+    calling_sid.or_else(|| if *IN_WAYDROID { Some(c"u:r:waydroid_app:s0") } else { None })
+}
