diff --git a/libselinux/src/android_pc_waydroid.h b/libselinux/src/android_pc_waydroid.h
new file mode 100644
index 0000000..89ac0f4
--- /dev/null
+++ b/libselinux/src/android_pc_waydroid.h
@@ -0,0 +1,28 @@
+/* android-pc: inside Waydroid's container (docs/waydroid-aosp17.md) the host has no SELinux;
+ * the calls that would fail there (contexts of processes, files, sockets) succeed instead,
+ * as in Waydroid's own images (waydroid-patches, external/selinux "ignore-selinux"). The host
+ * bind-mounts its generated waydroid.prop on /vendor/waydroid.prop; that file never exists on
+ * the PC, whose /vendor is a read-only, verified image, so nothing changes there. */
+#ifndef ANDROID_PC_WAYDROID_H
+#define ANDROID_PC_WAYDROID_H
+
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static inline int android_pc_in_waydroid(void)
+{
+#ifdef __ANDROID__
+	static int in_waydroid = -1;
+	if (in_waydroid < 0)
+		in_waydroid = access("/vendor/waydroid.prop", F_OK) == 0;
+	return in_waydroid;
+#else
+	return 0;
+#endif
+}
+
+#define se_hack() if (android_pc_in_waydroid()) return
+#define se_hack1(p) if (android_pc_in_waydroid()) return p
+
+#endif
