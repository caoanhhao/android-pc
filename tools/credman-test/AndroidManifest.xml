<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pc.test.credman">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />
    <application android:label="CredMan test">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".RemoteOnlyProvider" android:exported="true"
            android:label="Remote-only test provider"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>
    </application>
</manifest>
