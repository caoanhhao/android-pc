// Phase G3/G4 (docs/nvidia.md): on-device Vulkan and GLES checks for the NVK boot entry. The
// real PC has no adb, so the dEQP APK ships in the image and pcvktest.sh runs it at boot.
// (I4 removed G4's frame-rate benchmark, pcgfxbench.sh with angeles and hwuimacro.)

sh_binary {
    name: "pcvktest.sh",
    src: "pcvktest.sh",
    vendor: true,
    // pc_deqp_apk (system_ext) is in PRODUCT_PACKAGES next to this one (vktest.mk).
    required: ["init.pcvktest.rc"],
    visibility: ["//visibility:public"],
}

prebuilt_etc {
    name: "init.pcvktest.rc",
    src: "init.pcvktest.rc",
    sub_dir: "init",
    vendor: true,
}

// external/deqp's test APK (an android_test, so normally installed by tradefed into /data).
prebuilt_etc {
    name: "pc_deqp_apk",
    src: ":com.drawelements.deqp",
    filename: "com.drawelements.deqp.apk",
    sub_dir: "pcvktest",
    system_ext_specific: true,
}


// J1: chooses NVK or SwiftShader for the NVK entry at post-fs-data (init.pc.rc). A platform
// binary because it loads vulkan.nouveau from the Vulkan APEX's exported linker namespace,
// as libvulkan does (libdl_android is not available to vendor code).
cc_binary {
    name: "pcvkprobe",
    srcs: ["pcvkprobe.cpp"],
    system_ext_specific: true,
    header_libs: [
        "hwvulkan_headers",
        "libhardware_headers",
        "vulkan_headers",
    ],
    shared_libs: [
        "libbase",
        "libdl_android",
        "liblog",
    ],
    compile_multilib: "64",
}
