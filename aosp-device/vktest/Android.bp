// Phase G3 (docs/nvidia.md): on-device Vulkan checks for the nouveau boot entry. The real PC
// has no adb, so the dEQP APK ships in the image and pcvktest.sh installs and runs it at boot.

sh_binary {
    name: "pcvktest.sh",
    src: "pcvktest.sh",
    vendor: true,
    // pc_deqp_apk (system_ext) is in PRODUCT_PACKAGES next to this one (vktest.mk).
    required: ["init.pcvktest.rc"],
    visibility: ["//visibility:public"],
}

prebuilt_etc {
    name: "init.pcvktest.rc",
    src: "init.pcvktest.rc",
    sub_dir: "init",
    vendor: true,
}

// external/deqp's test APK (an android_test, so normally installed by tradefed into /data).
prebuilt_etc {
    name: "pc_deqp_apk",
    src: ":com.drawelements.deqp",
    filename: "com.drawelements.deqp.apk",
    sub_dir: "pcvktest",
    system_ext_specific: true,
}
