# /vendor/etc/ueventd.rc for gts7l (imported by /system/etc/ueventd.rc).

# Firmware requests the kernel cannot serve itself (firmware_class.path) go to ueventd, which
# looks here: the gts7l_fw tree of firmware/init.gts7l.firmware.rc first, then our own files.
firmware_directories /mnt/vendor/firmware/ /vendor/firmware/

# Backlight for the lights HAL (user system).
/sys/class/backlight/*  brightness  0664  system  system

# FastRPC to the sensor DSP (sdsp) for gts7l-sensord (user system), docs/gts7l.md §19.
/dev/fastrpc-sdsp  0660  system  system

# Cameras (CAMSS, docs/gts7l-hal/camera.md): the capture nodes, the media controller and the
# sensor sub-devices for the camera HAL (user cameraserver, group camera).
/dev/video*        0660  system  camera
/dev/media*        0660  system  camera
/dev/v4l-subdev*   0660  system  camera

# Input devices: touchscreen, S Pen, Book Cover keyboard and touchpad (core ueventd.rc covers
# /dev/input). DRM card and render node: core ueventd.rc. TODO(T4): vibrator (input force
# feedback), audio.

# SM8250 video codec (qcom-iris): V4L2 decoder/encoder nodes for the Codec2 HAL
# (media/, user mediacodec in group camera).
/dev/video*  0660  system  camera
/dev/media*  0660  system  camera
