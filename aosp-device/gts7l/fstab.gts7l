# fstab for gts7l (SM-T875). In the boot ramdisk for first-stage mount and in /vendor/etc for
# init.gts7l.rc's mount_all. Partition names are the stock UFS layout (by-name links from
# androidboot.boot_devices). TODO(S1): check every name and the userdata file system against
# the stock layout (docs/gts7l-inventory.md).
#
# Logical partitions in super, read-only, ext4 (no AVB: verification is off, BoardConfig.mk).
#<src>      <mnt_point>  <type> <mnt_flags>   <fs_mgr_flags>
system      /system      ext4   ro,barrier=1  wait,logical,first_stage_mount
system_ext  /system_ext  ext4   ro,barrier=1  wait,logical,first_stage_mount
product     /product     ext4   ro,barrier=1  wait,logical,first_stage_mount
vendor      /vendor      ext4   ro,barrier=1  wait,logical,first_stage_mount

/dev/block/by-name/metadata  /metadata  ext4  noatime,nosuid,nodev,discard  wait,check,formattable,first_stage_mount

# userdata: no fileencryption flag, /data starts unencrypted (no TrustZone keymaster on
# mainline, docs/gts7l.md §7). f2fs first (stock), ext4 if TWRP formatted it so.
/dev/block/by-name/userdata  /data  f2fs  noatime,nosuid,nodev,discard,fsync_mode=nobarrier  latemount,wait,check,formattable,quota,reservedsize=128M
/dev/block/by-name/userdata  /data  ext4  noatime,nosuid,nodev,discard                       latemount,wait,check,formattable,quota,reservedsize=128M

# Co-processor firmware on the tablet's own partitions, read-only (docs/gts7l.md §3).
/dev/block/by-name/apnhlos  /mnt/vendor/apnhlos  vfat  ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/by-name/modem    /mnt/vendor/modem    vfat  ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
# The kernel's firmware tree (firmware/init.gts7l.firmware.rc, docs/gts7l.md §13): files of the
# stock vendor and links into apnhlos, made from the tablet's data by tools/gts7l-firmware.sh.
# nofail: a super packed without it still boots, with no GPU/Wi-Fi/BT/DSP firmware.
gts7l_fw    /mnt/vendor/firmware  ext4  ro,nosuid,nodev,noexec,context=u:object_r:firmware_file:s0  wait,logical,nofail

# Calibration and identity (IMEI, Bluetooth address, sensor and audio calibration): mounted
# read-only until their backups exist (docs/gts7l.md §6/T1, §7) and a HAL needs to write.
/dev/block/by-name/efs      /mnt/vendor/efs      ext4  ro,nosuid,nodev,noatime,context=u:object_r:vendor_efs_file:s0  wait,nofail
/dev/block/by-name/sec_efs  /mnt/vendor/sec_efs  ext4  ro,nosuid,nodev,noatime,context=u:object_r:vendor_efs_file:s0  wait,nofail
/dev/block/by-name/persist  /mnt/vendor/persist  ext4  ro,nosuid,nodev,noatime,context=u:object_r:vendor_efs_file:s0  wait,nofail
