<?xml version="1.0" encoding="utf-8"?>
<!-- What Google's google.xml gives a preinstalled GmsCore and Play Store, for the user-installed
     microG and Play Store: they keep network access in Doze and Data Saver, and their
     systemExempted foreground services may start (Play's DownloadService crashes without it).
     The user allowlist tools/gts7l-google-apps.sh sets is lost when Play reinstalls itself. -->
<config>
    <allow-in-power-save package="com.google.android.gms"/>
    <allow-in-data-usage-save package="com.google.android.gms"/>
    <allow-in-power-save-except-idle package="com.android.vending"/>
</config>
