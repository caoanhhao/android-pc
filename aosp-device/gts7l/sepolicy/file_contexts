# Block devices of the stock UFS layout (by-name links from androidboot.boot_devices).
/dev/block/by-name/super       u:object_r:super_block_device:s0
/dev/block/by-name/userdata    u:object_r:userdata_block_device:s0
/dev/block/by-name/metadata    u:object_r:metadata_block_device:s0
/dev/block/by-name/misc        u:object_r:misc_block_device:s0
/dev/block/by-name/apnhlos     u:object_r:gts7l_firmware_block_device:s0
/dev/block/by-name/modem       u:object_r:gts7l_firmware_block_device:s0
/dev/block/by-name/efs         u:object_r:gts7l_efs_block_device:s0
/dev/block/by-name/sec_efs     u:object_r:gts7l_efs_block_device:s0
/dev/block/by-name/persist     u:object_r:gts7l_efs_block_device:s0


# GPU and display: the msm DRM device (KMS + Adreno) and its render node.
/dev/dri                       u:object_r:gpu_device:s0
/dev/dri/card[0-9]+            u:object_r:graphics_device:s0
/dev/dri/renderD12[0-9]        u:object_r:gpu_device:s0

# Mesa (tools/gts7l-mesa.sh) and the gralloc libraries it loads run in app processes.
/vendor/lib(64)?/egl(/.*)?                     u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libgallium_dri\.so            u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/vulkan\.freedreno\.so      u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/gralloc\.minigbm\.so       u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/mapper\.minigbm\.so        u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libminigbm_gralloc\.so        u:object_r:same_process_hal_file:s0

# USB without the screen (init.gts7l.usb.rc).
/vendor/bin/usbroute           u:object_r:gts7l_usb_exec:s0
/vendor/bin/gts7l-usb\.sh      u:object_r:gts7l_usb_exec:s0
