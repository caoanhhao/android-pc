# Board init for gts7l (SM-T875, docs/gts7l.md). In /vendor/etc/init, so init reads it whatever
# androidboot.hardware ABL passes.

on fs
    mkdir /mnt/vendor/apnhlos 0755 root root
    mkdir /mnt/vendor/modem 0755 root root
    mkdir /mnt/vendor/efs 0755 root root
    mkdir /mnt/vendor/sec_efs 0755 root root
    mkdir /mnt/vendor/persist 0755 root root
    mount_all /vendor/etc/fstab.gts7l --early
    # Kernel modules of tools/gts7l-kernel.sh that are not built in (modules.load order). Only
    # now: remoteproc, ath11k, cs35l41 and btqca request their firmware at probe, and it is
    # reachable once the mount_all above has mounted gts7l_fw and apnhlos.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules --all=/vendor/lib/modules/modules.load

on late-fs
    mount_all /vendor/etc/fstab.gts7l --late

on post-fs-data
    # wpa_supplicant (-O) and hostapd sockets; the APEX's hostapd.rc makes only its own dirs.
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

on boot
    # Scudo serves allocations its primary regions cannot hold with one mapping plus guard pages
    # each. Where Winds Meet keeps ~800 MB of 32 KiB blocks and hit the default limit of 65530
    # mappings (malloc and Mesa's mmap failed, the game aborted while loading).
    write /proc/sys/vm/max_map_count 1048576
    # Stock swaps to zram eagerly (init.gts7l.rc, SSWAP).
    write /proc/sys/vm/swappiness 130
    # schedutil on every cpufreq policy (Kryo 585: cpu0-3 A55, cpu4-6 A77, cpu7 A77 prime).
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
    # The power HAL (user system, hals/power freq.rs) moves each policy's floor and cap for
    # Android's boosts and modes.
    chown root system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq

# Bluetooth HAL (hals/bluetooth) on the QCA6390 (hci_uart, docs/gts7l.md §20). The kernel holds
# the controller unconfigured (its NVM has the default address), so the HAL gives it Samsung's
# address from efs, else one derived from the serial number. Not hals/bluetooth's own
# vendor.bluetooth-pc service, which init.pc.rc starts on the PC without these arguments.
service vendor.bluetooth-gts7l /vendor/bin/hw/android.hardware.bluetooth-service.pc --bdaddr-file /mnt/vendor/efs/bluetooth/bt_addr --bdaddr-seed ${ro.serialno}
    class hal
    capabilities BLOCK_SUSPEND NET_ADMIN SYS_NICE
    user bluetooth
    group bluetooth net_admin net_bt_admin
    task_profiles HighPerformance

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.gts7l
