From d1a2f3856bcadcffbfff57b0d38dfc794db713bd Mon Sep 17 00:00:00 2001
From: caoanhhao <caoanhhao2@gmail.com>
Date: Sat, 28 Nov 2026 10:26:56 +0700
Subject: [PATCH] soc: qcom: rpmh: dump the controller state when a request
 times out

An AMC request that never completes only leaves "Error sending AMC RPMH
requests (-110)" behind, which cannot tell an RPMh that stopped answering
from a done interrupt that was raised but never handled. Log the DRV's
IRQ_STATUS/IRQ_ENABLE, the GIC pending/active state of its interrupt, how
many interrupts each CPU took, every TCS's control/status and first
command, and ask all CPUs for a backtrace.

Seen on the Galaxy Tab S7 LTE (sm8250) just before it reset under a
sustained CPU+GPU load, with ath11k WMI timeouts in the same seconds.
---
 drivers/soc/qcom/rpmh-internal.h |  2 ++
 drivers/soc/qcom/rpmh-rsc.c      | 39 ++++++++++++++++++++++++++++++++
 drivers/soc/qcom/rpmh.c          |  4 +++-
 3 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/qcom/rpmh-internal.h b/drivers/soc/qcom/rpmh-internal.h
index e3cf1beff..efed3ea44 100644
--- a/drivers/soc/qcom/rpmh-internal.h
+++ b/drivers/soc/qcom/rpmh-internal.h
@@ -134,6 +134,7 @@ struct rsc_drv {
 	struct device *dev;
 	struct rsc_ver ver;
 	u32 *regs;
+	int irq;
 };
 
 int rpmh_rsc_send_data(struct rsc_drv *drv, const struct tcs_request *msg);
@@ -141,6 +142,7 @@ int rpmh_rsc_write_ctrl_data(struct rsc_drv *drv,
 			     const struct tcs_request *msg);
 void rpmh_rsc_invalidate(struct rsc_drv *drv);
 void rpmh_rsc_write_next_wakeup(struct rsc_drv *drv);
+void rpmh_rsc_dump(struct rsc_drv *drv);
 
 void rpmh_tx_done(const struct tcs_request *msg);
 int rpmh_flush(struct rpmh_ctrlr *ctrlr);
diff --git a/drivers/soc/qcom/rpmh-rsc.c b/drivers/soc/qcom/rpmh-rsc.c
index f881af35e..6fdcee7d8 100644
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -13,9 +13,11 @@
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
+#include <linux/kernel_stat.h>
 #include <linux/ktime.h>
 #include <linux/list.h>
 #include <linux/module.h>
+#include <linux/nmi.h>
 #include <linux/notifier.h>
 #include <linux/of.h>
 #include <linux/of_irq.h>
@@ -485,6 +487,42 @@ static irqreturn_t tcs_tx_done(int irq, void *p)
 	return IRQ_HANDLED;
 }
 
+/**
+ * rpmh_rsc_dump() - Log the controller state after a request timed out.
+ * @drv: The controller.
+ *
+ * Tells a TCS the RPMh never completed (no IRQ_STATUS bit) from a completion
+ * whose interrupt was raised but never handled (IRQ_STATUS bit set, interrupt
+ * pending at the GIC), and shows which CPU still takes the interrupt.
+ */
+void rpmh_rsc_dump(struct rsc_drv *drv)
+{
+	bool pending = false, active = false;
+	unsigned int cpu;
+	int i;
+
+	irq_get_irqchip_state(drv->irq, IRQCHIP_STATE_PENDING, &pending);
+	irq_get_irqchip_state(drv->irq, IRQCHIP_STATE_ACTIVE, &active);
+	pr_err("%s: irq %d pending=%d active=%d irq_enable=%#x irq_status=%#x in_use=%*pb\n",
+	       drv->name, drv->irq, pending, active,
+	       readl_relaxed(drv->tcs_base + drv->regs[RSC_DRV_IRQ_ENABLE]),
+	       readl_relaxed(drv->tcs_base + drv->regs[RSC_DRV_IRQ_STATUS]),
+	       drv->num_tcs, drv->tcs_in_use);
+	for_each_online_cpu(cpu)
+		pr_err("%s: cpu%u handled %u\n", drv->name, cpu,
+		       kstat_irqs_cpu(drv->irq, cpu));
+	for (i = 0; i < drv->num_tcs; i++)
+		pr_err("%s: tcs%d control=%#x status=%#x cmd_enable=%#x cmd0_status=%#x addr=%#x data=%#x\n",
+		       drv->name, i,
+		       read_tcs_reg(drv, drv->regs[RSC_DRV_CONTROL], i),
+		       read_tcs_reg(drv, drv->regs[RSC_DRV_STATUS], i),
+		       read_tcs_reg(drv, drv->regs[RSC_DRV_CMD_ENABLE], i),
+		       read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_STATUS], i, 0),
+		       read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_ADDR], i, 0),
+		       read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_DATA], i, 0));
+	trigger_all_cpu_backtrace();
+}
+
 /**
  * __tcs_buffer_write() - Write to TCS hardware from a request; don't trigger.
  * @drv:    The controller.
@@ -1108,6 +1146,7 @@ static int rpmh_rsc_probe(struct platform_device *pdev)
 	if (irq < 0)
 		return irq;
 
+	drv->irq = irq;
 	ret = devm_request_irq(&pdev->dev, irq, tcs_tx_done,
 			       IRQF_TRIGGER_HIGH | IRQF_NO_SUSPEND,
 			       drv->name, drv);
diff --git a/drivers/soc/qcom/rpmh.c b/drivers/soc/qcom/rpmh.c
index f881c4c75..0c324c20a 100644
--- a/drivers/soc/qcom/rpmh.c
+++ b/drivers/soc/qcom/rpmh.c
@@ -305,7 +305,8 @@ int rpmh_write(const struct device *dev, enum rpmh_state state,
 		return ret;
 
 	ret = wait_for_completion_timeout(&compl, RPMH_TIMEOUT_MS);
-	WARN_ON(!ret);
+	if (WARN_ON(!ret))
+		rpmh_rsc_dump(ctrlr_to_drv(get_rpmh_ctrlr(dev)));
 	return (ret > 0) ? 0 : -ETIMEDOUT;
 }
 EXPORT_SYMBOL_GPL(rpmh_write);
@@ -423,6 +424,7 @@ int rpmh_write_batch(const struct device *dev, enum rpmh_state state,
 			 * we've returned from this function.
 			 */
 			WARN_ON(1);
+			rpmh_rsc_dump(ctrlr_to_drv(ctrlr));
 			ret = -ETIMEDOUT;
 			goto exit;
 		}
-- 
2.56.1

