From b4939cc7331d14d7bb47b59905b3bf38030446f8 Mon Sep 17 00:00:00 2001
From: caoanhhao <dev@skyperry.com>
Date: Tue, 24 Nov 2026 06:46:52 +0700
Subject: [PATCH 103/104] drm/panel: nt36523: send the backlight to both DSI
 links

With bonded DSI hosts that run synchronised (qcom,sync-dual-dsi), msm only
queues a command sent to DSI0 and transmits it when the same command is sent
to DSI1. The backlight used DSI0 alone, so its brightness never reached the
panel: on the Galaxy Tab S7 LTE (gts7l) the stock init sequence sets the
brightness to 0 and the panel stayed dark after a reset.

Send the brightness to every link, as the init sequence does, and read it
back from the first link that answers (the gts7l panel answers reads on
DSI1 only).

caoanhhao used AI to code
---
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 51 +++++++++++--------
 1 file changed, 31 insertions(+), 20 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
index cb9c0625b..028ccb5a7 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -1606,38 +1606,48 @@ static const struct drm_panel_funcs nt36523_panel_funcs = {
 	.get_orientation = nt36523_get_orientation,
 };
 
+/*
+ * Bonded DSI hosts may run synchronised: a command sent to the first link is only
+ * queued, and the transfer on the second link triggers both. Send the brightness
+ * to every link, like the init sequence, so it reaches the panel either way.
+ */
 static int nt36523_bl_update_status(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = bl_get_data(bl);
 	u16 brightness = backlight_get_brightness(bl);
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	int i, ret;
 
-	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
+	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_device *dsi = pinfo->dsi[i];
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		if (ret < 0)
+			return ret;
+	}
 
 	return 0;
 }
 
+/* Some dual-link panels answer reads on one link only: use the first that does */
 static int nt36523_bl_get_brightness(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = bl_get_data(bl);
 	u16 brightness;
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	int i, ret = -EIO;
 
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
+	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_device *dsi = pinfo->dsi[i];
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		if (!ret)
+			return brightness;
+	}
 
-	return brightness;
+	return ret;
 }
 
 static const struct backlight_ops nt36523_bl_ops = {
@@ -1646,8 +1656,9 @@ static const struct backlight_ops nt36523_bl_ops = {
 };
 
 static struct backlight_device *nt36523_create_backlight(struct mipi_dsi_device *dsi,
-							 const struct panel_desc *desc)
+							 struct panel_info *pinfo)
 {
+	const struct panel_desc *desc = pinfo->desc;
 	struct device *dev = &dsi->dev;
 	unsigned int max = desc->max_brightness ?: 4095;
 	const struct backlight_properties props = {
@@ -1657,7 +1668,7 @@ static struct backlight_device *nt36523_create_backlight(struct mipi_dsi_device
 		.scale = BACKLIGHT_SCALE_NON_LINEAR,
 	};
 
-	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+	return devm_backlight_device_register(dev, dev_name(dev), dev, pinfo,
 					      &nt36523_bl_ops, &props);
 }
 
@@ -1723,7 +1734,7 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 	pinfo->panel.prepare_prev_first = true;
 
 	if (pinfo->desc->has_dcs_backlight) {
-		pinfo->panel.backlight = nt36523_create_backlight(dsi, pinfo->desc);
+		pinfo->panel.backlight = nt36523_create_backlight(dsi, pinfo);
 		if (IS_ERR(pinfo->panel.backlight))
 			return dev_err_probe(dev, PTR_ERR(pinfo->panel.backlight),
 					     "Failed to create backlight\n");
-- 
