From 0ff84422cc238265e9745ecb4730fcef926772c9 Mon Sep 17 00:00:00 2001
From: caoanhhao <dev@skyperry.com>
Date: Tue, 24 Nov 2026 00:13:59 +0700
Subject: [PATCH 102/102] DEBUG drm/msm/dsi, nt36523: C-PHY timing override,
 video flag and DCS read switches

Module parameters for gts7l bring-up (kernel #8):
- msm.cphy_timing: the 14 bytes of the stock qcom,mdss-dsi-panel-phy-timings
  for the C-PHY TIMING_CTRL registers (bytes 12/13 go to the host's
  CLKOUT_TIMING_CTRL); empty keeps the computed values
- msm.dbg_flags_set / dbg_flags_clear: MIPI_DSI_MODE_* bits forced in
  dsi_ctrl_enable()
- panel_novatek_nt36523.dcs_read: read a DCS register over each link

caoanhhao used AI to code
---
 drivers/gpu/drm/msm/dsi/dsi_host.c            |  9 ++++++
 drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c     | 30 +++++++++++++++++++
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 28 +++++++++++++++++
 3 files changed, 67 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 2c13b3318..8075d29e5 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -817,6 +817,12 @@ bool msm_dsi_host_is_wide_bus_enabled(struct mipi_dsi_host *host)
 					MSM_DSI_6G_VER_MINOR_V2_5_0);
 }
 
+/* DEBUG (gts7l bring-up): MIPI_DSI_MODE_* bits forced on/off in dsi_ctrl_enable() */
+static uint dbg_flags_set;
+module_param(dbg_flags_set, uint, 0644);
+static uint dbg_flags_clear;
+module_param(dbg_flags_clear, uint, 0644);
+
 static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 			struct msm_dsi_phy_shared_timings *phy_shared_timings, struct msm_dsi_phy *phy)
 {
@@ -825,6 +831,9 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
 	u32 data = 0, lane_ctrl = 0;
 
+	flags = (flags | dbg_flags_set) & ~dbg_flags_clear;
+	pr_info("dsi%d: ctrl enable, mode flags %#x\n", msm_host->id, flags);
+
 	if (flags & MIPI_DSI_MODE_VIDEO) {
 		if (flags & MIPI_DSI_MODE_VIDEO_HSE)
 			data |= DSI_VID_CFG0_PULSE_MODE_HSA_HE;
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
index 2523b439f..1d8c67ec1 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
@@ -33,6 +33,14 @@ struct dsi_phy_7nm_tuning_cfg {
 	s32 rescode_mid;
 };
 
+/*
+ * DEBUG (gts7l bring-up): C-PHY timing override, the 14 bytes of
+ * qcom,mdss-dsi-panel-phy-timings (TIMING_CTRL_0..13); empty keeps the computed values.
+ */
+static int cphy_timing[14];
+static int cphy_timing_n;
+module_param_array(cphy_timing, int, &cphy_timing_n, 0644);
+
 /*
  * DSI PLL 7nm - clock diagram (eg: DSI0): TODO: updated CPHY diagram
  *
@@ -1008,6 +1016,21 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 		return -EINVAL;
 	}
 
+	DRM_DEV_INFO(&phy->pdev->dev, "timing calc: hs_exit %u clk_pre %u clk_prepare %u clk_post %u hs_rqst %u\n",
+		     timing->hs_exit, timing->shared_timings.clk_pre, timing->clk_prepare,
+		     timing->shared_timings.clk_post, timing->hs_rqst);
+	if (phy->cphy_mode && cphy_timing_n == 14) {
+		/* the host's CLKOUT_TIMING_CTRL gets bytes 12/13, as downstream */
+		timing->shared_timings.clk_pre = cphy_timing[12];
+		timing->shared_timings.clk_post = cphy_timing[13];
+		timing->shared_timings.clk_pre_inc_by_2 = false;
+		DRM_DEV_INFO(&phy->pdev->dev, "timing override: %*ph\n", 14, (u8 []){
+			cphy_timing[0], cphy_timing[1], cphy_timing[2], cphy_timing[3],
+			cphy_timing[4], cphy_timing[5], cphy_timing[6], cphy_timing[7],
+			cphy_timing[8], cphy_timing[9], cphy_timing[10], cphy_timing[11],
+			cphy_timing[12], cphy_timing[13] });
+	}
+
 	if (dsi_phy_hw_v4_0_is_pll_on(phy))
 		pr_warn("PLL turned on before configuring PHY\n");
 
@@ -1202,6 +1225,13 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 		writel(0x02, base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_9);
 		writel(0x04, base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_10);
 		writel(0x00, base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_11);
+		if (cphy_timing_n == 14) {
+			int i;
+
+			writel(cphy_timing[0], base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_0);
+			for (i = 4; i <= 11; i++)
+				writel(cphy_timing[i], base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_0 + 4 * i);
+		}
 	} else {
 		writel(0x00, base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_0);
 		writel(timing->clk_zero, base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_1);
diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
index 161a49f39..cb9c0625b 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -80,6 +80,33 @@ static inline struct panel_info *to_panel_info(struct drm_panel *panel)
 	return container_of(panel, struct panel_info, panel);
 }
 
+/*
+ * DEBUG (gts7l bring-up): "echo REG[,LEN] > .../parameters/dcs_read" reads a DCS register
+ * from the panel over each DSI link and logs it (0x05: DSI error count, 0x0a: power mode).
+ */
+static struct panel_info *dbg_pinfo;
+
+static int dcs_read_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int reg, len = 1;
+	u8 buf[16];
+	int i, ret;
+
+	if (sscanf(val, "%i,%u", &reg, &len) < 1 || reg > 0xff || !len || len > sizeof(buf))
+		return -EINVAL;
+	if (!dbg_pinfo)
+		return -ENODEV;
+	for (i = 0; i < DSI_NUM_MIN + dbg_pinfo->desc->is_dual_dsi; i++) {
+		memset(buf, 0, sizeof(buf));
+		ret = mipi_dsi_dcs_read(dbg_pinfo->dsi[i], reg, buf, len);
+		pr_info("nt36523: dsi%d dcs read %#04x: ret %d %*ph\n", i, reg, ret, len, buf);
+	}
+	return 0;
+}
+
+static const struct kernel_param_ops dcs_read_ops = { .set = dcs_read_set };
+module_param_cb(dcs_read, &dcs_read_ops, NULL, 0200);
+
 static int elish_boe_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
@@ -1685,6 +1712,7 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 
 	pinfo->dsi[0] = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
+	dbg_pinfo = pinfo;
 
 	ret = drm_of_get_panel_orientation(dev->of_node, &pinfo->orientation);
 	if (ret < 0) {
-- 
