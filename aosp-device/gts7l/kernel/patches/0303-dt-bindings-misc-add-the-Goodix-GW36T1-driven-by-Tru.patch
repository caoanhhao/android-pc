From afa698eb825d69ef0804e101f62a9ebd34e44c3f Mon Sep 17 00:00:00 2001
From: caoanhhao <caoanhhao@users.noreply.github.com>
Date: Fri, 27 Nov 2026 13:17:23 +0700
Subject: [PATCH] dt-bindings: misc: add the Goodix GW36T1 driven by TrustZone

The fingerprint sensor in the power key of the Galaxy Tab S7 LTE sits on
an SPI bus owned by the secure world. The OS side is a supply enable,
reset, interrupt, and the bus clocks/interconnect votes the secure world
needs while it drives the bus.

caoanhhao used AI to code
---
 .../bindings/misc/goodix,gw36t1.yaml          | 78 +++++++++++++++++++
 1 file changed, 78 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/misc/goodix,gw36t1.yaml

diff --git a/Documentation/devicetree/bindings/misc/goodix,gw36t1.yaml b/Documentation/devicetree/bindings/misc/goodix,gw36t1.yaml
new file mode 100644
index 000000000..374d421a4
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/goodix,gw36t1.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/goodix,gw36t1.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Goodix fingerprint sensor driven by TrustZone
+
+maintainers:
+  - caoanhhao <dev@skyperry.com>
+
+description:
+  A Goodix fingerprint sensor on an SPI bus that belongs to the secure world,
+  e.g. the GW36T1 in the power key of the Samsung Galaxy Tab S7 LTE. The secure
+  world's fingerprint app reads the sensor over SPI; the operating system only
+  switches its supply and reset, votes the bus clocks and interconnect paths
+  the secure world needs while it drives the bus, and handles its interrupt.
+  The node is therefore not a child of the SPI controller.
+
+properties:
+  compatible:
+    const: goodix,gw36t1
+
+  power-gpios:
+    maxItems: 1
+    description: Enable of the sensor's supply (LDO).
+
+  reset-gpios:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    description: The SPI serial engine clock first, then the clocks of its
+      QUP wrapper.
+    minItems: 1
+    maxItems: 3
+
+  interconnects:
+    maxItems: 2
+
+  interconnect-names:
+    items:
+      - const: qup-core
+      - const: qup-config
+
+  pinctrl-0: true
+  pinctrl-1: true
+
+  pinctrl-names:
+    items:
+      - const: default
+      - const: active
+
+  goodix,orient:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Sensor orientation, reported to the HAL as is.
+
+required:
+  - compatible
+  - power-gpios
+  - reset-gpios
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    fingerprint {
+        compatible = "goodix,gw36t1";
+        power-gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;
+        reset-gpios = <&tlmm 127 GPIO_ACTIVE_LOW>;
+        interrupts-extended = <&tlmm 63 IRQ_TYPE_EDGE_RISING>;
+    };
-- 
