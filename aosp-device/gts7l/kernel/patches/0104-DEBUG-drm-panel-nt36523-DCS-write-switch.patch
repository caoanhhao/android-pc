From 56ac50448a50bd53e278d2594c82e44b8932b894 Mon Sep 17 00:00:00 2001
From: caoanhhao <dev@skyperry.com>
Date: Tue, 24 Nov 2026 06:46:52 +0700
Subject: [PATCH 104/104] DEBUG drm/panel: nt36523: DCS write switch

panel_novatek_nt36523.dcs_write: MODE,B0,B1,... sends a DCS write; MODE bit 0
low power, bit 1 DSI0 only, bit 2 DSI1 only. For gts7l bring-up.

caoanhhao used AI to code
---
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
index 028ccb5a7..0dc19b278 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -107,6 +107,60 @@ static int dcs_read_set(const char *val, const struct kernel_param *kp)
 static const struct kernel_param_ops dcs_read_ops = { .set = dcs_read_set };
 module_param_cb(dcs_read, &dcs_read_ops, NULL, 0200);
 
+/*
+ * DEBUG (gts7l bring-up): "echo MODE,B0,B1,... > .../parameters/dcs_write" sends a DCS
+ * write; MODE bit 0: low power, bit 1: DSI0 only, bit 2: DSI1 only.
+ */
+static int dcs_write_set(const char *val, const struct kernel_param *kp)
+{
+	char *buf, *p, *tok;
+	unsigned int mode, b;
+	u8 data[16];
+	int n = 0, i, ret = 0;
+
+	if (!dbg_pinfo)
+		return -ENODEV;
+	buf = kstrdup(val, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	p = strim(buf);
+	tok = strsep(&p, ",");
+	if (!tok || kstrtouint(tok, 0, &mode))
+		goto inval;
+	while ((tok = strsep(&p, ",")) && n < sizeof(data)) {
+		if (kstrtouint(tok, 0, &b) || b > 0xff)
+			goto inval;
+		data[n++] = b;
+	}
+	kfree(buf);
+	if (!n)
+		return -EINVAL;
+	for (i = 0; i < DSI_NUM_MIN + dbg_pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_device *dsi = dbg_pinfo->dsi[i];
+		unsigned long flags = dsi->mode_flags;
+
+		if ((mode & 2) && i != 0)
+			continue;
+		if ((mode & 4) && i != 1)
+			continue;
+		if (mode & 1)
+			dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		else
+			dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		ret = mipi_dsi_dcs_write_buffer(dsi, data, n);
+		dsi->mode_flags = flags;
+		pr_info("nt36523: dsi%d dcs write %s %*ph: ret %d\n", i, mode & 1 ? "lp" : "hs",
+			n, data, ret);
+	}
+	return 0;
+inval:
+	kfree(buf);
+	return -EINVAL;
+}
+
+static const struct kernel_param_ops dcs_write_ops = { .set = dcs_write_set };
+module_param_cb(dcs_write, &dcs_write_ops, NULL, 0200);
+
 static int elish_boe_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
