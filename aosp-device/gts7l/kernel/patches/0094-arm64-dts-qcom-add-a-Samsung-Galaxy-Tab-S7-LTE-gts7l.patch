From 1e4e528e2d1c31a391c7875cc32c1288f916f61a Mon Sep 17 00:00:00 2001
From: caoanhhao <caoanhhao@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:07:52 +0700
Subject: [PATCH] arm64: dts: qcom: add a Samsung Galaxy Tab S7 LTE (gts7l)
 stub

Board file for the SM-T875, derived from sm8250-samsung-gts7xlwifi.dts (the
Tab S7+ Wi-Fi, same SM8250 board family), with what the stock gts7l device
tree (dtbo entry for board revision 7) gives so far: board id <8 7>, the
Novatek NT36523 CSOT panel (1600x2560, dual DSI, C-PHY, wired like the Xiaomi
Pad 5 Pro), its 1.8 V and bias-buck enable GPIOs, the Novatek touch controller
at 0x62, and the panel size.

Panel, DSI hosts and touch stay disabled until there are drivers for them
(mainline's nt36523 panel driver and novatek-nvt-ts have no entry for these
parts); the bootloader's simple-framebuffer is the display meanwhile. TODO
markers name what is left: panel/touch drivers, DSI supplies, regulators,
speaker amp GPIOs, the X55 LTE modem and the battery limits.

caoanhhao used AI to code
---
 arch/arm64/boot/dts/qcom/Makefile             |    1 +
 .../boot/dts/qcom/sm8250-samsung-gts7l.dts    | 1779 +++++++++++++++++
 2 files changed, 1780 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 92f3a645c..f0bdabf0e 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -364,6 +364,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-sony-xperia-kumano-bahamut.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-sony-xperia-kumano-griffin.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-mtp.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7l.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7xlwifi.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-r8q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-x1q.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts
new file mode 100644
index 000000000..0d11c9629
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts
@@ -0,0 +1,1779 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Galaxy Tab S7 LTE (SM-T875, gts7l).
+ *
+ * Stub derived from sm8250-samsung-gts7xlwifi.dts (Tab S7+ Wi-Fi, same SM8250 board
+ * family) as of JeyKul/gts7xl-mainline's series. Everything not marked TODO is the
+ * S7+'s wiring and still has to be checked against the stock gts7l device tree
+ * (docs/gts7l-inventory.md, step S1: stock dtbo entry for board-id 7). Known
+ * differences: 11" 1600x2560 LCD (Novatek NT36523, CSOT PPA957DB1, dual DSI, C-PHY)
+ * instead of the 12.4" AMOLED, Novatek touch controller, side-key fingerprint, an
+ * external X55 LTE modem, smaller battery.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/media/video-interfaces.h>
+#include <dt-bindings/clock/qcom,dispcc-sm8250.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/usb/pd.h>
+#include "sm8250-samsung-common.dtsi"
+#include "pm8150l.dtsi"
+
+/ {
+	model = "Samsung Galaxy Tab S7 (LTE)";
+	compatible = "samsung,gts7l", "qcom,kona", "qcom,sm8250";
+	chassis-type = "tablet";
+
+	/* Values the bootloader accepts for a direct boot */
+	/* Stock gts7l dtbo, board revision 7 (SM8250 v2.1) */
+	qcom,msm-id = <356 0x20001>;
+	qcom,board-id = <8 7>;
+
+	aliases {
+		serial1 = &uart6;
+		serial2 = &uart3;
+	};
+
+	/*
+	 * TODO(S1): gts7l battery (8000 mAh nominal) and stock limits from the
+	 * stock DTB; S7+ values below except the capacity.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		voltage-max-design-microvolt = <4350000>;
+		voltage-min-design-microvolt = <3400000>;
+		over-voltage-threshold-microvolt = <4500000>;
+		charge-full-design-microamp-hours = <8000000>;
+		constant-charge-voltage-max-microvolt = <4350000>;
+		constant-charge-current-max-microamp = <500000>;
+	};
+
+	qca6390_pmu: qca6390-pmu {
+		compatible = "qcom,qca6390-pmu";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en_state>, <&bt_en_state>;
+
+		vddaon-supply = <&vreg_s6a_0p95>;
+		vddpmu-supply = <&vreg_s6a_0p95>;
+		vddrfa0p95-supply = <&vreg_s6a_0p95>;
+		vddrfa1p3-supply = <&vreg_s8c_1p35>;
+		vddrfa1p9-supply = <&vreg_s5a_1p9>;
+		vddpcie1p3-supply = <&vreg_s8c_1p35>;
+		vddpcie1p9-supply = <&vreg_s5a_1p9>;
+		vddio-supply = <&vreg_s4a_1p8>;
+
+		wlan-enable-gpios = <&tlmm 90 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 76 GPIO_ACTIVE_HIGH>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+			vreg_pmu_rfa_1p7: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+
+	/*
+	 * Stock fixed_reg_lcd_1p8 and fixed_reg_buck_en (enables the ISL98608 bias buck).
+	 * Always on: the bootloader's framebuffer is the display until the panel driver
+	 * exists, and nothing else holds the buck.
+	 */
+	lcd_vddio: lcd-1p8-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd-vdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 135 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	lcd_buck: lcd-buck-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd-buck";
+		gpio = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd_spen: spen-3v3-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_spen_3p3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	cam_rear_vana: cam-rear-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_rear_vana";
+		vin-supply = <&cam_vio>;
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 39 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <50000>;
+		enable-active-high;
+	};
+
+	cam_vio: cam-vio-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		/* Shared by all three cameras: cycling it leaves them not answering */
+		regulator-always-on;
+	};
+
+	cam_front_vana: cam-front-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_front_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <50000>;
+		enable-active-high;
+	};
+
+	cam_wide_vana: cam-wide-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <50000>;
+		enable-active-high;
+	};
+
+	vibrator {
+		compatible = "regulator-haptic";
+		haptic-supply = <&vreg_l7c_2p856>;
+		min-microvolt = <2856000>;
+		max-microvolt = <2856000>;
+	};
+
+	pogo_vdd: pogo-vdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "pogo_vdd_3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&pon {
+	mode-recovery = <0x01>;
+	mode-bootloader = <0x02>;
+};
+
+&soc {
+	imem@146bf000 {
+		compatible = "syscon", "simple-mfd";
+		reg = <0x0 0x146bf000 0x0 0x1000>;
+
+		/* Stock also passes the boot target in IMEM */
+		reboot-mode {
+			compatible = "syscon-reboot-mode";
+			offset = <0x65c>;
+			mask = <0xffffffff>;
+			mode-recovery = <0x77665502>;
+			mode-bootloader = <0x77665500>;
+		};
+	};
+};
+
+&gmu {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8250/a650_zap.mbn";
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+	status = "okay";
+};
+
+&pcieport0 {
+	wifi@0 {
+		compatible = "pci17cb,1101";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
+};
+
+/* Samsung moves these carveouts; values are from the stock device tree */
+&removed_mem {
+	reg = <0x0 0x80b00000 0x0 0x7900000>;
+};
+
+&slpi_mem {
+	reg = <0x0 0x89200000 0x0 0x1500000>;
+};
+
+&adsp_mem {
+	reg = <0x0 0x8a700000 0x0 0x2c00000>;
+};
+
+&spss_mem {
+	reg = <0x0 0x8d300000 0x0 0x100000>;
+};
+
+&npu_mem {
+	reg = <0x0 0x8d400000 0x0 0x500000>;
+};
+
+&video_mem {
+	reg = <0x0 0x8d900000 0x0 0x500000>;
+};
+
+&cvp_mem {
+	reg = <0x0 0x8de00000 0x0 0x500000>;
+};
+
+&cdsp_mem {
+	reg = <0x0 0x8e300000 0x0 0x1a00000>;
+};
+
+&camera_mem {
+	reg = <0x0 0x8fd00000 0x0 0x500000>;
+};
+
+&wlan_mem {
+	reg = <0x0 0x90200000 0x0 0x100000>;
+};
+
+&ipa_fw_mem {
+	reg = <0x0 0x90300000 0x0 0x10000>;
+};
+
+&ipa_gsi_mem {
+	reg = <0x0 0x90310000 0x0 0xa000>;
+};
+
+&gpu_mem {
+	reg = <0x0 0x9031a000 0x0 0x2000>;
+};
+
+&cdsp_secure_heap {
+	reg = <0x0 0x90400000 0x0 0x600000>;
+};
+
+&adsp {
+	firmware-name = "qcom/sm8250/gts7xl/adsp.mbn";
+	status = "okay";
+};
+
+&cdsp {
+	firmware-name = "qcom/sm8250/gts7xl/cdsp.mbn";
+	status = "okay";
+};
+
+&slpi {
+	firmware-name = "qcom/sm8250/gts7xl/slpi.mbn";
+	status = "okay";
+};
+
+&sound {
+	compatible = "qcom,sm8250-sndcard";
+	model = "Galaxy Tab S7+";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pri_tdm_default>;
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+
+	mm3-dai-link {
+		link-name = "MultiMedia3";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+		};
+	};
+
+	mic-dai-link {
+		link-name = "Mic";
+
+		cpu {
+			sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&vamacro 0>;
+		};
+	};
+
+	speakers-dai-link {
+		link-name = "Speakers";
+
+		cpu {
+			sound-dai = <&q6afedai PRIMARY_TDM_RX_0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&cs35l41_fl 0>, <&cs35l41_fr 0>,
+				    <&cs35l41_rl 0>, <&cs35l41_rr 0>;
+		};
+	};
+
+	dp-dai-link {
+		link-name = "DisplayPort Playback";
+
+		cpu {
+			sound-dai = <&q6afedai DISPLAY_PORT_RX>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&mdss_dp>;
+		};
+	};
+};
+
+/* Sub mic: DMIC3 through DEC0. The main mic, DMIC1, reads zero so far */
+&vamacro {
+	pinctrl-0 = <&dmic01_active>, <&dmic23_active>;
+	pinctrl-names = "default";
+	vdd-micb-supply = <&vreg_l5c_1p8>;
+	qcom,dmic-sample-rate = <2400000>;
+	status = "okay";
+};
+
+/* Pin settings as stock: without input-enable the data line reads zero */
+&dmic01_active {
+	clk-pins {
+		drive-strength = <2>;
+	};
+
+	data-pins {
+		drive-strength = <2>;
+		input-enable;
+	};
+};
+
+&lpass_tlmm {
+	dmic23_active: dmic23-active-state {
+		clk-pins {
+			pins = "gpio8";
+			function = "dmic2_clk";
+			drive-strength = <2>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio9";
+			function = "dmic2_data";
+			drive-strength = <2>;
+			input-enable;
+		};
+	};
+};
+
+&camss {
+	/* The driver leaves these at the 19.2MHz the bootloader sets here */
+	assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK_SRC>,
+			  <&camcc CAM_CC_SLOW_AHB_CLK_SRC>;
+	assigned-clock-rates = <400000000>, <80000000>;
+
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+	status = "okay";
+
+	ports {
+		port@2 {
+			csiphy2_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_wide_ep>;
+			};
+		};
+
+		port@3 {
+			csiphy3_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_front_ep>;
+			};
+		};
+
+		port@0 {
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				/* Wired in reverse on this board */
+				data-lanes = <3 2 1 0>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_rear_ep>;
+			};
+		};
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c0 {
+	/* Rear 5MP ultrawide */
+	camera@10 {
+		compatible = "samsung,s5k5e9";
+		reg = <0x10>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 78 GPIO_ACTIVE_LOW>;
+		vana-supply = <&cam_wide_vana>;
+		vio-supply = <&cam_vio>;
+
+		pinctrl-0 = <&cam_wide_default>;
+		pinctrl-names = "default";
+
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			cam_wide_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <897600000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
+&cci1_i2c1 {
+	/* Rear camera focus motor, a dw9808 */
+	cam_rear_focus: lens@c {
+		compatible = "dongwoon,dw9807-vcm";
+		reg = <0x0c>;
+		vdd-supply = <&cam_rear_vana>;
+	};
+};
+
+&cci0_i2c1 {
+	/* Front 8MP */
+	camera@2d {
+		compatible = "samsung,s5k4ha";
+		reg = <0x2d>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		vana-supply = <&cam_front_vana>;
+		vio-supply = <&cam_vio>;
+
+		pinctrl-0 = <&cam_front_default>;
+		pinctrl-names = "default";
+
+		orientation = <0>;
+		rotation = <270>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <792000000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+};
+
+&cci0_i2c0 {
+	/* Rear 13MP. Stock only switches VANA and VIO, the digital rail hangs off VANA */
+	camera@2d {
+		compatible = "samsung,s5k3m5";
+		reg = <0x2d>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
