From 6ecf47ec66725fd5ddd93115e5120fe13383e80e Mon Sep 17 00:00:00 2001
From: caoanhhao <dev@skyperry.com>
Date: Mon, 23 Nov 2026 23:23:12 +0700
Subject: [PATCH] DEBUG drm/panel: nt36523: skip display off and sleep in on
 disable

caoanhhao used AI to code
---
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
index eca542ac2..161a49f39 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -40,6 +40,9 @@ static int init_limit = -1;
 module_param(init_limit, int, 0644);
 static int init_dsi = 3;
 module_param(init_dsi, int, 0644);
+/* gts7l: on disable, do not send display off and sleep in */
+static bool skip_disable = true;
+module_param(skip_disable, bool, 0644);
 
 struct panel_info {
 	struct drm_panel panel;
@@ -1491,6 +1494,9 @@ static int nt36523_disable(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	int i;
 
+	if (skip_disable)
+		return 0;
+
 	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
 		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i]};
 
-- 
