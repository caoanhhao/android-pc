From 2ea40b2789827c9830f5ba43d403302ee5ca1809 Mon Sep 17 00:00:00 2001
From: caoanhhao <caoanhhao2@gmail.com>
Date: Wed, 25 Nov 2026 07:58:51 +0700
Subject: [PATCH 220/221] arm64: dts: qcom: gts7l: wire the fuel gauge's ALRT
 interrupt

The MAX77705 fuel gauge raises its alert through the PMIC's INTSRC
(bit 2, the FG source of the max77705 irq chip). Without it the
max17042 driver never enables the SOC alerts and only reports when
polled, so Android sees level changes late. starqltechn wires the same
interrupt.

caoanhhao used AI to code
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts
index 2b001e897..b915a1fbf 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7l.dts
@@ -1119,6 +1119,9 @@ fuel-gauge@36 {
 		 */
 		maxim,rsns-microohm = <2000>;
 		power-supplies = <&max77705_charger>;
+		/* ALRT, through the MAX77705 INTSRC (FG = bit 2), like starqltechn */
+		interrupt-parent = <&max77705>;
+		interrupts = <2>;
 		/* The gauge's own thermistor input is unused and reads 25 C */
 		io-channels = <&pm8150l_adc ADC5_AMUX_THM1_100K_PU>;
 		io-channel-names = "temp";
