From cbc92a2db7384f042456fc318321c2ed493edb6a Mon Sep 17 00:00:00 2001
From: caoanhhao <dev@skyperry.com>
Date: Wed, 25 Nov 2026 09:53:00 +0700
Subject: [PATCH] media: s5k-tab: take the Bayer order from the board

The Tab S7's ultrawide s5k5e9 starts its readout on another colour than the
Tab S7+'s: its frames are GRBG, not GBRG, which turned red objects blue.
Checked against a red chair seen by the rear and the ultrawide camera.

Read an optional "samsung,bayer-order" property ("bggr", "gbrg", "grbg" or
"rggb") and report that media bus code instead of the sensor default.

caoanhhao used AI to code
---
 drivers/media/i2c/s5k-tab.c | 42 ++++++++++++++++++++++++++++++++++---
 1 file changed, 39 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/s5k-tab.c b/drivers/media/i2c/s5k-tab.c
index 19484f3e2..7eb89bd4e 100644
--- a/drivers/media/i2c/s5k-tab.c
+++ b/drivers/media/i2c/s5k-tab.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
 #include <linux/regulator/consumer.h>
 #include <linux/units.h>
 #include <media/v4l2-cci.h>
@@ -384,6 +385,8 @@ struct s5ktab {
 	struct v4l2_ctrl_handler ctrls;
 	struct v4l2_ctrl *exposure, *hblank, *vblank;
 	s64 link_freq[1];
+	/* Media bus code: the sensor's, or the board's "samsung,bayer-order" */
+	u32 code;
 };
 
 static inline struct s5ktab *to_s5ktab(struct v4l2_subdev *sd)
@@ -503,7 +506,7 @@ static int s5ktab_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_sta
 static void s5ktab_fill_format(struct s5ktab *s, const struct s5ktab_mode *m,
 			       struct v4l2_mbus_framefmt *fmt)
 {
-	fmt->code = s->data->code;
+	fmt->code = s->code;
 	fmt->width = m->width;
 	fmt->height = m->height;
 	fmt->field = V4L2_FIELD_NONE;
@@ -555,7 +558,7 @@ static int s5ktab_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_stat
 {
 	if (code->index)
 		return -EINVAL;
-	code->code = to_s5ktab(sd)->data->code;
+	code->code = to_s5ktab(sd)->code;
 	return 0;
 }
 
@@ -564,7 +567,7 @@ static int s5ktab_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_sta
 {
 	struct s5ktab *s = to_s5ktab(sd);
 
-	if (fse->index >= s->data->num_modes || fse->code != s->data->code)
+	if (fse->index >= s->data->num_modes || fse->code != s->code)
 		return -EINVAL;
 	fse->min_width = fse->max_width = s->data->modes[fse->index].width;
 	fse->min_height = fse->max_height = s->data->modes[fse->index].height;
@@ -654,6 +657,36 @@ static int s5ktab_power_off(struct device *dev)
 	return 0;
 }
 
+/*
+ * The same sensor can start its readout on another colour in another module:
+ * the Tab S7's ultrawide s5k5e9 delivers GRBG where the Tab S7+'s gives GBRG.
+ */
+static int s5ktab_bayer_code(struct device *dev, u32 sensor_code, u32 *code)
+{
+	static const struct {
+		const char *name;
+		u32 code;
+	} orders[] = {
+		{ "bggr", MEDIA_BUS_FMT_SBGGR10_1X10 },
+		{ "gbrg", MEDIA_BUS_FMT_SGBRG10_1X10 },
+		{ "grbg", MEDIA_BUS_FMT_SGRBG10_1X10 },
+		{ "rggb", MEDIA_BUS_FMT_SRGGB10_1X10 },
+	};
+	const char *order;
+	unsigned int i;
+
+	*code = sensor_code;
+	if (device_property_read_string(dev, "samsung,bayer-order", &order))
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(orders); i++) {
+		if (!strcmp(order, orders[i].name)) {
+			*code = orders[i].code;
+			return 0;
+		}
+	}
+	return dev_err_probe(dev, -EINVAL, "unknown samsung,bayer-order \"%s\"\n", order);
+}
+
 static int s5ktab_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -668,6 +701,9 @@ static int s5ktab_probe(struct i2c_client *client)
 	s->dev = dev;
 	s->data = of_device_get_match_data(dev);
 	s->mode = &s->data->modes[0];
+	ret = s5ktab_bayer_code(dev, s->data->code, &s->code);
+	if (ret)
+		return ret;
 	v4l2_i2c_subdev_init(&s->sd, client, &s5ktab_subdev_ops);
 
 	s->regmap = devm_cci_regmap_init_i2c(client, 16);
-- 
2.56.1

