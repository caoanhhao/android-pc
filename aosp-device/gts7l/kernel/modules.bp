// Kernel modules of tools/gts7l-kernel.sh in /vendor/lib/modules. tools/aosp-device-link.sh
// installs this file as device/android-pc/gts7l-kernel/Android.bp next to the modules/ it
// copies from out/gts7l. The Soong-only build drops BOARD_VENDOR_KERNEL_MODULES when there is
// no vendor_dlkm partition, so the modules are a vendor module of their own (aosp_gts7l.mk).
//
// Every module is installed (with modules.dep from depmod); init.gts7l.rc loads only the ones
// in modules.load, listed here. Add a driver here once it is known to work on the tablet.
prebuilt_kernel_modules {
    name: "gts7l_kernel_modules",
    vendor: true,
    srcs: ["modules/*.ko"],
    // gts7l-kernel.sh strips them already.
    strip_debug_symbols: false,
    src_filenames_to_load: [
        // Remoteprocs (ADSP, SLPI; the CDSP fails authentication) and FastRPC, for the
        // sensor DSP (docs/gts7l.md §19). Firmware from gts7l_fw, mounted before modprobe.
        "qmi_helpers.ko",
        "qcom_pdr_msg.ko",
        "pdr_interface.ko",
        "qcom_pd_mapper.ko",
        "qcom_glink_smem.ko",
        "qcom_sysmon.ko",
        "qcom_q6v5.ko",
        "qcom_common.ko",
        "qcom_pil_info.ko",
        "qcom_q6v5_pas.ko",
        "fastrpc.ko",
        // Bluetooth (docs/gts7l.md §20): the QCA6390's power sequencer, which also powers
        // its Wi-Fi part, and hci_uart with btqca on uart6. Firmware qca/htbtfw20.tlv and
        // qca/htnv20.bin from gts7l_fw.
        "pwrseq-qcom-wcn.ko",
        "rfkill.ko",
        "ecc.ko",
        "ecdh_generic.ko",
        "bluetooth.ko",
        "btbcm.ko",
        "btqca.ko",
        "hci_uart.ko",
        // Audio (docs/gts7l-hal/audio.md): the APR services of the ADSP, the sm8250 card
        // (MultiMedia FEs, Primary TDM to the four CS35L41, VA macro DMICs, DisplayPort)
        // and its codecs. The card waits for every codec, the DP one included.
        "apr.ko",
        "q6core.ko",
        "q6afe.ko",
        "q6asm.ko",
        "q6adm.ko",
        "q6routing.ko",
        "q6afe-clocks.ko",
        "q6afe-dai.ko",
        "q6asm-dai.ko",
        "pinctrl-sm8250-lpass-lpi.ko",
        "lpass-gfm-sm8250.ko",
        "snd-soc-lpass-va-macro.ko",
        "snd-soc-cs35l41-i2c.ko",
        "snd-soc-hdmi-codec.ko",
        "snd-soc-sm8250.ko",
    ],
}
