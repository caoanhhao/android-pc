// Kernel modules of tools/gts7l-kernel.sh in /vendor/lib/modules. tools/aosp-device-link.sh
// installs this file as device/android-pc/gts7l-kernel/Android.bp next to the modules/ it
// copies from out/gts7l. The Soong-only build drops BOARD_VENDOR_KERNEL_MODULES when there is
// no vendor_dlkm partition, so the modules are a vendor module of their own (aosp_gts7l.mk).
//
// Every module is installed (with modules.dep from depmod); init.gts7l.rc loads only the ones
// in modules.load, listed here. Add a driver here once it is known to work on the tablet.
prebuilt_kernel_modules {
    name: "gts7l_kernel_modules",
    vendor: true,
    srcs: ["modules/*.ko"],
    // gts7l-kernel.sh strips them already.
    strip_debug_symbols: false,
    src_filenames_to_load: [
        // Remoteprocs (ADSP, SLPI; the CDSP fails authentication) and FastRPC, for the
        // sensor DSP (docs/gts7l.md §19). Firmware from gts7l_fw, mounted before modprobe.
        "qmi_helpers.ko",
        "qcom_pdr_msg.ko",
        "pdr_interface.ko",
        "qcom_pd_mapper.ko",
        "qcom_glink_smem.ko",
        "qcom_sysmon.ko",
        "qcom_q6v5.ko",
        "qcom_common.ko",
        "qcom_pil_info.ko",
        "qcom_q6v5_pas.ko",
        "fastrpc.ko",
        // Bluetooth (docs/gts7l.md §20): the QCA6390's power sequencer, which also powers
        // its Wi-Fi part, and hci_uart with btqca on uart6. Firmware qca/htbtfw20.tlv and
        // qca/htnv20.bin from gts7l_fw.
        "pwrseq-qcom-wcn.ko",
        "rfkill.ko",
        "ecc.ko",
        "ecdh_generic.ko",
        "bluetooth.ko",
        "btbcm.ko",
        "btqca.ko",
        "hci_uart.ko",
        // Wi-Fi (docs/gts7l.md §23): the PCIe power control driver for the wifi@0 node
        // (powered through pwrseq-qcom-wcn above). qcom-pcie (built in) brings the link up only
        // once pci-pwrctrl-pwrseq has powered the chip; without it the host never binds.
        // ath11k_pci's firmware (ath11k/QCA6390/hw2.0) comes from gts7l_fw.
        "pci-pwrctrl-pwrseq.ko",
        "cfg80211.ko",
        "libarc4.ko",
        "mac80211.ko",
        "ath11k.ko",
        "ath11k_pci.ko",
        // PMIC ADC (docs/gts7l-hal/power.md): the battery thermistor channel the MAX77705
        // fuel gauge (max17042, built in) defers its probe on, the batt/chg/skin/blkt
        // thermal zones read through generic-adc-thermal, ADC_TM and the PMIC temp alarms.
        "qcom-vadc-common.ko",
        "qcom-spmi-adc5.ko",
        "thermal-generic-adc.ko",
        "qcom-spmi-adc-tm5.ko",
        "qcom-spmi-temp-alarm.ko",
        // Audio (docs/gts7l-hal/audio.md): the APR services of the ADSP, the sm8250 card
        // (MultiMedia FEs, Primary TDM to the four CS35L41, VA macro DMICs, DisplayPort)
        // and its codecs. The card waits for every codec, the DP one included.
        "apr.ko",
        "q6core.ko",
        "q6afe.ko",
        "q6asm.ko",
        "q6adm.ko",
        "q6routing.ko",
        "q6afe-clocks.ko",
        "q6afe-dai.ko",
        "q6asm-dai.ko",
        "pinctrl-sm8250-lpass-lpi.ko",
        "lpass-gfm-sm8250.ko",
        "snd-soc-lpass-va-macro.ko",
        "snd-soc-cs35l41-i2c.ko",
        "snd-soc-hdmi-codec.ko",
        "snd-soc-sm8250.ko",
        // The SM8250 video codec (docs/gts7l-hal/security-usb-media.md §5): qcom-iris, which
        // takes qcom,sm8250-venus over venus when both are built; firmware
        // qcom/sm8250/gts7xl/venus.mbn (DT firmware-name) from gts7l_fw.
        "qcom-iris.ko",
        // Cameras (docs/gts7l-hal/camera.md): camera clock controller, the two CCI I2C
        // masters, CAMSS, the s5k3m5 rear, s5k4ha front and s5k5e9 ultrawide sensors
        // (s5k-tab) and the rear focus motor. modprobe pulls in the V4L2 cores.
        "camcc-sm8250.ko",
        "i2c-qcom-cci.ko",
        "qcom-camss.ko",
        "s5k3m5.ko",
        "s5k-tab.ko",
        "dw9807-vcm.ko",
        // Rear flash LED (PM8150L flash, `white:flash` on both channels, DT from
        // gts7xl-mainline) for the camera HAL's torch and flash captures.
        "led-class-flash.ko",
        "leds-qcom-flash.ko",
    ],
}
