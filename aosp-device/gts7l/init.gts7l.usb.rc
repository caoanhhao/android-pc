# USB on gts7l, usable without the screen (docs/gts7l.md §15). The configfs gadget g1 on the
# DWC3 core a600000.usb, driven by init.usb.configfs.rc through sys.usb.config: adbd over
# FunctionFS (ffs.adb). Two more functions stay in the configuration whatever sys.usb.config
# says (f8, f9; the stock triggers only link and remove f1-f3), in the bring-up image's order,
# so the host names the network interface as for the bring-up shell (enp0s20f0u1i2, the
# "gts7l-bringup" connection):
#   f8 ACM serial: a root shell on /dev/ttyACM0 of the host, even without adbd;
#   f9 NCM: 172.16.42.1, adb over TCP on port 5555.
# persist.sys.usb.config=adb, ro.adb.secure=0 and service.adb.tcp.port=5555 are set by
# aosp_gts7l.mk.

on init
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000

    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/acm.gs8
    mkdir /config/usb_gadget/g1/functions/ncm.gs9
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/functions/acm.gs8 /config/usb_gadget/g1/configs/b.1/f8
    symlink /config/usb_gadget/g1/functions/ncm.gs9 /config/usb_gadget/g1/configs/b.1/f9
    setprop sys.usb.controller ${ro.boot.usbcontroller:-a600000.usb}
    setprop sys.usb.configfs 1
    start vendor.gts7l-usb
    start vendor.gts7l-console

service vendor.gts7l-usb /vendor/bin/gts7l-usb.sh
    class core
    user root
    group root shell
    disabled

# The ACM function's tty. Restarted by init after each session.
service vendor.gts7l-console /vendor/bin/gts7l-usb.sh console
    class core
    user root
    group root shell log
    seclabel u:r:gts7l_usb:s0
    disabled
