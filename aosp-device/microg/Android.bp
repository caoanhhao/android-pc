// microG support files (aosp-device/microg.mk); the APKs themselves come from
// tools/fetch-apps.sh microg.

package {
    default_visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "privapp-permissions-microg.xml",
    src: "privapp-permissions-microg.xml",
    sub_dir: "permissions",
    product_specific: true,
    visibility: ["//visibility:public"],
}

// Power-save and data-saver allowlists (sysconfig) for microG.
prebuilt_etc {
    name: "sysconfig-microg.xml",
    src: "sysconfig-microg.xml",
    sub_dir: "sysconfig",
    product_specific: true,
    visibility: ["//visibility:public"],
}

// Default microG settings, read by GmsCore from /product/etc/microg.xml.
prebuilt_etc {
    name: "microg.xml",
    src: "microg.xml",
    product_specific: true,
    visibility: ["//visibility:public"],
}
