package {
    default_visibility: ["//visibility:private"],
}

// The sensor, TA and storage code, shared by the HAL and the fpctl bring-up tool.
rust_library_rlib {
    name: "libgts7l_fingerprint",
    crate_name: "gts7l_fingerprint",
    srcs: ["src/lib.rs"],
    vendor: true,
    rustlibs: [
        "liblibc",
        "liblog_rust",
        "libthiserror",
    ],
}

rust_binary {
    name: "android.hardware.biometrics.fingerprint-service.gts7l",
    defaults: ["pc_hal_defaults"],
    srcs: ["src/main.rs"],
    rustlibs: [
        "android.hardware.biometrics.common-V4-rust",
        "android.hardware.biometrics.fingerprint-V5-rust",
        "android.hardware.keymaster-V4-rust",
        "libgts7l_fingerprint",
        "liblibc",
    ],
    init_rc: ["android.hardware.biometrics.fingerprint-service.gts7l.rc"],
    vintf_fragment_modules: ["android.hardware.biometrics.fingerprint-service.gts7l.xml"],
    visibility: ["//visibility:public"],
}

vintf_fragment {
    name: "android.hardware.biometrics.fingerprint-service.gts7l.xml",
    src: "android.hardware.biometrics.fingerprint-service.gts7l.xml",
    vendor: true,
}

// fpctl enroll|identify: the flows from a root shell, without the framework.
rust_binary {
    name: "gts7l_fpctl",
    stem: "fpctl",
    srcs: ["src/fpctl.rs"],
    vendor: true,
    prefer_rlib: true,
    rustlibs: [
        "libgts7l_fingerprint",
        "liblibc",
        "liblog_rust",
    ],
    visibility: ["//visibility:public"],
}

rust_test {
    name: "libgts7l_fingerprint_test",
    crate_name: "gts7l_fingerprint",
    srcs: ["src/lib.rs"],
    vendor: true,
    rustlibs: [
        "liblibc",
        "liblog_rust",
        "libtempfile",
        "libthiserror",
    ],
    test_options: {
        unit_test: true,
    },
}
