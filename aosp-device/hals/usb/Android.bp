package {
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "android.hardware.usb-service.pc_defaults",
    defaults: ["pc_hal_defaults"],
    srcs: ["src/main.rs"],
    rustlibs: [
        "android.hardware.usb-V4-rust",
        "android.hardware.usb.gadget-V2-rust",
        "liblibc",
        "librustutils",
    ],
}

rust_binary {
    name: "android.hardware.usb-service.pc",
    defaults: ["android.hardware.usb-service.pc_defaults"],
    init_rc: ["android.hardware.usb-service.pc.rc"],
    vintf_fragment_modules: ["android.hardware.usb-service.pc.xml"],
    visibility: ["//visibility:public"],
}

vintf_fragment {
    name: "android.hardware.usb-service.pc.xml",
    src: "android.hardware.usb-service.pc.xml",
    vendor: true,
}

// Whole HAL, on the device.
rust_test {
    name: "android.hardware.usb-service.pc_test",
    defaults: ["android.hardware.usb-service.pc_defaults"],
    rustlibs: ["libtempfile"],
    test_options: {
        unit_test: true,
    },
}

// The function plans, the configfs layout and the typec parser, on the host.
rust_test_host {
    name: "android.hardware.usb-service.pc_functions_test",
    crate_name: "functions",
    srcs: ["src/functions.rs"],
    edition: "2021",
    test_options: {
        unit_test: true,
    },
}

rust_test_host {
    name: "android.hardware.usb-service.pc_typec_test",
    crate_name: "typec",
    srcs: ["src/typec.rs"],
    edition: "2021",
    rustlibs: ["libtempfile"],
    test_options: {
        unit_test: true,
    },
}
