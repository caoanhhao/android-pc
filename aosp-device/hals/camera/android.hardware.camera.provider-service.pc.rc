# USB webcams (/dev/video*, system:camera 0660) and raw CAMSS sensors (/dev/media*,
# /dev/v4l-subdev*) as ICameraProvider/pc/0.
service vendor.camera-pc /vendor/bin/hw/android.hardware.camera.provider-service.pc
    class hal
    user cameraserver
    group camera system
    task_profiles CameraServiceCapacity MaxPerformance
