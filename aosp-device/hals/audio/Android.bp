package {
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "android.hardware.audio.service.pc_defaults",
    defaults: ["pc_hal_defaults"],
    srcs: ["src/main.rs"],
    rustlibs: [
        "android.hardware.audio.common-V5-rust",
        "android.hardware.audio.core-V4-rust",
        "android.hardware.audio.core.sounddose-V4-rust",
        "android.hardware.audio.effect-V4-rust",
        "android.media.audio.common.types-V5-rust",
        "liblibc",
        "libpcfmq",
    ],
}

// No VINTF fragment: IModule/default (V4) is declared by AOSP's com.android.hardware.audio
// APEX, which keeps serving the other instances (see hal.mk).
rust_binary {
    name: "android.hardware.audio.service.pc",
    defaults: ["android.hardware.audio.service.pc_defaults"],
    init_rc: ["android.hardware.audio.service.pc.rc"],
}

// Whole HAL with the AIDL types, on the device.
rust_test {
    name: "android.hardware.audio.service.pc_test",
    defaults: ["android.hardware.audio.service.pc_defaults"],
    test_options: {
        unit_test: true,
    },
}

// /proc/asound parsing and the stream state machine, on the host.
rust_test_host {
    name: "android.hardware.audio.service.pc_cards_test",
    crate_name: "cards",
    srcs: ["src/cards.rs"],
    edition: "2021",
    test_options: {
        unit_test: true,
    },
}

rust_test_host {
    name: "android.hardware.audio.service.pc_worker_test",
    crate_name: "worker",
    srcs: ["src/worker.rs"],
    edition: "2021",
    rustlibs: [
        "liblibc",
        "liblog_rust",
    ],
    test_options: {
        unit_test: true,
    },
}
