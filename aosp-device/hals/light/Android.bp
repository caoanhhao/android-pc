package {
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "android.hardware.light-service.pc_defaults",
    defaults: ["pc_hal_defaults"],
    srcs: ["src/main.rs"],
    rustlibs: ["android.hardware.light-V3-rust"],
}

rust_binary {
    name: "android.hardware.light-service.pc",
    defaults: ["android.hardware.light-service.pc_defaults"],
    init_rc: ["android.hardware.light-service.pc.rc"],
    vintf_fragment_modules: ["android.hardware.light-service.pc.xml"],
    visibility: ["//visibility:public"],
}

vintf_fragment {
    name: "android.hardware.light-service.pc.xml",
    src: "android.hardware.light-service.pc.xml",
    vendor: true,
}

rust_test {
    name: "android.hardware.light-service.pc_test",
    defaults: ["android.hardware.light-service.pc_defaults"],
    rustlibs: ["libtempfile"],
    test_options: {
        unit_test: true,
    },
}
