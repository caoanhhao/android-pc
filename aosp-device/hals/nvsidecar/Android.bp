// Phase K2 (docs/nvidia-proprietary.md): NVIDIA's own Vulkan driver in a glibc sidecar behind
// a vtest socket, for the "NVIDIA (proprietary, Venus)" boot entry. The glibc root itself is
// not built here: tools/nvsidecar-build.sh makes it and hal.mk copies it to /vendor/bin/nvsidecar.

package {
    default_visibility: ["//visibility:private"],
}

sh_binary {
    name: "nvsidecar.sh",
    src: "nvsidecar.sh",
    vendor: true,
    init_rc: ["init.nvsidecar.rc"],
    visibility: ["//visibility:public"],
}
