<?xml version="1.0" encoding="utf-8"?>
<!-- PcSystemUI: AOSP SystemUI's manifest (merged in from SystemUI-application) with
     PcSystemUIAppComponentFactory, which stands up PcGlobalRootComponent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        package="com.android.systemui"
        android:sharedUserId="android.uid.systemui"
        coreApp="true">
    <!-- Phase E11: hl.dsp.window.kill() force-stops the focused window's app. -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <application
        tools:replace="android:appComponentFactory"
        android:appComponentFactory="com.android.systemui.PcSystemUIAppComponentFactory">
        <!-- Phase E10: the zoom binds' magnification (HyprZoom enables it while zoomed). -->
        <service
            android:name="com.android.systemui.wmshell.HyprZoomService"
            android:label="@string/hypr_zoom_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hypr_zoom_service" />
        </service>
    </application>
</manifest>
