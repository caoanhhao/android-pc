# HyprTop (com.android.hyprtop, the system uid, so system_app): CPU, load and uptime from /proc,
# the process table from hyprtopd (app domains may not read other domains' /proc files).
allow system_app { proc_stat proc_loadavg proc_uptime }:file r_file_perms;
# Network totals when TrafficStats has none (/proc/net/dev).
allow system_app proc_net:file r_file_perms;
# The CPU temperature: the zones under /sys/devices/virtual/thermal and their type/temp files.
allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_thermal:file r_file_perms;
unix_socket_connect(system_app, hyprtopd, hyprtopd)
