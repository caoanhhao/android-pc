<?xml version="1.0" encoding="utf-8"?>
<!-- HyprLauncher (Phase D4, docs/hypr-desktop.md): the privileged permissions it requests.
     The signature ones (STATUS_BAR_SERVICE, INTERNAL_SYSTEM_WINDOW, MANAGE_ACTIVITY_TASKS,
     READ_FRAME_BUFFER, MANAGE_ROLE_HOLDERS) come from the platform key and the recents role. -->
<permissions>
    <privapp-permissions package="com.android.hyprlauncher">
        <permission name="android.permission.REAL_GET_TASKS"/>
        <permission name="android.permission.START_TASKS_FROM_RECENTS"/>
        <permission name="android.permission.STATUS_BAR"/>
    </privapp-permissions>
</permissions>
