<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop mode on aosp_pc_x86_64 (phase F9f, docs/desktop-mode.md). -->
<resources>
    <!-- AOSP desktop windowing: supported, and allowed on the internal (primary) display. -->
    <bool name="config_isDesktopModeSupported">true</bool>
    <bool name="config_canInternalDisplayHostDesktops">true</bool>
    <!-- A display whose task area is freeform (display_settings.xml) is a desktop. -->
    <bool name="config_enterDesktopByDefaultOnFreeformDisplay">true</bool>
    <!-- A PC monitor does not turn: no auto-rotation. -->
    <bool name="config_supportAutoRotation">false</bool>
    <!-- No swipe lock screen (H4): Smart Dock hides its dock when its accessibility service
         starts behind the keyguard and does not bring it back, so with a lock screen the
         dock would be missing after every boot. A PIN or password set later still locks. -->
    <bool name="config_disableLockscreenByDefault">true</bool>
</resources>
