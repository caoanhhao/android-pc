<!-- Waydroid only (docs/waydroid-aosp17.md): Waydroid's composer (hwcomposer.waydroid in
     AOSP's HIDL composer 2.1 service) and the HIDL interfaces it serves. Kept outside
     /vendor/etc/vintf; init's Waydroid first stage bind-mounts it over waydroid.xml there. -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.graphics.composer</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IComposer</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>vendor.waydroid.display</name>
        <transport>hwbinder</transport>
        <version>1.3</version>
        <interface>
            <name>IWaydroidDisplay</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>vendor.waydroid.window</name>
        <transport>hwbinder</transport>
        <version>1.3</version>
        <interface>
            <name>IWaydroidWindow</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>vendor.waydroid.clipboard</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IWaydroidClipboard</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
