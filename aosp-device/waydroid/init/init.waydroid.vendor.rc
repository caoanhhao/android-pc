# android-pc in Waydroid's LXC container (docs/waydroid-aosp17.md). Waydroid's host side sets
# ro.boot.android_pc.waydroid=1 in waydroid.prop (tools/waydroid/aosp17-switch.sh); none of
# this runs on the PC.

on early-init && property:ro.boot.android_pc.waydroid=1
    # NVIDIA's device nodes in the container's /dev (Waydroid binds no NVIDIA node).
    exec - root root -- /vendor/bin/sh /vendor/bin/waydroid-nvidia-nodes.sh
    # NVIDIA's Vulkan driver from /vendor/lib64/hw, as on the PC's NVIDIA entry
    # (hals/nvgpu/init.nvgpu.rc).
    setprop ro.vulkan.apex ""
    setprop debug.renderengine.backend skiavkthreaded
    # Waydroid's host side configures eth0 by that name; Cuttlefish's rename_eth0 would hide
    # it as buried_eth0 (device/google/cuttlefish/shared/config/init.vendor.rc).
    setprop ro.vendor.disable_rename_eth0 1
    # The composer (user host, the system uid) makes its input FIFOs in /dev/input
    # (wl_*_events). ueventd may create the directory first, as root:root 0755, for a host
    # gamepad present at boot (system/core init/ueventd.cpp, WaydroidColdplugInput); mkdir
    # also fixes the owner of an existing directory.
    mkdir /dev/input 0775 system input

on post-fs && property:ro.boot.android_pc.waydroid=1
    start vendor.hwcomposer-2-1

# Waydroid's composer is a Wayland client of the host's compositor: it runs as the host user
# (waydroid.host.uid) to reach the session's Wayland socket.
service vendor.hwcomposer-2-1 /vendor/bin/hw/android.hardware.graphics.composer@2.1-service --desktop_file_hint=Waydroid.desktop
    override
    class hal animation
    user host
    group system graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow
    disabled
