<?xml version="1.0" encoding="utf-8"?>
<!-- WebView providers (phase F9p, aosp-device/webview/webview.mk). Google's WebView first:
     it is the default. Both are /product apps, which WebViewUpdateService accepts without a
     <signature> entry; Play Store updates keep them system apps. -->
<webviewproviders>
    <webviewprovider description="Android System WebView" packageName="com.google.android.webview" availableByDefault="true">
    </webviewprovider>
    <webviewprovider description="AOSP WebView" packageName="com.android.webview" availableByDefault="true">
    </webviewprovider>
</webviewproviders>
