kernel_build(
    name = "pc_x86_64",
    srcs = ["//common:kernel_x86_64_sources"],
    outs = [],
    arch = "x86_64",
    base_kernel = "//common:kernel_x86_64",
    make_goals = ["modules"],
    makefile = "//common:Makefile",
    module_outs = _VIRT_MODULES + _PC_MODULES,
    post_defconfig_fragments = [
        "virtual_device_core.fragment",
        "virtual_device.fragment",
        "pc_x86_64.fragment",
    ],
    strip_modules = True,
)

# The UEFI GOP framebuffer as DRM driver "virtio_gpu" (see pcfb/pcfb.c).
ddk_module(
    name = "pcfb",
    srcs = [
        "pcfb/gen/drm_sysfb.c",
        "pcfb/gen/drm_sysfb_helper.h",
        "pcfb/gen/drm_sysfb_modeset.c",
        "pcfb/gen/drm_sysfb_screen_info.c",
        "pcfb/gen/efidrm_impl.h",
        "pcfb/pcfb.c",
        "pcfb/pcfb.h",
        "pcfb/pcfb_blit.c",
    ],
    out = "pcfb.ko",
    kernel_build = ":pc_x86_64",
)

# Placeholder /dev/hvc* ports for Cuttlefish's HALs (see pchvc/pchvc.c).
ddk_module(
    name = "pchvc",
    srcs = ["pchvc/pchvc.c"],
    out = "pchvc.ko",
    kernel_build = ":pc_x86_64",
)

kernel_modules_install(
    name = "pc_x86_64_modules_install",
    kernel_build = ":pc_x86_64",
    kernel_modules = [
        ":pcfb",
        ":pchvc",
    ],
)

pkg_files(
    name = "pc_x86_64_dist_files",
    srcs = [
        ":pc_x86_64",
        ":pc_x86_64_modules_install",
    ],
    strip_prefix = strip_prefix.files_only(),
)

pkg_install(
    name = "pc_x86_64_dist",
    srcs = [":pc_x86_64_dist_files"],
    destdir = "out/pc_x86_64/dist",
)
