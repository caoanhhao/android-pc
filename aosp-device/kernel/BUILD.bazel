# android-pc vendor kernel modules for the real PC (phase F3a, docs/usb-boot-aosp17.md).
#
# tools/gki-build.sh copies this directory to gki/android-pc/ (the android17-6.18 kernel
# checkout), adds the virtual-device fragments and the generated pcfb sources, and builds
#   //common:kernel_x86_64_dist                              GKI image + system_dlkm modules
#   //common-modules/virtual-device:virtual_device_x86_64_dist   Cuttlefish modules
#   //android-pc:pc_x86_64_dist                              this package
# with --notrim, so vendor modules may use any exported symbol of the GKI image.

load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("//build/kernel/kleaf:kernel.bzl", "ddk_module", "kernel_build", "kernel_modules_install")

# In-tree modules of the virtual-device build (same fragments plus ours, so a superset of
# its config). tools/gki-build.sh installs these instead of virtual_device_x86_64's copies
# (which lack exports our options add, e.g. mac80211's LED triggers for iwlmvm); only
# virtual-device's external modules come from that build.
_VIRT_MODULES = [
    "btintel.ko",
    "btrtl.ko",
    "btusb.ko",
    "cfg80211.ko",
    "dummy-cpufreq.ko",
    "dummy_hcd.ko",
    "failover.ko",
    "goldfish_battery.ko",
    "gs_usb.ko",
    "hci_vhci.ko",
    "mac80211.ko",
    "mac80211_hwsim.ko",
    "mt76.ko",
    "mt76-usb.ko",
    "mt76x0-common.ko",
    "mt76x02-lib.ko",
    "mt76x02-usb.ko",
    "mt76x0u.ko",
    "mt76x2-common.ko",
    "mt76x2u.ko",
    "nd_virtio.ko",
    "net_failover.ko",
    "pulse8-cec.ko",
    "rtc-test.ko",
    "snd-aloop.ko",
    "system_heap.ko",
    "test_meminit.ko",
    "usbip-core.ko",
    "v4l2-tpg.ko",
    "vhci-hcd.ko",
    "virt_wifi.ko",
    "virtio-gpu.ko",
    "virtio-rng.ko",
    "virtio_dma_buf.ko",
    "virtio_input.ko",
    "virtio_net.ko",
    "virtio_pmem.ko",
    "virtio_snd.ko",
    "vivid.ko",
    "vkms.ko",
]

# Applied to every kernel_build of tools/gki-build.sh, the GKI image included (Phase G6):
# nova-core needs the Rust firmware loader abstractions in vmlinux's kernel crate.
exports_files(["gki_rust_defconfig"])

# Modules for the PC hardware (pc_x86_64.fragment). The HD Audio codec menus enable every
# codec of their family; all are installed (only the ones a codec matches bind). nouveau and
# the DRM helpers it selects are for the RTX 4070 (Phase G1); modules.blocklist keeps nouveau
# out of the boot-time load, init.pc.rc loads it on the nouveau entry only. nova-core and
# nova (Rust, Phase G6) are the same kind of experiment on the nova entry.
_PC_MODULES = [
    "drivers/acpi/ac.ko",
    "drivers/acpi/battery.ko",
    "drivers/acpi/fan.ko",
    "drivers/acpi/thermal.ko",
    "drivers/acpi/video.ko",
