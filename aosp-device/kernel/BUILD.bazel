    "drivers/gpu/drm/nouveau/nouveau.ko",
    "drivers/gpu/drm/nova/nova.ko",
    "drivers/gpu/drm/scheduler/gpu-sched.ko",
    "drivers/gpu/nova-core/nova_core.ko",
