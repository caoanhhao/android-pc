# Cuttlefish's list (device/google/cuttlefish/shared/modules.blocklist): BoardConfig.mk replaces
# it with this file.
blocklist ptp_kvm.ko
blocklist vkms.ko
blocklist snd-aloop.ko
blocklist vivid.ko

# Phase G1: nouveau loads only on the nouveau boot entry (init.pc.rc), never at boot-time load.
blocklist nouveau.ko

# Phase G6: NVIDIA's Rust drivers Nova load only on the nova boot entry (init.pc.rc, pcnova.sh).
blocklist nova.ko
blocklist nova_core.ko
