// Real-PC boot support for aosp_pc_x86_64 (phase F3a, docs/usb-boot-aosp17.md).
// Everything here only acts when the PC boot loader sets androidboot.android_pc=1, so the
// same images keep booting on Cuttlefish.

package {
    default_visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "init.pc.rc",
    src: "init.pc.rc",
    sub_dir: "init",
    vendor: true,
    visibility: ["//visibility:public"],
}

sh_binary {
    name: "pclog.sh",
    src: "pclog.sh",
    vendor: true,
    visibility: ["//visibility:public"],
}

sh_binary {
    name: "ueventd-watch.sh",
    src: "ueventd-watch.sh",
    vendor: true,
    visibility: ["//visibility:public"],
}

// Empty sensors multi-HAL config: init.pc.rc mounts it over /vendor/etc/sensors/hals.conf
// on the PC, where Cuttlefish's sensors sub-HAL would wait forever for its host.
prebuilt_etc {
    name: "hals.pc.conf",
    src: "hals.pc.conf",
    sub_dir: "sensors",
    vendor: true,
    visibility: ["//visibility:public"],
}

// Chromium flags for the software Vulkan driver (init in its own domain, so on /product).
prebuilt_etc {
    name: "init.pc.chromium.rc",
    src: "init.pc.chromium.rc",
    sub_dir: "init",
    product_specific: true,
    visibility: ["//visibility:public"],
}

// Cuttlefish's fstab plus the PC's extra disks (fstab.pc.disks). fs_mgr reads
// /odm/etc/fstab.<fstab_suffix> before /vendor/etc, so vold and mount_all take this one;
// first-stage init keeps the vendor ramdisk copy, which is the same without these lines.
genrule {
    name: "gen_fstab_pc_f2fs_hctr2",
    srcs: [
        ":gen_fstab_cf_f2fs_hctr2",
        "fstab.pc.disks",
    ],
    out: ["fstab.cf.f2fs.hctr2"],
    cmd: "cat $(in) > $(out)",
}

prebuilt_etc {
    name: "fstab.pc.f2fs.hctr2",
    src: ":gen_fstab_pc_f2fs_hctr2",
    filename: "fstab.cf.f2fs.hctr2",
    device_specific: true,
    visibility: ["//visibility:public"],
}

// Phase G1: keeps a mode on the nouveau card's connectors (init.pc.rc, nouveau entry only).
// It runs libdrm's modetest, which pc.mk installs to /system/bin (see there).
sh_binary {
    name: "pcgpu.sh",
    src: "pcgpu.sh",
    vendor: true,
    visibility: ["//visibility:public"],
}

// Phase G5: suspend on the nouveau entries (init.pc.rc): keyboard wakeup, screen on after a
// user wake, a wakelock while the G3/G4 tests run.
sh_binary {
    name: "pcwake.sh",
    src: "pcwake.sh",
    vendor: true,
    visibility: ["//visibility:public"],
}

// Phase G6: loads NVIDIA's Rust drivers Nova on the nova entry (init.pc.rc) and records how
// far they get.
sh_binary {
    name: "pcnova.sh",
    src: "pcnova.sh",
    vendor: true,
    visibility: ["//visibility:public"],
}
