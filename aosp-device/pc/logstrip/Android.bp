// Phase L1 (docs/nvidia-proprietary.md): the on-screen log strip of the L1 test entries. A
// non-touchable, semi-transparent overlay on the right of the screen that shows the tail of a
// filtered kernel log (pclogstrip.sh writes it), so the log is readable while the UI stays
// usable and the kernel console stays off the framebuffer.
android_app {
    name: "PcLogStrip",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}
