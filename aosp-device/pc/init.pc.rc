# Real-PC boot (androidboot.android_pc=1, set by tools/mkusb-aosp17.sh); see
# docs/usb-boot-aosp17.md. On Cuttlefish none of this runs.

on early-init && property:ro.boot.android_pc=1
    # Cuttlefish renames eth0 to buried_eth0 for its virtual Wi-Fi bridge; on the PC eth0 is
    # the RTL8125 port and EthernetService must see it as is.
    setprop ro.vendor.disable_rename_eth0 1
    # Cuttlefish's sensors sub-HAL asks its host (over /dev/hvc*, which the PC lacks) for
    # the sensor list and waits forever; with no sub-HAL the multi-HAL has no sensors.
    mount none /vendor/etc/sensors/hals.pc.conf /vendor/etc/sensors/hals.conf bind

# Bluetooth: Cuttlefish's HAL speaks H4 to a host over /dev/hvc5 (a pchvc placeholder here);
# the PC's AX211 is hci0 in the kernel, which AOSP's default HAL drives through an HCI user
# channel.
# Runs after init.rc's own "on boot" (class_start hal); vendor init may not trigger on
# init.svc.* properties.
on boot && property:ro.boot.android_pc=1
    stop bt_hci
    start vendor.bluetooth-pc

# Wi-Fi hotspot: hostapd (Cuttlefish's com.google.cf.wpa_supplicant APEX) writes
# hostapd_<iface>.conf here; Cuttlefish only creates the directory for its hwsim radios.
on post-fs-data && property:ro.boot.android_pc=1
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

# ueventd watchdog: when init restarts a crashed ueventd, replays the uevents of the devices
# added while it was down (a restarted ueventd skips coldboot). Started before coldboot ends so
# it sees the first ueventd.
on early-init && property:ro.boot.android_pc=1
    start vendor.ueventd_watch

service vendor.ueventd_watch /vendor/bin/ueventd-watch.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled

on init && property:ro.boot.android_pc.log=1
    start vendor.pclog

# Saves the kernel log, logcat and a few state dumps to the stick's "pclog" partition (FAT),
# so a boot on the real PC can be read afterwards on the build host.
service vendor.pclog /vendor/bin/pclog.sh
    user root
    group root log system
    seclabel u:r:su:s0
    disabled
    oneshot

# NVIDIA RTX 4070 through nouveau (Phase G1, docs/nvidia.md), only on the Limine entry with
# androidboot.android_pc.gpu=nouveau (pcfb.enable=0 there, so nothing touches the GOP
# framebuffer nouveau takes over). nouveau.ko is in modules.blocklist, so the boot-time
# module load skips it on every other entry; modprobe named explicitly ignores the list.
on early-init && property:ro.boot.android_pc.gpu=nouveau
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules nouveau.ko

# Android on KMS (Phase G2): drm_hwcomposer (picked by the entry's vendor APEX choice) drives
# nouveau's card, at each monitor's preferred mode, with hotplug and a second monitor as an
# external display; client composition stays on SwiftShader. minigbm allocates dumb buffers
# through its "nouveau" backend on nouveau's render node (DRM_IOCTL_MODE_CREATE_DUMB is
# DRM_RENDER_ALLOW in 6.18). Overlay planes are off: every layer goes through client
# composition onto the primary plane, the one plane path known to work on every KMS driver.
# Cuttlefish's vendor.hwc.drm.device=/dev/dri/card0 is nouveau's card here: pcfb is off and
# vkms is blocklisted.
on early-init && property:ro.boot.android_pc.gpu=nouveau
    setprop ro.vendor.hwc.use_overlay_planes 0

# G1's test (the entry with androidboot.android_pc.kms=modetest, on the composer's no-op
# display): lights the monitor with a modetest pattern, the preferred mode on every connected
# connector, so the GPU drives the HDMI/DP link and the HD Audio codec gets the monitor's ELD.
# modetest holds DRM master, so never together with drm_hwcomposer.
on post-fs-data && property:ro.boot.android_pc.kms=modetest
    start vendor.pcgpu

service vendor.pcgpu /vendor/bin/pcgpu.sh
    user root
    group root graphics
    seclabel u:r:su:s0
    disabled
