# Test programs in kernel-milestone order. One name per line; read by
# run-host.sh, tools/mkinitramfs.sh and (compiled in) by ktest-init.
# B1: processes, ELF, signals, futex, TLS
b1_hello
b1_time
b1_fork_wait
b1_execve
b1_signals
b1_threads
b1_tls
# B2: VFS, pipes, getdents, devfs/procfs
b2_files
b2_pipe
b2_getdents
b2_devproc
# B3: virtual memory
b3_mmap
b3_fork_cow
b3_memfd
b3_shmem
# B4: I/O multiplexing and IPC
b4_epoll
b4_eventfd
b4_timerfd
b4_signalfd
b4_poll
b4_unix
# C1: Android binder (Rust kernel only; skipped on the host)
c1_binder
# C2: block devices and disk file systems (Rust kernel with the C2 test disk; skipped on the host)
c2_block
c2_fs
c2_loop
c2_dm
# C3: Android init's kernel interfaces (selinux and cgroup tests need the Rust kernel)
c3_selinux
c3_cgroup
c3_inotify
c3_keyctl
c3_netlink
c3_misc
c3_kmsg
c3_creds
c3_sysfs
c3_mntns
c3_bpf
c3_net
# D1: graphics kernel interfaces (DRM/KMS on virtio-gpu, dma-buf, sync_file; skipped without them)
d1_dumb
d1_kms
d1_prime
d1_sync
# D2: input (evdev, uinput, virtio-input) and networking (TCP, UDP, ICMP, IPv6 on virtio-net)
d2_evdev
d2_tcp
d2_udp
# D3: zygote and system_server's kernel interfaces (userfaultfd for ART's CMC GC, ...)
d3_uffd
d3_proc
d3_timers
d3_splice
